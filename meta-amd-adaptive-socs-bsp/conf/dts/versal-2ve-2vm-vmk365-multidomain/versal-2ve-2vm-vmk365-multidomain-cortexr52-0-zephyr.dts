/dts-v1/;
/ {
        compatible = "xlnx,versal2";
        model = "AMD Versal Gen 2";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        interrupt-parent = <&gic_r52>;
        vivado-version = "2026.2.0";
        device_id = "xc2vm3654";
        xlnx,ddrmc5-debug-elf = "false";
        xlnx,ddrmc5-i2c-master = "PMC";
        variant = "Versal_2VE_2VM_Small";
        slrcount = <0x1>;
        family = "Versal_2VE_2VM";
        speed_grade = "1LHP";
        pruned-sdt = <0x1>;

        cpus_r52_0: cpus {
                phandle = <0xd9>;
                #address-cells = <0x1>;
                #size-cells = <0x0>;

                cortexr52_0: cpu@0 {
                        phandle = <0xda>;
                        compatible = "arm,cortex-r52";
                        device_type = "cpu";
                        reg = <0x0>;
                        clock-frequency = <0x5f5dd19>;
                };
        };

        aliases {
                serial0 = "/axi/serial@f1920000";
                serial1 = "/axi/serial@f1930000";
                mmc0 = "/axi/mmc@f1040000";
                ethernet0 = "/axi/ethernet@f1a70000";
                ufs0 = "/axi/ufs@f10b0000";
                rtc = "/axi/rtc@f12a0000/rtc-counter";
        };

        timer: timer {
                phandle = <0xfd>;
                compatible = "arm,armv8-timer";
                interrupts = <0x1 0xd 0x4 0xa4 0x1 0xe 0x4 0xa4 0x1 0xb 0x4 0xa4 0x1 0xa 0x4 0xa4>;
        };

        amba: axi {
                phandle = <0x2>;
                compatible = "simple-bus";
                bootph-all;
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                interrupt-parent = <&gic_r52>;

                mmi_gpu_slcr@ed720000 {
                        reg = <0x0 0xed720000 0x0 0x20000>;
                        no-map;
                };

                adma0: dma-controller@ebd00000 {
                        phandle = <0x2f>;
                        compatible = "amd,versal2-dma-1.0";
                        reg = <0x0 0xebd00000 0x0 0x1000>;
                        interrupts = <0x0 0x48 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                adma1: dma-controller@ebd10000 {
                        phandle = <0x30>;
                        compatible = "amd,versal2-dma-1.0";
                        reg = <0x0 0xebd10000 0x0 0x1000>;
                        interrupts = <0x0 0x49 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                adma2: dma-controller@ebd20000 {
                        phandle = <0x31>;
                        compatible = "amd,versal2-dma-1.0";
                        reg = <0x0 0xebd20000 0x0 0x1000>;
                        interrupts = <0x0 0x4a 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                adma3: dma-controller@ebd30000 {
                        phandle = <0x32>;
                        compatible = "amd,versal2-dma-1.0";
                        reg = <0x0 0xebd30000 0x0 0x1000>;
                        interrupts = <0x0 0x4b 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                adma4: dma-controller@ebd40000 {
                        phandle = <0x33>;
                        compatible = "amd,versal2-dma-1.0";
                        reg = <0x0 0xebd40000 0x0 0x1000>;
                        interrupts = <0x0 0x4c 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                adma5: dma-controller@ebd50000 {
                        phandle = <0x34>;
                        compatible = "amd,versal2-dma-1.0";
                        reg = <0x0 0xebd50000 0x0 0x1000>;
                        interrupts = <0x0 0x4d 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                adma6: dma-controller@ebd60000 {
                        phandle = <0x35>;
                        compatible = "amd,versal2-dma-1.0";
                        reg = <0x0 0xebd60000 0x0 0x1000>;
                        interrupts = <0x0 0x4e 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                adma7: dma-controller@ebd70000 {
                        phandle = <0x36>;
                        compatible = "amd,versal2-dma-1.0";
                        reg = <0x0 0xebd70000 0x0 0x1000>;
                        interrupts = <0x0 0x4f 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                gem1: ethernet@f1a70000 {
                        phandle = <0x73>;
                        compatible = "xlnx,gem-controller";
                        status = "okay";
                        reg = <0x0 0xf1a70000 0x0 0x1000>;

                        gem1_mac: ethernet_mac {
                                compatible = "xlnx,gem";
                                status = "okay";
                                clock-frequency = <0x7735464>;
                                interrupts = <0x0 0x29 0x4 0xa0 0x0 0x29 0x4 0xa0>;
                                amba-ahb-burst-length = <0x10>;
                                hw-rx-buffer-size = <0x3>;
                                hw-rx-buffer-offset = <0x0>;
                                hw-tx-buffer-size-full;
                                rx-buffer-descriptors = <0x20>;
                                tx-buffer-descriptors = <0x20>;
                                rx-buffer-size = <0x600>;
                                tx-buffer-size = <0x600>;
                                discard-rx-fcs;
                                unicast-hash;
                                local-mac-address = [00 0A 35 00 01 02];
                        };
                };

                gpio0: gpio@f1a50000 {
                        phandle = <0x72>;
                        compatible = "xlnx,ps-gpio";
                        reg = <0x0 0xf1a50000 0x0 0x1000>;
                        interrupts = <0x0 0x14 0x4 0xa0>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;

                        gpio0_bank0: gpio0_bank@0 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x0>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x1a>;
                        };

                        gpio0_bank3: gpio0_bank@3 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x3>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x20>;
                        };

                        gpio0_bank4: gpio0_bank@4 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x4>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x20>;
                        };
                };

                gpio1: gpio@f1020000 {
                        phandle = <0x54>;
                        compatible = "xlnx,ps-gpio";
                        reg = <0x0 0xf1020000 0x0 0x1000>;
                        interrupts = <0x0 0xca 0x4 0xa0>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;

                        gpio1_bank0: gpio1_bank@0 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x0>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x1a>;
                        };

                        gpio1_bank1: gpio1_bank@1 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x1>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x1a>;
                        };

                        gpio1_bank3: gpio1_bank@3 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x3>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x20>;
                        };

                        gpio1_bank4: gpio1_bank@4 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x4>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x20>;
                        };

                        gpio1_bank2: gpio1_bank@2 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x2>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x1a>;
                        };

                        gpio1_bank5: gpio1_bank@5 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x5>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x20>;
                        };
                };

                i3c0: i3c@f1948000 {
                        phandle = <0x6e>;
                        compatible = "snps,designware-i3c";
                        status = "okay";
                        #address-cells = <0x3>;
                        #size-cells = <0x0>;
                        reg = <0x0 0xf1948000 0x0 0x1000>;
                        interrupt-parent = <&gic_r52>;
                        interrupts = <0x0 0x15 0x4 0xa0>;
                        clocks = <&i3c0_ref_clock>;
                };

                i3c1: i3c@f1958000 {
                        phandle = <0x6f>;
                        compatible = "snps,designware-i3c";
                        status = "okay";
                        #address-cells = <0x3>;
                        #size-cells = <0x0>;
                        reg = <0x0 0xf1958000 0x0 0x1000>;
                        interrupt-parent = <&gic_r52>;
                        interrupts = <0x0 0x16 0x4 0xa0>;
                        clocks = <&i3c1_ref_clock>;
                };

                rtc: rtc@f12a0000 {
                        phandle = <0x65>;
                        compatible = "xlnx,zynqmp-rtc";
                        status = "okay";
                        reg = <0x0 0xf12a0000 0x0 0x100>;
                        interrupt-parent = <&gic_r52>;
                        interrupts = <0x0 0xc8 0x4 0xa0 0x0 0xc9 0x4 0xa0>;
                        interrupt-names = "alarm", "sec";
                        clock-frequency = <0x8000>;

                        rtc-counter {
                                compatible = "zephyr,rtc-counter";
                                status = "okay";
                                alarms-count = <0x1>;
                        };
                };

                sdhci0: mmc@f1040000 {
                        phandle = <0x55>;
                        compatible = "xlnx,versal-8.9a";
                        reg = <0x0 0xf1040000 0x0 0x10000>;
                        interrupts = <0x0 0xda 0x4 0xa0>;
                        power-delay-ms = <0xa>;
                        clocks = <&sdhci0_ref_clock>;

                        sdmmc {
                                compatible = "zephyr,sdmmc-disk";
                                disk-name = "SD";
                        };
                };

                serial0: serial@f1920000 {
                        phandle = <0x6c>;
                        compatible = "arm,sbsa-uart";
                        status = "okay";
                        reg = <0x0 0xf1920000 0x0 0x1000>;
                        interrupt-parent = <&gic_r52>;
                        interrupts = <0x0 0x19 0x4 0xa0>;
                        interrupt-names = "serial0";
                };

                serial1: serial@f1930000 {
                        phandle = <0x6d>;
                        compatible = "arm,sbsa-uart";
                        status = "okay";
                        reg = <0x0 0xf1930000 0x0 0x1000>;
                        interrupt-parent = <&gic_r52>;
                        interrupts = <0x0 0x1a 0x4 0xa0>;
                        interrupt-names = "serial1";
                };

                ttc0: timer@f1e60000 {
                        phandle = <0x75>;
                        compatible = "xlnx,ttc";
                        status = "okay";
                        timer-width = <0x20>;
                        reg = <0x0 0xf1e60000 0x0 0x1000>;
                        clock-frequency = <0x8f0cba9>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;

                        ttc0_timer0: counter@0 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x0>;
                                interrupts = <0x0 0x2b 0x4 0xa0>;
                        };

                        ttc0_timer1: counter@1 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x1>;
                                interrupts = <0x0 0x2b 0x4 0xa0>;
                        };

                        ttc0_timer2: counter@2 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x2>;
                                interrupts = <0x0 0x2b 0x4 0xa0>;
                        };
                };

                ttc1: timer@f1e70000 {
                        phandle = <0x76>;
                        compatible = "xlnx,ttc";
                        status = "okay";
                        timer-width = <0x20>;
                        reg = <0x0 0xf1e70000 0x0 0x1000>;
                        clock-frequency = <0x8f0cba9>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;

                        ttc1_timer0: counter@0 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x0>;
                                interrupts = <0x0 0x2c 0x4 0xa0>;
                        };

                        ttc1_timer1: counter@1 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x1>;
                                interrupts = <0x0 0x2c 0x4 0xa0>;
                        };

                        ttc1_timer2: counter@2 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x2>;
                                interrupts = <0x0 0x2c 0x4 0xa0>;
                        };
                };

                ttc2: timer@f1e80000 {
                        phandle = <0x77>;
                        compatible = "xlnx,ttc";
                        status = "okay";
                        timer-width = <0x20>;
                        reg = <0x0 0xf1e80000 0x0 0x1000>;
                        clock-frequency = <0x8f0cba9>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;

                        ttc2_timer0: counter@0 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x0>;
                                interrupts = <0x0 0x2d 0x4 0xa0>;
                        };

                        ttc2_timer1: counter@1 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x1>;
                                interrupts = <0x0 0x2d 0x4 0xa0>;
                        };

                        ttc2_timer2: counter@2 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x2>;
                                interrupts = <0x0 0x2d 0x4 0xa0>;
                        };
                };

                ttc4: timer@f1ea0000 {
                        phandle = <0x79>;
                        compatible = "xlnx,ttc";
                        status = "okay";
                        timer-width = <0x20>;
                        reg = <0x0 0xf1ea0000 0x0 0x1000>;
                        clock-frequency = <0x8f0cba9>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;

                        ttc4_timer0: counter@0 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x0>;
                                interrupts = <0x0 0x2f 0x4 0xa0>;
                        };

                        ttc4_timer1: counter@1 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x1>;
                                interrupts = <0x0 0x2f 0x4 0xa0>;
                        };

                        ttc4_timer2: counter@2 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x2>;
                                interrupts = <0x0 0x2f 0x4 0xa0>;
                        };
                };

                ttc5: timer@f1eb0000 {
                        phandle = <0x7a>;
                        compatible = "xlnx,ttc";
                        status = "okay";
                        timer-width = <0x20>;
                        reg = <0x0 0xf1eb0000 0x0 0x1000>;
                        clock-frequency = <0x8f0cba9>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;

                        ttc5_timer0: counter@0 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x0>;
                                interrupts = <0x0 0x30 0x4 0xa0>;
                        };

                        ttc5_timer1: counter@1 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x1>;
                                interrupts = <0x0 0x30 0x4 0xa0>;
                        };

                        ttc5_timer2: counter@2 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x2>;
                                interrupts = <0x0 0x30 0x4 0xa0>;
                        };
                };

                ttc6: timer@f1ec0000 {
                        phandle = <0x7b>;
                        compatible = "xlnx,ttc";
                        status = "okay";
                        timer-width = <0x20>;
                        reg = <0x0 0xf1ec0000 0x0 0x1000>;
                        clock-frequency = <0x8f0cba9>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;

                        ttc6_timer0: counter@0 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x0>;
                                interrupts = <0x0 0x31 0x4 0xa0>;
                        };

                        ttc6_timer1: counter@1 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x1>;
                                interrupts = <0x0 0x31 0x4 0xa0>;
                        };

                        ttc6_timer2: counter@2 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x2>;
                                interrupts = <0x0 0x31 0x4 0xa0>;
                        };
                };

                ttc7: timer@f1ed0000 {
                        phandle = <0x7c>;
                        compatible = "xlnx,ttc";
                        status = "okay";
                        timer-width = <0x20>;
                        reg = <0x0 0xf1ed0000 0x0 0x1000>;
                        clock-frequency = <0x8f0cba9>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;

                        ttc7_timer0: counter@0 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x0>;
                                interrupts = <0x0 0x32 0x4 0xa0>;
                        };

                        ttc7_timer1: counter@1 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x1>;
                                interrupts = <0x0 0x32 0x4 0xa0>;
                        };

                        ttc7_timer2: counter@2 {
                                compatible = "xlnx,ttc-counter";
                                reg = <0x2>;
                                interrupts = <0x0 0x32 0x4 0xa0>;
                        };
                };

                ufshc: ufs@f10b0000 {
                        phandle = <0x57>;
                        compatible = "amd,versal2-ufs";
                        status = "okay";
                        interrupt-parent = <&gic_r52>;
                        interrupts = <0x0 0xea 0x4 0xa0>;
                        reg = <0x0 0xf10b0000 0x0 0x100 0x0 0xf1060000 0x0 0x2000 0x0 0xf1250000 0x0 0x10000 0x0 0xf1260000 0x0 0x10000>;
                        clock-names = "core", "ref_clk";
                        clocks = <&ufshc_ref_clock>, <&ufshc_ref_clock>;

                        ufsdisk0 {
                                compatible = "zephyr,ufs-disk";
                                disk-name = "UFS";
                        };
                };

                ipi1: mailbox@eb340000 {
                        phandle = <0x8e>;
                        compatible = "xlnx,mbox-versal-ipi-mailbox";
                        interrupt-parent = <&gic_r52>;
                        interrupts = <0x0 0x3a 0x4 0xa0>;
                        reg = <0x0 0xeb340000 0x0 0x10000 0x0 0xeb3f0600 0x0 0x200>;
                        xlnx,ipi-id = <0x3>;
                        #address-cells = <0x2>;
                        #size-cells = <0x2>;
                        reg-names = "ctrl", "msg";

                        ipi_1_to_ipi_asu: child@eb310000 {
                                phandle = <0x14f>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x0>;
                                reg = <0x0 0xeb310000 0x0 0x10000 0x0 0xeb3f0000 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_0: child@eb330000 {
                                phandle = <0x150>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x2>;
                                reg = <0x0 0xeb330000 0x0 0x10000 0x0 0xeb3f0400 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_1: child@eb340000 {
                                phandle = <0x151>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x3>;
                                reg = <0x0 0xeb340000 0x0 0x10000 0x0 0xeb3f0600 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_1_nobuf: child@eb3b0000 {
                                phandle = <0x152>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0xa>;
                                reg = <0x0 0xeb3b0000 0x0 0x1000>;
                                reg-names = "ctrl";
                        };

                        ipi_1_to_ipi_2: child@eb350000 {
                                phandle = <0x153>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x4>;
                                reg = <0x0 0xeb350000 0x0 0x10000 0x0 0xeb3f0800 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_2_nobuf: child@eb3b1000 {
                                phandle = <0x154>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0xb>;
                                reg = <0x0 0xeb3b1000 0x0 0x1000>;
                                reg-names = "ctrl";
                        };

                        ipi_1_to_ipi_3: child@eb360000 {
                                phandle = <0x155>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x5>;
                                reg = <0x0 0xeb360000 0x0 0x10000 0x0 0xeb3f0a00 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_3_nobuf: child@eb3b2000 {
                                phandle = <0x156>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0xc>;
                                reg = <0x0 0xeb3b2000 0x0 0x1000>;
                                reg-names = "ctrl";
                        };

                        ipi_1_to_ipi_4: child@eb370000 {
                                phandle = <0x157>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x6>;
                                reg = <0x0 0xeb370000 0x0 0x10000 0x0 0xeb3f0c00 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_4_nobuf: child@eb3b3000 {
                                phandle = <0x158>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0xd>;
                                reg = <0x0 0xeb3b3000 0x0 0x1000>;
                                reg-names = "ctrl";

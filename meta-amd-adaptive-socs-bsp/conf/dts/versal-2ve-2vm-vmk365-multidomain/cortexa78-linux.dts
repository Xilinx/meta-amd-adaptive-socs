                };

                rsctbl: rsctbl@9800000 {
                        phandle = <0x203>;
                        reg = <0x0 0x9800000 0x0 0x100>;
                        no-map;
                        mpu-policy = "readable", "writable";
                        label = "rsctbl";
                };

                libmetal_elf: libmetal_elf@9968000 {
                        phandle = <0x20a>;
                        reg = <0x0 0x9968000 0x0 0x60000>;
                        no-map;
                        label = "libmetal_elf";
                };

                libmetal_desc0: libmetal_desc0@99c8000 {
                        phandle = <0x207>;
                        reg = <0x0 0x99c8000 0x0 0x4000>;
                        no-map;
                        label = "libmetal_desc0";
                };

                libmetal_desc1: libmetal_desc1@99cc000 {
                        phandle = <0x208>;
                        reg = <0x0 0x99cc000 0x0 0x4000>;
                        no-map;
                        label = "libmetal_desc1";
                };

                libmetal_data: libmetal_data@99d0000 {
                        phandle = <0x209>;
                        reg = <0x0 0x99d0000 0x0 0x40000>;
                        no-map;
                        label = "libmetal_data";
                };
        };

        zynqmp_ipi: zynqmp-ipi {
                phandle = <0x1f2>;
                ranges;
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                xlnx,ipi-id = <0x2>;
                interrupts = <0x0 0x39 0x4>;
                interrupt-parent = <&gic>;
                compatible = "xlnx,zynqmp-ipi-mailbox";

                ipi_mailbox_pmu1: mailbox@eb3f0440 {
                        phandle = <0x1ed>;
                        xlnx,ipi-id = <0x1>;
                        #mbox-cells = <0x1>;
                        reg-names = "local_request_region", "local_response_region", "remote_request_region", "remote_response_region";
                        reg = <0x0 0xeb3f0440 0x0 0x20 0x0 0xeb3f0460 0x0 0x20 0x0 0xeb3f0280 0x0 0x20 0x0 0xeb3f02a0 0x0 0x20>;
                        compatible = "xlnx,zynqmp-ipi-dest-mailbox";
                };
        };

        ref_clk: ref-clk {
                phandle = <0x1ee>;
                clock-output-names = "board_ref_clk";
                clock-frequency = <0x1fca055>;
                #clock-cells = <0x0>;
                compatible = "fixed-clock";
                bootph-all;
        };

        rtc_clk: rtc-clk {
                phandle = <0xf1>;
                clock-output-names = "rtc_clk";
                clock-frequency = <0x8000>;
                #clock-cells = <0x0>;
                compatible = "fixed-clock";
                bootph-all;
        };

        can0_clk: can0-clk {
                phandle = <0xea>;
                clock-mult = <0x1>;
                clock-div = <0x2>;
                clocks = <&scmi_clk 0x48>;
                compatible = "fixed-factor-clock";
                #clock-cells = <0x0>;
        };

        can1_clk: can1-clk {
                phandle = <0xeb>;
                clock-mult = <0x1>;
                clock-div = <0x2>;
                clocks = <&scmi_clk 0x4e>;
                compatible = "fixed-factor-clock";
                #clock-cells = <0x0>;
        };

        can2_clk: can2-clk {
                phandle = <0xec>;
                clock-mult = <0x1>;
                clock-div = <0x2>;
                clocks = <&scmi_clk 0x5a>;
                compatible = "fixed-factor-clock";
                #clock-cells = <0x0>;
        };

        can3_clk: can3-clk {
                phandle = <0xed>;
                clock-mult = <0x1>;
                clock-div = <0x2>;
                clocks = <&scmi_clk 0x5d>;
                compatible = "fixed-factor-clock";
                #clock-cells = <0x0>;
        };

        clk150: clk150 {
                phandle = <0xef>;
                clock-frequency = <0x8f0d180>;
                #clock-cells = <0x0>;
                compatible = "fixed-clock";
        };

        clk250: clk250 {
                phandle = <0xf0>;
                clock-frequency = <0xee6b280>;
                #clock-cells = <0x0>;
                compatible = "fixed-clock";
        };

        clk256: clk256 {
                phandle = <0xf4>;
                clock-frequency = <0xf424000>;
                #clock-cells = <0x0>;
                compatible = "fixed-clock";
        };

        ufs_ref_clk: ufs-ref-clk {
                phandle = <0xf2>;
                clock-frequency = <0x18cba80>;
                #clock-cells = <0x0>;
                compatible = "fixed-clock";
        };

        NoC_C0_C1_ddr_memory: memory@00000000 {
                phandle = <0x4>;
                memory_type = "memory";
                reg = <0x0 0x0 0x0 0x80000000 0x8 0x0 0x1 0x80000000>;
                device_type = "memory";
                xlnx,ip-name = "axi_noc2";
                compatible = "xlnx,axi-noc2-1.1";
        };

        NoC_C2_C3_ddr_memory: memory@50000000000 {
                phandle = <0x5>;
                memory_type = "memory";
                reg = <0x500 0x0 0x2 0x0>;
                device_type = "memory";
                xlnx,ip-name = "axi_noc2";
                compatible = "xlnx,axi-noc2-1.1";
        };

        chosen {
                bootargs = "earlycon=pl011,mmio32,0xf1930000 console=ttyAMA1,115200";
                stdout-path = "serial1:115200n8";
        };

        pwm_fan: pwm-fan {
                phandle = <0x1f3>;
                pwms = <&ttc0 0x2 0x9c40 0x1>;
                compatible = "pwm-fan";
        };

        usb_hub_delay: enable-delay {
                phandle = <0xf3>;
                gpios = <&gpio0 0xe 0x1>;
                gpio-controller;
                #gpio-cells = <0x3>;
                compatible = "gpio-delay";
        };


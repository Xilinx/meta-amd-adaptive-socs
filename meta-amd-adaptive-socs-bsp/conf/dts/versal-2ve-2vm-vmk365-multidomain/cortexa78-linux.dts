/dts-v1/;
/ {
        speed_grade = "2MP";
        family = "Versal_2VE_2VM";
        slrcount = <0x1>;
        variant = "Versal_2VE_2VM_Small";
        xlnx,ddrmc5-i2c-master = "PMC";
        xlnx,ddrmc5-debug-elf = "false";
        device_id = "xc2vm3654";
        vivado-version = "2026.2";
        board = "vmk365";
        interrupt-parent = <&gic>;
        #size-cells = <0x2>;
        #address-cells = <0x2>;
        model = "AMD Versal VMK365 revA";
        compatible = "amd,versal2-vmk365-revA", "amd,versal2-vmk365", "amd,versal2";

        options {

                u-boot {
                        bootscr-address = /bits/ 64 <0x78000000>;
                        compatible = "u-boot,config";
                };
        };

        cpus_a78: cpus {
                phandle = <0xf8>;
                #ranges-size-cells = <0x2>;
                #ranges-address-cells = <0x2>;
                compatible = "cpus,cluster";
                #size-cells = <0x0>;
                #address-cells = <0x1>;

                cpu-map {

                        cluster0 {

                                core0 {
                                        cpu = <&cortexa78_0>;
                                };

                                core1 {
                                        cpu = <&cortexa78_1>;
                                };

                                core2 {
                                        cpu = <&cortexa78_2>;
                                };

                                core3 {
                                        cpu = <&cortexa78_3>;
                                };
                        };
                };

                cortexa78_0: cpu@0 {
                        phandle = <0xa9>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x6f42c98d>;
                        xlnx,cpu-clk-freq-hz = <0x6f42c98d>;
                        xlnx,cluster-number = <0x0>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&scmi_clk 0x43>;
                        next-level-cache = <&l2_00>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        reg = <0x0>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_00: l2-cache {
                                phandle = <0xad>;
                                next-level-cache = <&l3_0>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_1: cpu@100 {
                        phandle = <0xaa>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x6f42c98d>;
                        xlnx,cpu-clk-freq-hz = <0x6f42c98d>;
                        xlnx,cluster-number = <0x0>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&scmi_clk 0x43>;
                        next-level-cache = <&l2_01>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        reg = <0x100>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_01: l2-cache {
                                phandle = <0xb0>;
                                next-level-cache = <&l3_0>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_2: cpu@10000 {
                        phandle = <0xab>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x5f5e100>;
                        xlnx,cpu-clk-freq-hz = <0x5f5e100>;
                        xlnx,cluster-number = <0x0>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&scmi_clk 0x43>;
                        next-level-cache = <&l2_02>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        reg = <0x200>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_02: l2-cache {
                                phandle = <0xb1>;
                                next-level-cache = <&l3_0>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_3: cpu@10100 {
                        phandle = <0xac>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x5f5e100>;
                        xlnx,cpu-clk-freq-hz = <0x5f5e100>;
                        xlnx,cluster-number = <0x0>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&scmi_clk 0x43>;
                        next-level-cache = <&l2_03>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        reg = <0x300>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_03: l2-cache {
                                phandle = <0xb2>;
                                next-level-cache = <&l3_0>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                l3_0: l3-0-cache {
                        phandle = <0xaf>;
                        cache-unified;
                        cache-sets = <0x800>;
                        cache-line-size = <0x40>;
                        cache-size = <0x200000>;
                        cache-level = <0x3>;
                        compatible = "cache";
                };
        };

        cpu_opp_table: opp-table {
                phandle = <0xf9>;
                compatible = "operating-points-v2";

                opp-1867000000 {
                        opp-microvolt = <0xf4240>;
                        clock-latency-ns = <0x7a120>;
                        opp-hz = /bits/ 64 <0x6f4828c0>;
                };

                opp-933500000 {
                        opp-microvolt = <0xf4240>;
                        clock-latency-ns = <0x7a120>;
                        opp-hz = /bits/ 64 <0x37a41460>;
                };

                opp-622333333 {
                        opp-microvolt = <0xf4240>;
                        clock-latency-ns = <0x7a120>;
                        opp-hz = /bits/ 64 <0x25180d95>;
                };

                opp-466750000 {
                        opp-microvolt = <0xf4240>;
                        clock-latency-ns = <0x7a120>;
                        opp-hz = /bits/ 64 <0x1bd20a30>;
                };
        };

        aliases {
                nvmem0 = "/axi/i2c@f1950000/eeprom@54";
                ethernet0 = "/axi/ethernet@f1a70000";
                serial2 = "/axi/coresight@f0800000";
                spi3 = "/axi/spi@f19d0000";
                spi2 = "/axi/spi@f19c0000";
                spi1 = "/axi/spi@f1030000";
                spi0 = "/axi/spi@f1010000";
                i2c8 = "/axi/i2c@f1000000";
                i2c7 = "/axi/i2c@f19b0000";
                i2c6 = "/axi/i2c@f19a0000";
                i2c5 = "/axi/i2c@f1990000";
                i2c4 = "/axi/i2c@f1980000";
                i2c3 = "/axi/i2c@f1970000";
                i2c2 = "/axi/i2c@f1950000";
                i2c1 = "/axi/i2c@f1940000";
                mmc1 = "/axi/mmc@f1050000";
                mmc0 = "/axi/mmc@f1040000";
                serial1 = "/axi/serial@f1930000";
                serial0 = "/axi/serial@f1920000";
        };

        firmware {

                psci: psci {
                        phandle = <0x104>;
                        method = "smc";
                        compatible = "arm,psci-1.0";
                };

                scmi: scmi {
                        phandle = <0x105>;
                        bootph-all;
                        shmem = <0xda>;
                        #size-cells = <0x0>;
                        #address-cells = <0x1>;
                        arm,smc-id = <0xc2002001>;
                        compatible = "arm,scmi-smc";

                        scmi_reset: protocol@16 {
                                phandle = <0xe1>;
                                #reset-cells = <0x1>;
                                reg = <0x16>;
                        };

                        scmi_devpd: protocol@11 {
                                phandle = <0xb9>;
                                #power-domain-cells = <0x1>;
                                reg = <0x11>;
                        };

                        scmi_clk: protocol@14 {
                                phandle = <0xae>;
                                #clock-cells = <0x1>;
                                reg = <0x14>;
                        };
                };

                versal2_firmware: versal2-firmware {
                        phandle = <0x106>;
                        #power-domain-cells = <0x1>;
                        method = "smc";
                        bootph-all;
                        compatible = "xlnx,versal2-firmware";

                        versal_sec_cfg: versal-sec-cfg {
                                phandle = <0x107>;
                                compatible = "xlnx,versal-sec-cfg";

                                nvmem-layout {
                                        #size-cells = <0x1>;
                                        #address-cells = <0x1>;
                                        compatible = "fixed-layout";

                                        bbram_zeroize: bbram-zeroize@4 {
                                                phandle = <0x108>;
                                                reg = <0x4 0x4>;
                                        };

                                        bbram_key: bbram-key@10 {
                                                phandle = <0x109>;
                                                reg = <0x10 0x20>;
                                        };

                                        bbram_usr: bbram-usr@30 {
                                                phandle = <0x10a>;
                                                reg = <0x30 0x4>;
                                        };

                                        bbram_lock: bbram-lock@48 {
                                                phandle = <0x10b>;
                                                reg = <0x48 0x4>;
                                        };

                                        user_key0: user-key@110 {
                                                phandle = <0x10c>;
                                                reg = <0x110 0x20>;
                                        };

                                        user_key1: user-key@130 {
                                                phandle = <0x10d>;
                                                reg = <0x130 0x20>;
                                        };

                                        user_key2: user-key@150 {
                                                phandle = <0x10e>;
                                                reg = <0x150 0x20>;
                                        };

                                        user_key3: user-key@170 {
                                                phandle = <0x10f>;
                                                reg = <0x170 0x20>;
                                        };

                                        user_key4: user-key@190 {
                                                phandle = <0x110>;
                                                reg = <0x190 0x20>;
                                        };

                                        user_key5: user-key@1b0 {
                                                phandle = <0x111>;
                                                reg = <0x1b0 0x20>;
                                        };

                                        user_key6: user-key@1d0 {
                                                phandle = <0x112>;
                                                reg = <0x1d0 0x20>;
                                        };

                                        user_key7: user-key@1f0 {
                                                phandle = <0x113>;
                                                reg = <0x1f0 0x20>;
                                        };
                                };
                        };
                };

                fwu-mdata {
                        compatible = "u-boot,fwu-mdata-mtd";
                        fwu-mdata-store = <&spi_flash>;
                        mdata-parts = "SystemReady-DT Update Metadata", "SystemReady-DT Update Metadata Backup";

                        fwu-bank0 {
                                id = <0x0>;
                                label = "Bank A Space";

                                fwu-image0 {
                                        id = <0x0>;
                                        offset = <0x0>;
                                        size = <0x7200000>;
                                        uuid = "0b931b7e-b2f6-11ef-8565-eb65d140066b";
                                };
                        };

                        fwu-bank1 {
                                id = <0x1>;
                                label = "Bank B Space";

                                fwu-image0 {
                                        id = <0x0>;
                                        offset = <0x0>;
                                        size = <0x7200000>;
                                        uuid = "1243d800-b2f6-11ef-8f4f-8bddc3aa326d";
                                };
                        };
                };
        };

        fpga: fpga-region {
                phandle = <0x114>;
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                fpga-mgr = <&versal_fpga>;
                compatible = "fpga-region";
        };

        timer: timer {
                phandle = <0x115>;
                interrupts = <0x1 0xd 0x4 0x1 0xe 0x4 0x1 0xb 0x4 0x1 0xa 0x4>;
                compatible = "arm,armv8-timer";
        };

        versal_fpga: versal-fpga {
                phandle = <0xdb>;
                compatible = "xlnx,versal-fpga";
        };

        sensor0: versal-thermal-sensor {
                phandle = <0xdc>;
                io-channel-names = "sysmon-temp-channel";
                io-channels = <&sysmon0 0x0>;
                #thermal-sensor-cells = <0x1>;
                compatible = "xlnx,versal-thermal";
        };

        thermal-zones {

                versal_thermal: versal-thermal {
                        phandle = <0x118>;
                        thermal-sensors = <&sensor0 0x0>;
                        polling-delay = <0x3e8>;
                        polling-delay-passive = <0xfa>;

                        trips {

                                temp_alert: temp-alert {
                                        phandle = <0x119>;
                                        type = "passive";
                                        hysteresis = <0x0>;
                                        temperature = <0x11170>;
                                };

                                ot_crit: ot-crit {
                                        phandle = <0x11a>;
                                        type = "critical";
                                        hysteresis = <0x0>;
                                        temperature = <0x1e848>;
                                };
                        };

                        cooling-maps {
                        };
                };

                versal_thermal_aie: versal-aie-thermal {
                        phandle = <0x11b>;
                        thermal-sensors = <&sensor0 0x1>;
                        polling-delay = <0x3e8>;
                        polling-delay-passive = <0xfa>;

                        trips {

                                temp_alert_aie: temp-alert-aie {
                                        phandle = <0x11c>;
                                        type = "passive";
                                        hysteresis = <0x0>;
                                        temperature = <0x11170>;
                                };

                                ot_crit_aie: ot-crit-aie {
                                        phandle = <0x11d>;
                                        type = "critical";
                                        hysteresis = <0x0>;
                                        temperature = <0x1e848>;
                                };
                        };

                        cooling-maps {
                        };
                };
        };

        amba: axi {
                phandle = <0x2>;
                interrupt-parent = <&gic>;
                ranges;
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                bootph-all;
                compatible = "simple-bus";

                mmi_gpu_slcred720000: mmi_gpu_slcr@ed720000 {
                        phandle = <0x1f5>;
                        no-map;
                        reg = <0x0 0xed720000 0x0 0x20000>;
                };

                gpu_physical_memory_group_manager: physical-memory-group-manager {
                        phandle = <0xe0>;
                        compatible = "arm,physical-memory-group-manager";
                };

                gpu: gpu@ed000000 {
                        phandle = <0x54>;
                        xlnx,gpu-clk-src = "PS_AXI_DMA_CLK";
                        xlnx,ip-name = "mmi_gpu";
                        xlnx,gpu-slice1-cores = <0x0>;
                        xlnx,gpu-slice0-cores = <0x1>;
                        xlnx,gpu-clk-freq-mhz = <0x2faf0800>;
                        xlnx,gpu-slices = <0x1>;
                        #interrupt-cells = <0x2>;
                        #size-cells = <0x2>;
                        #address-cells = <0x2>;
                        ranges;
                        compatible = "arm,mali-ptm";
                        status = "okay";

                        gpu_interface@ed700000 {
                                #size-cells = <0x2>;
                                #address-cells = <0x2>;
                                reg = <0x0 0xed700000 0x0 0x20000>;
                                ranges = <0x0 0x0 0x0 0xed700000 0x0 0x20000>;
                                compatible = "arm,mali-ptm-interface";

                                gpu_system: gpu_system@0 {
                                        phandle = <0x11e>;
                                        interrupts = <0x0 0xbc 0x4 0x0 0xbc 0x4>;
                                        interrupt-names = "PTM_UNCORRECTED_ERROR_IRQ", "PTM_DEFERRED_ERROR_IRQ";
                                        interrupt-parent = <&gic>;
                                        reg = <0x0 0x0 0x0 0x10000>;
                                        compatible = "arm,mali-gpu-system";
                                };

                                gpu_assign: gpu_assign@10000 {
                                        phandle = <0x11f>;
                                        reg = <0x0 0x10000 0x0 0x10000>;
                                        compatible = "arm,mali-gpu-assign";
                                };
                        };

                        gpu_interface@ed000000 {
                                #size-cells = <0x2>;
                                #address-cells = <0x2>;
                                reg = <0x0 0xed000000 0x0 0x300000>;
                                ranges = <0x0 0x0 0x0 0xed000000 0x0 0x300000>;
                                compatible = "arm,mali-ptm-interface";

                                gpu_partition_config_a_0: gpu_partition_config@20000 {
                                        phandle = <0xdd>;
                                        reg = <0x0 0x20000 0x0 0x10000>;
                                        compatible = "arm,mali-gpu-partition-config";
                                };

                                gpu_partition_control_a_0: gpu_partition_control@30000 {
                                        phandle = <0xde>;
                                        interrupts = <0x0 0xbb 0x4>;
                                        interrupt-names = "PTM_PARTITION_IRQ";
                                        interrupt-parent = <&gic>;
                                        reg = <0x0 0x30000 0x0 0x10000>;
                                        compatible = "arm,mali-gpu-partition-control";
                                };

                                gpu_resource_group: gpu_resource_group@a0000 {
                                        phandle = <0x120>;
                                        interrupts = <0x0 0xba 0x4>;
                                        interrupt-names = "PTM_GROUP_IRQ";
                                        interrupt-parent = <&gic>;
                                        partition-control = <&gpu_partition_control_a_0>;
                                        partition-config = <&gpu_partition_config_a_0>;
                                        reg = <0x0 0xa0000 0x0 0x10000>;
                                        compatible = "arm,mali-gpu-resource-group";
                                };

                                gpu_aw_message_a_0: gpu_aw_message@fffc0 {
                                        phandle = <0xdf>;
                                        interrupts = <0x0 0xb9 0x4>;
                                        interrupt-names = "PTM_MESSAGE";
                                        interrupt-parent = <&gic>;
                                        reg = <0x0 0xfffc0 0x0 0x40>;
                                        compatible = "arm,mali-gpu-aw-message";
                                };

                                gpu_mali: gpu@e0000 {
                                        phandle = <0x121>;
                                        resets = <&scmi_reset 0x19>,
                                         <&scmi_reset 0x1a>;
                                        clocks = <&scmi_clk 0x6a>;
                                        physical-memory-group-manager = <&gpu_physical_memory_group_manager>;
                                        system-coherency = <0x1f>;
                                        reset-names = "gpu", "gpu_recov";
                                        arbiter-if = <&gpu_aw_message_a_0>;
                                        interrupts = <0x0 0xb9 0x4 0x0 0xb9 0x4 0x0 0xb9 0x4>;
                                        interrupt-names = "JOB", "MMU", "GPU";
                                        interrupt-parent = <&gic>;
                                        reg = <0x0 0xe0000 0x0 0x1ffc0>;
                                        compatible = "arm,mali-midgard";
                                };
                        };
                };

                mmi_dptx: mmi_dptx@ede00000 {
                        phandle = <0x5d>;
                        xlnx,dp-hpd = "PMC_MIO_48";
                        xlnx,edp-en = <0x0>;
                        xlnx,dp-lanes = <0x2>;
                        xlnx,ip-name = "mmi_udh_dp";
                        clocks = <&scmi_clk 0x67>;
                        clock-names = "pixel_clk";
                        interrupt-parent = <&gic>;
                        interrupt-names = "dptx", "hdcp";
                        interrupts = <0x0 0xb2 0x4 0x0 0xa7 0x4>;
                        reg-names = "dp", "hdcp";
                        reg = <0x0 0xede00000 0x0 0x40000 0x0 0xedeb0000 0x0 0x100>;
                        status = "okay";
                        compatible = "amd,mmi-dptx-1.0";

                        ports {
                                #size-cells = <0x0>;
                                #address-cells = <0x1>;

                                port@0 {
                                        reg = <0x0>;

                                        dptx_in_0: endpoint {
                                                phandle = <0xe6>;
                                                remote-endpoint = <&dc_out_0>;
                                        };
                                };

                                port@1 {
                                        reg = <0x1>;

                                        dptx_in_1: endpoint {
                                                phandle = <0xe7>;
                                                remote-endpoint = <&dc_out_1>;
                                        };
                                };

                                port@2 {
                                        reg = <0x2>;

                                        dptx_in_2: endpoint {
                                                phandle = <0xe8>;
                                                remote-endpoint = <&dc_out_2>;
                                        };
                                };

                                port@3 {
                                        reg = <0x3>;

                                        dptx_in_3: endpoint {
                                                phandle = <0xe9>;
                                                remote-endpoint = <&dc_out_3>;
                                        };
                                };
                        };
                };

                mmi_dcdma: dma-controller@edd10000 {
                        phandle = <0xc>;
                        clocks = <&scmi_clk 0x6a>;
                        #dma-cells = <0x1>;
                        clock-names = "axi_clk";
                        interrupt-parent = <&gic>;
                        interrupts = <0x0 0xb3 0x4>;
                        reg = <0x0 0xedd10000 0x0 0x1000>;
                        status = "okay";
                        compatible = "amd,mmi-dcdma-1.0";
                };

                mmi_dc: mmi_dc@edd00000 {
                        phandle = <0x5b>;
                        xlnx,ip-name = "mmi_dc";
                        xlnx,dc-operating-mode = "DC_Functional";
                        xlnx,dc-presentation-mode = "Non_Live";
                        xlnx,vid-intfc-mode = "";
                        resets = <&scmi_reset 0x18>;
                        clocks = <&scmi_clk 0x65>,
                         <&scmi_clk 0x67>,
                         <&scmi_clk 0x6b>;
                        clock-names = "mmi_pll", "ps_vid_clk", "stc_ref_clk";
                        dmas = <&mmi_dcdma 0x0>,
                         <&mmi_dcdma 0x1>,
                         <&mmi_dcdma 0x2>,
                         <&mmi_dcdma 0x3>,
                         <&mmi_dcdma 0x4>,
                         <&mmi_dcdma 0x5>,
                         <&mmi_dcdma 0x6>,
                         <&mmi_dcdma 0x7>;
                        dma-names = "vid.0.0", "vid.0.1", "vid.0.2", "vid.1.0", "vid.1.1", "vid.1.2", "aud", "cur";
                        interrupt-parent = <&gic>;
                        interrupts = <0x0 0xb3 0x4>;
                        reg-names = "dp", "blend", "avbuf", "misc", "irq";

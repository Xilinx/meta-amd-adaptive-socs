                         <0x0 0x63 0x0 &gic_r52 0x0 0x63 0x4>,
                         <0x0 0xa9 0x0 &gic_r52 0x0 0xa9 0x4>,
                         <0x0 0xb4 0x0 &gic_r52 0x0 0xb4 0x4>,
                         <0x0 0xb5 0x0 &gic_r52 0x0 0xb5 0x4>,
                         <0x0 0xb6 0x0 &gic_r52 0x0 0xb6 0x4>,
                         <0x0 0xb7 0x0 &gic_r52 0x0 0xb7 0x4>,
                         <0x0 0xb9 0x0 &gic_r52 0x0 0xb9 0x4>,
                         <0x0 0xbe 0x0 &gic_r52 0x0 0xbe 0x4>,
                         <0x0 0xbf 0x0 &gic_r52 0x0 0xbf 0x4>,
                         <0x0 0xc8 0x0 &gic_r52 0x0 0xc8 0x4>,
                         <0x0 0xc9 0x0 &gic_r52 0x0 0xc9 0x4>,
                         <0x0 0x8b 0x0 &gic_r52 0x0 0x8b 0x1>,
                         <0x0 0x8c 0x0 &gic_r52 0x0 0x8c 0x1>,
                         <0x0 0x8f 0x0 &gic_r52 0x0 0x8f 0x1>,
                         <0x0 0x90 0x0 &gic_r52 0x0 0x90 0x1>,
                         <0x0 0x93 0x0 &gic_r52 0x0 0x93 0x1>,
                         <0x0 0x94 0x0 &gic_r52 0x0 0x94 0x1>,
                         <0x0 0xa4 0x0 &gic_r52 0x0 0xa4 0x1>,
                         <0x0 0xa5 0x0 &gic_r52 0x0 0xa5 0x1>;
                        interrupt-map-mask = <0x0 0xffff 0x0>;
                        interrupt-parent = <&gic_a78>,
                         <&gic_r52>;
                        interrupt-controller;
                        #interrupt-cells = <0x3>;
                        #address-cells = <0x0>;
                        compatible = "interrupt-multiplex";
                };

                gpu: gpu@ed000000 {
                        phandle = <0x4d>;
                        xlnx,name = "ps_wizard_0_ps11_0_mmi_gpu";
                        xlnx,gpu-clk-src = "MMI_PLL";
                        xlnx,ip-name = "mmi_gpu";
                        xlnx,gpu-slice1-cores = <0x0>;
                        xlnx,gpu-slice0-cores = <0x1>;
                        xlnx,gpu-clk-freq-mhz = <0x3b9aca00>;
                        xlnx,gpu-slices = <0x1>;
                        #interrupt-cells = <0x2>;
                        #size-cells = <0x2>;
                        #address-cells = <0x2>;
                        ranges;
                        compatible = "arm,mali-ptm";
                        status = "okay";

                        gpu_interface@ed700000 {
                                #size-cells = <0x2>;
                                #address-cells = <0x2>;
                                reg = <0x0 0xed700000 0x0 0x20000>;
                                ranges = <0x0 0x0 0x0 0xed700000 0x0 0x20000>;
                                compatible = "arm,mali-ptm-interface";

                                gpu_system: gpu_system@0 {
                                        phandle = <0x101>;
                                        interrupts = <0x0 0xbc 0x4 0x0 0xbc 0x4>;
                                        interrupt-names = "PTM_UNCORRECTED_ERROR_IRQ", "PTM_DEFERRED_ERROR_IRQ";
                                        interrupt-parent = <&imux>;
                                        reg = <0x0 0x0 0x0 0x10000>;
                                        compatible = "arm,mali-gpu-system";
                                };

                                gpu_assign: gpu_assign@10000 {
                                        phandle = <0x102>;
                                        reg = <0x0 0x10000 0x0 0x10000>;
                                        compatible = "arm,mali-gpu-assign";
                                };
                        };

                        gpu_interface@ed000000 {
                                #size-cells = <0x2>;
                                #address-cells = <0x2>;
                                reg = <0x0 0xed000000 0x0 0x300000>;
                                ranges = <0x0 0x0 0x0 0xed000000 0x0 0x300000>;
                                compatible = "arm,mali-ptm-interface";

                                gpu_partition_config_a_0: gpu_partition_config@20000 {
                                        phandle = <0xb6>;
                                        reg = <0x0 0x20000 0x0 0x10000>;
                                        compatible = "arm,mali-gpu-partition-config";
                                };

                                gpu_partition_control_a_0: gpu_partition_control@30000 {
                                        phandle = <0xb7>;
                                        interrupts = <0x0 0xbb 0x4>;
                                        interrupt-names = "PTM_PARTITION_IRQ";
                                        interrupt-parent = <&imux>;
                                        reg = <0x0 0x30000 0x0 0x10000>;
                                        compatible = "arm,mali-gpu-partition-control";
                                };

                                gpu_resource_group: gpu_resource_group@a0000 {
                                        phandle = <0x103>;
                                        interrupts = <0x0 0xba 0x4>;
                                        interrupt-names = "PTM_GROUP_IRQ";
                                        interrupt-parent = <&imux>;
                                        partition-control = <&gpu_partition_control_a_0>;
                                        partition-config = <&gpu_partition_config_a_0>;
                                        reg = <0x0 0xa0000 0x0 0x10000>;
                                        compatible = "arm,mali-gpu-resource-group";
                                };

                                gpu_aw_message_a_0: gpu_aw_message@fffc0 {
                                        phandle = <0xb8>;
                                        interrupts = <0x0 0xb9 0x4>;
                                        interrupt-names = "PTM_MESSAGE";
                                        interrupt-parent = <&imux>;
                                        reg = <0x0 0xfffc0 0x0 0x40>;
                                        compatible = "arm,mali-gpu-aw-message";
                                };

                                gpu_mali: gpu@e0000 {
                                        phandle = <0x104>;
                                        resets = <&versal2_reset 0xc10411a>,
                                         <&versal2_reset 0xc10411b>;
                                        clocks = <&versal2_clk 0xdd>;
                                        system-coherency = <0x1f>;
                                        reset-names = "gpu", "gpu_recov";
                                        arbiter-if = <&gpu_aw_message_a_0>;
                                        interrupts = <0x0 0xb9 0x4 0x0 0xb9 0x4 0x0 0xb9 0x4>;
                                        interrupt-names = "JOB", "MMU", "GPU";
                                        interrupt-parent = <&imux>;
                                        reg = <0x0 0xe0000 0x0 0x1ffc0>;
                                        compatible = "arm,mali-midgard";
                                };
                        };
                };

                mmi_dptx: mmi_dptx@ede00000 {
                        phandle = <0x105>;
                        clocks = <&versal2_clk 0xda>;
                        clock-names = "pixel_clk";
                        interrupt-parent = <&imux>;
                        interrupt-names = "dptx", "hdcp";
                        interrupts = <0x0 0xb2 0x4 0x0 0xa7 0x4>;
                        reg-names = "dp", "hdcp";
                        reg = <0x0 0xede00000 0x0 0x40000 0x0 0xedeb0000 0x0 0x100>;
                        status = "disabled";
                        compatible = "amd,mmi-dptx-1.0";

                        ports {
                                #size-cells = <0x0>;
                                #address-cells = <0x1>;

                                port@0 {
                                        reg = <0x0>;

                                        dptx_in_0: endpoint {
                                                phandle = <0xc1>;
                                                remote-endpoint = <&dc_out_0>;
                                        };
                                };

                                port@1 {
                                        reg = <0x1>;

                                        dptx_in_1: endpoint {
                                                phandle = <0xc2>;
                                                remote-endpoint = <&dc_out_1>;
                                        };
                                };

                                port@2 {
                                        reg = <0x2>;

                                        dptx_in_2: endpoint {
                                                phandle = <0xc3>;
                                                remote-endpoint = <&dc_out_2>;
                                        };
                                };

                                port@3 {
                                        reg = <0x3>;

                                        dptx_in_3: endpoint {
                                                phandle = <0xc4>;
                                                remote-endpoint = <&dc_out_3>;
                                        };
                                };
                        };
                };

                mmi_dcdma: dma-controller@edd10000 {
                        phandle = <0xc0>;
                        clocks = <&clk50>;
                        #dma-cells = <0x1>;
                        clock-names = "axi_clk";
                        interrupt-parent = <&imux>;
                        interrupts = <0x0 0xb3 0x4>;
                        reg = <0x0 0xedd10000 0x0 0x1000>;
                        status = "disabled";
                        compatible = "amd,mmi-dcdma-1.0";
                };

                mmi_dc: mmi_dc@edd00000 {
                        phandle = <0x106>;
                        resets = <&versal2_reset 0xc104119>;
                        clocks = <&versal2_clk 0xd7>,
                         <&versal2_clk 0xda>,
                         <&versal2_clk 0xdf>;
                        clock-names = "mmi_pll", "ps_vid_clk", "stc_ref_clk";
                        dmas = <&mmi_dcdma 0x0>,
                         <&mmi_dcdma 0x1>,
                         <&mmi_dcdma 0x2>,
                         <&mmi_dcdma 0x3>,
                         <&mmi_dcdma 0x4>,
                         <&mmi_dcdma 0x5>,
                         <&mmi_dcdma 0x6>,
                         <&mmi_dcdma 0x7>;
                        dma-names = "vid.0.0", "vid.0.1", "vid.0.2", "vid.1.0", "vid.1.1", "vid.1.2", "aud", "cur";
                        interrupt-parent = <&imux>;
                        interrupts = <0x0 0xb3 0x4>;
                        reg-names = "dp", "blend", "avbuf", "misc", "irq";
                        reg = <0x0 0xedd00000 0x0 0x1000 0x0 0xedd0a000 0x0 0x1000 0x0 0xedd0b000 0x0 0x1000 0x0 0xedd0c000 0x0 0x1000 0x0 0xedd0d000 0x0 0x1000>;
                        status = "disabled";
                        compatible = "amd,mmi-dc-1.0";

                        ports {
                                #size-cells = <0x0>;
                                #address-cells = <0x1>;

                                port@0 {
                                        reg = <0x0>;
                                };


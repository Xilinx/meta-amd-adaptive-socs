/dts-v1/;
/ {
        speed_grade = "1LHP";
        family = "Versal_2VE_2VM";
        slrcount = <0x1>;
        variant = "Versal_2VE_2VM_Small";
        xlnx,ddrmc5-i2c-master = "PMC";
        xlnx,ddrmc5-debug-elf = "false";
        device_id = "xc2vm3654";
        vivado-version = "2026.2.0";
        interrupt-parent = <&imux>;
        #size-cells = <0x2>;
        #address-cells = <0x2>;
        model = "AMD Versal VMK365 revA";
        compatible = "amd,versal2-vmk365-revA", "amd,versal2-vmk365", "amd,versal2";

        options {

                u-boot {
                        bootscr-address = /bits/ 64 <0x78000000>;
                        compatible = "u-boot,config";
                };
        };

        cpus_a78: cpus-a78@0 {
                phandle = <0xd7>;
                #ranges-size-cells = <0x2>;
                #ranges-address-cells = <0x2>;
                address-map = <0x0 0xf0000000 &amba 0x0 0xf0000000 0x0 0x10000000>,
                 <0x0 0xf9000000 &amba_apu 0x0 0xf9000000 0x0 0x80000>,
                 <0x0 0x0 &noc2_ddr5_ddr_memory 0x0 0x0 0x0 0x80000000>,
                 <0x0 0xeb330000 &ipi0 0x0 0xeb330000 0x0 0x10000>,
                 <0x0 0xeb3b0000 &ipi_nobuf1 0x0 0xeb3b0000 0x0 0x1000>,
                 <0x0 0xeb360000 &ipi3 0x0 0xeb360000 0x0 0x10000>,
                 <0x0 0xeb370000 &ipi4 0x0 0xeb370000 0x0 0x10000>,
                 <0x0 0xeb380000 &ipi5 0x0 0xeb380000 0x0 0x10000>,
                 <0x0 0xeb3a0000 &ipi6 0x0 0xeb3a0000 0x0 0x10000>,
                 <0x0 0xbbf00000 &ps_wizard_0_ps11_0_ocm_ram_0_memory 0x0 0xbbf00000 0x0 0x80000>,
                 <0x0 0xbbf80000 &ps_wizard_0_ps11_0_ocm_ram_1_memory 0x0 0xbbf80000 0x0 0x80000>,
                 <0x0 0xe2000000 &gic_a78 0x0 0xe2000000 0x0 0x400000>,
                 <0x0 0xea460000 &ps_wizard_0_ps11_0_lpd_systmr_read 0x0 0xea460000 0x0 0x10000>,
                 <0x0 0xea470000 &ps_wizard_0_ps11_0_lpd_systmr_ctrl 0x0 0xea470000 0x0 0x10000>,
                 <0x0 0xeb5d0000 &ps_wizard_0_ps11_0_ocm_ctrl_0 0x0 0xeb5d0000 0x0 0x10000>,
                 <0x0 0xeb960000 &ps_wizard_0_ps11_0_ocm_ctrl_1 0x0 0xeb960000 0x0 0x10000>,
                 <0x0 0xeba00000 &r52_0a_atcm_global 0x0 0xeba00000 0x0 0x10000>,
                 <0x0 0xeba10000 &r52_0a_btcm_global 0x0 0xeba10000 0x0 0x8000>,
                 <0x0 0xeba20000 &r52_0a_ctcm_global 0x0 0xeba20000 0x0 0x8000>,
                 <0x0 0xeba40000 &r52_1a_atcm_global 0x0 0xeba40000 0x0 0x10000>,
                 <0x0 0xeba50000 &r52_1a_btcm_global 0x0 0xeba50000 0x0 0x8000>,
                 <0x0 0xeba60000 &r52_1a_ctcm_global 0x0 0xeba60000 0x0 0x8000>,
                 <0x0 0xeba80000 &r52_0b_atcm_global 0x0 0xeba80000 0x0 0x10000>,
                 <0x0 0xeba90000 &r52_0b_btcm_global 0x0 0xeba90000 0x0 0x8000>,
                 <0x0 0xebaa0000 &r52_0b_ctcm_global 0x0 0xebaa0000 0x0 0x8000>,
                 <0x0 0xebac0000 &r52_1b_atcm_global 0x0 0xebac0000 0x0 0x10000>,
                 <0x0 0xebad0000 &r52_1b_btcm_global 0x0 0xebad0000 0x0 0x8000>,
                 <0x0 0xebae0000 &r52_1b_ctcm_global 0x0 0xebae0000 0x0 0x8000>,
                 <0x0 0xebb00000 &r52_0c_atcm_global 0x0 0xebb00000 0x0 0x10000>,
                 <0x0 0xebb10000 &r52_0c_btcm_global 0x0 0xebb10000 0x0 0x8000>,
                 <0x0 0xebb20000 &r52_0c_ctcm_global 0x0 0xebb20000 0x0 0x8000>,
                 <0x0 0xebb40000 &r52_1c_atcm_global 0x0 0xebb40000 0x0 0x10000>,
                 <0x0 0xebb50000 &r52_1c_btcm_global 0x0 0xebb50000 0x0 0x8000>,
                 <0x0 0xebb60000 &r52_1c_ctcm_global 0x0 0xebb60000 0x0 0x8000>,
                 <0x0 0xebd00000 &adma0 0x0 0xebd00000 0x0 0x10000>,
                 <0x0 0xebd10000 &adma1 0x0 0xebd10000 0x0 0x10000>,
                 <0x0 0xebd20000 &adma2 0x0 0xebd20000 0x0 0x10000>,
                 <0x0 0xebd30000 &adma3 0x0 0xebd30000 0x0 0x10000>,
                 <0x0 0xebd40000 &adma4 0x0 0xebd40000 0x0 0x10000>,
                 <0x0 0xebd50000 &adma5 0x0 0xebd50000 0x0 0x10000>,
                 <0x0 0xebd60000 &adma6 0x0 0xebd60000 0x0 0x10000>,
                 <0x0 0xebd70000 &adma7 0x0 0xebd70000 0x0 0x10000>,
                 <0x0 0xebd80000 &ps_wizard_0_ps11_0_sdma_0 0x0 0xebd80000 0x0 0x10000>,
                 <0x0 0xebd90000 &ps_wizard_0_ps11_0_sdma_1 0x0 0xebd90000 0x0 0x10000>,
                 <0x0 0xebda0000 &ps_wizard_0_ps11_0_sdma_2 0x0 0xebda0000 0x0 0x10000>,
                 <0x0 0xebdb0000 &ps_wizard_0_ps11_0_sdma_3 0x0 0xebdb0000 0x0 0x10000>,
                 <0x0 0xebdc0000 &ps_wizard_0_ps11_0_sdma_4 0x0 0xebdc0000 0x0 0x10000>,
                 <0x0 0xebdd0000 &ps_wizard_0_ps11_0_sdma_5 0x0 0xebdd0000 0x0 0x10000>,
                 <0x0 0xebde0000 &ps_wizard_0_ps11_0_sdma_6 0x0 0xebde0000 0x0 0x10000>,
                 <0x0 0xebdf0000 &ps_wizard_0_ps11_0_sdma_7 0x0 0xebdf0000 0x0 0x10000>,
                 <0x0 0xebe8c000 &asu_dma0 0x0 0xebe8c000 0x0 0x1000>,
                 <0x0 0xec400000 &ps_wizard_0_ps11_0_intfpd_asild_config 0x0 0xec400000 0x0 0x100000>,
                 <0x0 0xec500000 &ps_wizard_0_ps11_0_intfpd_asilb_config 0x0 0xec500000 0x0 0x100000>,
                 <0x0 0xec910000 &ps_wizard_0_ps11_0_fpd_systmr_read 0x0 0xec910000 0x0 0x10000>,
                 <0x0 0xec920000 &ps_wizard_0_ps11_0_fpd_systmr_ctrl 0x0 0xec920000 0x0 0x10000>,
                 <0x0 0xed000000 &gpu 0x0 0xed000000 0x0 0x800000>,
                 <0x0 0xeda00000 &ps_wizard_0_ps11_0_mmi_common 0x0 0xeda00000 0x0 0x300000>,
                 <0x0 0xf0310000 &pmc_ppu1_mdm_0 0x0 0xf0310000 0x0 0x8000>,
                 <0x0 0xf0800000 &coresight 0x0 0xf0800000 0x0 0x4000>,
                 <0x0 0xf08f0000 &ps_wizard_0_ps11_0_coresight_lpd_atm 0x0 0xf08f0000 0x0 0xf000>,
                 <0x0 0xf0c40000 &ps_wizard_0_ps11_0_coresight_fpd_stm 0x0 0xf0c40000 0x0 0x4000>,
                 <0x0 0xf1010000 &ospi 0x0 0xf1010000 0x0 0x10000>,
                 <0x0 0xf1020000 &gpio1 0x0 0xf1020000 0x0 0x10000>,
                 <0x0 0xf1040000 &sdhci0 0x0 0xf1040000 0x0 0x10000>,
                 <0x0 0xf10a0000 &ps_wizard_0_ps11_0_pmc_ufs_0 0x0 0xf10a0000 0x0 0x10000>,
                 <0x0 0xf10b0000 &ufshc 0x0 0xf10b0000 0x0 0x10000>,
                 <0x0 0xf1110000 &ps_wizard_0_ps11_0_pmc_global_0 0x0 0xf1110000 0x0 0x50000>,
                 <0x0 0xf11c0000 &dma0 0x0 0xf11c0000 0x0 0x10000>,
                 <0x0 0xf11d0000 &dma1 0x0 0xf11d0000 0x0 0x10000>,
                 <0x0 0xf11e0000 &ps_wizard_0_ps11_0_pmc_aes 0x0 0xf11e0000 0x0 0x10000>,
                 <0x0 0xf11f0000 &ps_wizard_0_ps11_0_pmc_bbram_ctrl 0x0 0xf11f0000 0x0 0x10000>,
                 <0x0 0xf1200000 &ps_wizard_0_ps11_0_pmc_rsa 0x0 0xf1200000 0x0 0x10000>,
                 <0x0 0xf1210000 &ps_wizard_0_ps11_0_pmc_sha3 0x0 0xf1210000 0x0 0x10000>,
                 <0x0 0xf1220000 &ps_wizard_0_ps11_0_pmc_slave_boot 0x0 0xf1220000 0x0 0x10000>,
                 <0x0 0xf1230000 &trng 0x0 0xf1230000 0x0 0x10000>,
                 <0x0 0xf1240000 &ps_wizard_0_ps11_0_pmc_efuse_ctrl 0x0 0xf1240000 0x0 0x10000>,
                 <0x0 0xf1250000 &ps_wizard_0_ps11_0_pmc_efuse_cache 0x0 0xf1250000 0x0 0x10000>,
                 <0x0 0xf1260000 &ps_wizard_0_ps11_0_crp_0 0x0 0xf1260000 0x0 0x10000>,
                 <0x0 0xf1270000 &sysmon0 0x0 0xf1270000 0x0 0x30000>,
                 <0x0 0xf12a0000 &rtc 0x0 0xf12a0000 0x0 0x10000>,
                 <0x0 0xf12b0000 &pmc_cfu_apb_0 0x0 0xf12b0000 0x0 0x10000>,
                 <0x0 0xf12d0000 &pmc_cfi_cframe_0 0x0 0xf12d0000 0x0 0x1000>,
                 <0x0 0xf1800000 &ps_wizard_0_ps11_0_pmc_sha2 0x0 0xf1800000 0x0 0x10000>,
                 <0x0 0xf1930000 &serial1 0x0 0xf1930000 0x0 0x10000>,
                 <0x0 0xf1948000 &i3c0 0x0 0xf1948000 0x0 0x8000>,
                 <0x0 0xf1958000 &i3c1 0x0 0xf1958000 0x0 0x8000>,
                 <0x0 0xf1a50000 &gpio0 0x0 0xf1a50000 0x0 0x10000>,
                 <0x0 0xf1a70000 &gem1 0x0 0xf1a70000 0x0 0x10000>,
                 <0x0 0xf1b00000 &dwc3_0 0x0 0xf1b00000 0x0 0x100000>,
                 <0x0 0xf1e60000 &ttc0 0x0 0xf1e60000 0x0 0x10000>,
                 <0x0 0xf1e70000 &ttc1 0x0 0xf1e70000 0x0 0x10000>,
                 <0x0 0xf1e90000 &ttc3 0x0 0xf1e90000 0x0 0x10000>,
                 <0x0 0xf1ea0000 &ttc4 0x0 0xf1ea0000 0x0 0x10000>,
                 <0x0 0xf1eb0000 &ttc5 0x0 0xf1eb0000 0x0 0x10000>,
                 <0x0 0xf1ec0000 &ttc6 0x0 0xf1ec0000 0x0 0x10000>,
                 <0x0 0xf1ed0000 &ttc7 0x0 0xf1ed0000 0x0 0x10000>,
                 <0x0 0xf1ee0000 &usb0 0x0 0xf1ee0000 0x0 0x10000>,
                 <0x0 0xf2100000 &ps_wizard_0_ps11_0_pmc_slave_boot_stream 0x0 0xf2100000 0x0 0x10000>,
                 <0x0 0xf6000000 &ps_wizard_0_ps11_0_pmc_ram_npi 0x0 0xf6000000 0x0 0x2000000>,
                 <0x0 0xf8000000 &ps_wizard_0_ps11_0_fpd_cmn 0x0 0xf8000000 0x0 0x4000000>;
                compatible = "cpus,cluster";
                #size-cells = <0x0>;
                #address-cells = <0x1>;

                cpu-map {

                        cluster0 {

                                core0 {
                                        cpu = <&cortexa78_0>;
                                };

                                core1 {
                                        cpu = <&cortexa78_1>;
                                };

                                core2 {
                                        cpu = <&cortexa78_2>;
                                };

                                core3 {
                                        cpu = <&cortexa78_3>;
                                };
                        };
                };

                cortexa78_0: cpu@0 {
                        phandle = <0x81>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x80261194>;
                        xlnx,cpu-clk-freq-hz = <0x80261194>;
                        xlnx,cluster-number = <0x0>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&versal2_clk 0x98>;
                        next-level-cache = <&l2_00>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        cpu-idle-states = <&CPU_RETENTION_0>;
                        operating-points-v2 = <&cpu_opp_table>;
                        reg = <0x0>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_00: l2-cache {
                                phandle = <0x87>;
                                next-level-cache = <&l3_0>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_1: cpu@100 {
                        phandle = <0x82>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x80261194>;
                        xlnx,cpu-clk-freq-hz = <0x80261194>;
                        xlnx,cluster-number = <0x0>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&versal2_clk 0x98>;
                        next-level-cache = <&l2_01>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        cpu-idle-states = <&CPU_RETENTION_0>;
                        operating-points-v2 = <&cpu_opp_table>;
                        reg = <0x100>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_01: l2-cache {
                                phandle = <0x8a>;
                                next-level-cache = <&l3_0>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_2: cpu@10000 {
                        phandle = <0x83>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x5f5e100>;
                        xlnx,cpu-clk-freq-hz = <0x5f5e100>;
                        xlnx,cluster-number = <0x0>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&versal2_clk 0x98>;
                        next-level-cache = <&l2_02>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        cpu-idle-states = <&CPU_RETENTION_0>;
                        operating-points-v2 = <&cpu_opp_table>;
                        reg = <0x200>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_02: l2-cache {
                                phandle = <0x8b>;
                                next-level-cache = <&l3_0>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_3: cpu@10100 {
                        phandle = <0x84>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x5f5e100>;
                        xlnx,cpu-clk-freq-hz = <0x5f5e100>;
                        xlnx,cluster-number = <0x0>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&versal2_clk 0x98>;
                        next-level-cache = <&l2_03>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        cpu-idle-states = <&CPU_RETENTION_0>;
                        operating-points-v2 = <&cpu_opp_table>;
                        reg = <0x300>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_03: l2-cache {
                                phandle = <0x8c>;
                                next-level-cache = <&l3_0>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                l3_0: l3-0-cache {
                        phandle = <0x89>;
                        cache-unified;
                        cache-sets = <0x800>;
                        cache-line-size = <0x40>;
                        cache-size = <0x200000>;
                        cache-level = <0x3>;
                        compatible = "cache";
                };

                idle-states {
                        entry-method = "psci";

                        CPU_RETENTION_0: cpu-retention-0 {
                                phandle = <0x86>;
                                min-residency-us = <0x2710>;
                                exit-latency-us = <0x258>;
                                entry-latency-us = <0x12c>;
                                local-timer-stop;
                                arm,psci-suspend-param = <0x0>;
                                compatible = "arm,idle-state";
                        };
                };
        };

        cpu_opp_table: opp-table {
                phandle = <0x85>;
                compatible = "operating-points-v2";

                opp-2150000000 {
                        opp-microvolt = <0xf4240>;
                        clock-latency-ns = <0x7a120>;
                        opp-hz = /bits/ 64 <0x80266580>;
                };

                opp-1075000000 {
                        opp-microvolt = <0xf4240>;
                        clock-latency-ns = <0x7a120>;
                        opp-hz = /bits/ 64 <0x401332c0>;
                };

                opp-716666667 {
                        opp-microvolt = <0xf4240>;
                        clock-latency-ns = <0x7a120>;
                        opp-hz = /bits/ 64 <0x2ab7772b>;
                };

                opp-537500000 {
                        opp-microvolt = <0xf4240>;
                        clock-latency-ns = <0x7a120>;
                        opp-hz = /bits/ 64 <0x20099960>;
                };
        };

        aliases {
                nvmem0 = "/axi/i2c@f1950000/i2c-arbitrator@72/i2c-arb/eeprom@54";
                ethernet0 = "/axi/ethernet@f1a70000";
                serial2 = "/axi/coresight@f0800000";
                spi3 = "/axi/spi@f19d0000";
                spi2 = "/axi/spi@f19c0000";
                spi1 = "/axi/spi@f1030000";
                spi0 = "/axi/spi@f1010000";
                i2c8 = "/axi/i2c@f1000000";
                i2c7 = "/axi/i2c@f19b0000";
                i2c6 = "/axi/i2c@f19a0000";
                i2c5 = "/axi/i2c@f1990000";
                i2c4 = "/axi/i2c@f1980000";
                i2c3 = "/axi/i2c@f1970000";
                i2c2 = "/axi/i2c@f1960000";
                i2c1 = "/axi/i2c@f1950000";
                mmc1 = "/axi/mmc@f1050000";
                mmc0 = "/axi/mmc@f1040000";
                serial1 = "/axi/serial@f1930000";
        };

        firmware {

                psci: psci {
                        phandle = <0xe8>;
                        method = "smc";
                        compatible = "arm,psci-1.0";
                };

                versal2_firmware: versal2-firmware {
                        phandle = <0x92>;
                        #power-domain-cells = <0x1>;
                        method = "smc";
                        bootph-all;
                        compatible = "xlnx,versal2-firmware";

                        versal2_reset: reset-controller {
                                phandle = <0xba>;
                                #reset-cells = <0x1>;
                                compatible = "xlnx,versal-reset";
                        };

                        versal2_clk: clock-controller {
                                phandle = <0x88>;
                                clock-names = "ref", "pl_alt_ref";
                                clocks = <&ref_clk>,
                                 <&ref_clk>;
                                bootph-all;
                                compatible = "xlnx,versal2-clk";
                                #clock-cells = <0x1>;
                        };

                        versal_net_power: zynqmp-power {
                                phandle = <0xe9>;
                                mbox-names = "tx", "rx";
                                mboxes = <&ipi_mailbox_pmu1 0x0>,
                                 <&ipi_mailbox_pmu1 0x1>;
                                interrupts = <0x0 0x39 0x4>;
                                interrupt-parent = <&imux>;
                                compatible = "xlnx,zynqmp-power";
                        };

                        versal_sec_cfg: versal-sec-cfg {
                                phandle = <0xea>;
                                #size-cells = <0x1>;
                                #address-cells = <0x1>;
                                compatible = "xlnx,versal-sec-cfg";

                                bbram_zeroize: bbram-zeroize@4 {
                                        phandle = <0xeb>;
                                        reg = <0x4 0x4>;
                                };

                                bbram_key: bbram-key@10 {
                                        phandle = <0xec>;
                                        reg = <0x10 0x20>;
                                };

                                bbram_usr: bbram-usr@30 {
                                        phandle = <0xed>;
                                        reg = <0x30 0x4>;
                                };

                                bbram_lock: bbram-lock@48 {
                                        phandle = <0xee>;
                                        reg = <0x48 0x4>;
                                };

                                user_key0: user-key@110 {
                                        phandle = <0xef>;
                                        reg = <0x110 0x20>;
                                };

                                user_key1: user-key@130 {
                                        phandle = <0xf0>;
                                        reg = <0x130 0x20>;
                                };

                                user_key2: user-key@150 {
                                        phandle = <0xf1>;
                                        reg = <0x150 0x20>;
                                };

                                user_key3: user-key@170 {
                                        phandle = <0xf2>;
                                        reg = <0x170 0x20>;
                                };

                                user_key4: user-key@190 {
                                        phandle = <0xf3>;
                                        reg = <0x190 0x20>;
                                };

                                user_key5: user-key@1b0 {
                                        phandle = <0xf4>;
                                        reg = <0x1b0 0x20>;
                                };

                                user_key6: user-key@1d0 {
                                        phandle = <0xf5>;
                                        reg = <0x1d0 0x20>;
                                };

                                user_key7: user-key@1f0 {
                                        phandle = <0xf6>;
                                        reg = <0x1f0 0x20>;
                                };
                        };
                };
        };

        fpga: fpga-region {
                phandle = <0xf7>;
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                fpga-mgr = <&versal_fpga>;
                compatible = "fpga-region";
        };

        timer: timer {
                phandle = <0xf8>;
                interrupts = <0x1 0xd 0x4 0x1 0xe 0x4 0x1 0xb 0x4 0x1 0xa 0x4>;
                compatible = "arm,armv8-timer";
        };

        versal_fpga: versal-fpga {
                phandle = <0xb4>;
                compatible = "xlnx,versal-fpga";
        };

        amba_apu: apu-bus {
                phandle = <0x3>;
                u-boot,dm-pre-reloc;
                interrupt-parent = <&gic_a78>;
                ranges;
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                compatible = "simple-bus";

                gic_a78: interrupt-controller@e2000000 {
                        phandle = <0xe>;
                        xlnx,name = "ps_wizard_0_ps11_0_acpu_gic";
                        xlnx,ip-name = "acpu_gic";
                        status = "okay";
                        ranges;
                        #size-cells = <0x2>;
                        #address-cells = <0x2>;
                        interrupts = <0x1 0x9 0x4>;
                        interrupt-parent = <&gic_a78>;
                        interrupt-controller;
                        reg = <0x0 0xe2000000 0x0 0x10000 0x0 0xe20a0000 0x0 0x80000>;
                        #interrupt-cells = <0x3>;
                        compatible = "arm,gic-v3";

                        its: msi-controller@e2040000 {
                                phandle = <0xd3>;
                                reg = <0x0 0xe2040000 0x0 0x20000>;
                                #msi-cells = <0x1>;
                                msi-controller;
                                compatible = "arm,gic-v3-its";
                        };

                        its1: msi-controller@e2060000 {
                                phandle = <0xf9>;
                                reg = <0x0 0xe2060000 0x0 0x20000>;
                                #msi-cells = <0x1>;
                                msi-controller;
                                compatible = "arm,gic-v3-its";
                        };

                        its2: msi-controller@e2080000 {
                                phandle = <0xfa>;
                                reg = <0x0 0xe2080000 0x0 0x20000>;
                                #msi-cells = <0x1>;
                                msi-controller;
                                compatible = "arm,gic-v3-its";
                        };
                };
        };

        amba_rpu: rpu-bus {
                phandle = <0x8d>;
                u-boot,dm-pre-reloc;
                interrupt-parent = <&gic_r52>;
                ranges;
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                compatible = "indirect-bus";

                gic_r52: interrupt-controller@e2000000 {
                        phandle = <0x90>;
                        xlnx,name = "ps_wizard_0_ps11_0_rcpu_gic";
                        xlnx,ip-name = "rcpu_gic";
                        status = "okay";
                        reg = <0x0 0xe2000000 0x0 0x10000 0x0 0xe2100000 0x0 0x80000>;
                        #size-cells = <0x2>;
                        #address-cells = <0x2>;
                        interrupts = <0x1 0x9 0x4>;
                        interrupt-parent = <&gic_r52>;
                        interrupt-controller;
                        #interrupt-cells = <0x3>;
                        compatible = "arm,gic-v3", "arm,gic";
                };
        };

        sensor0: versal-thermal-sensor {
                phandle = <0xb5>;
                io-channel-names = "sysmon-temp-channel";
                io-channels = <&sysmon0 0x0>;
                #thermal-sensor-cells = <0x1>;
                compatible = "xlnx,versal-thermal";
        };

        thermal-zones {

                versal_thermal: versal-thermal {
                        phandle = <0xfb>;
                        thermal-sensors = <&sensor0 0x0>;
                        polling-delay = <0x3e8>;
                        polling-delay-passive = <0xfa>;

                        trips {

                                temp_alert: temp-alert {
                                        phandle = <0xfc>;
                                        type = "passive";
                                        hysteresis = <0x0>;
                                        temperature = <0x11170>;
                                };

                                ot_crit: ot-crit {
                                        phandle = <0xfd>;
                                        type = "critical";
                                        hysteresis = <0x0>;
                                        temperature = <0x1e848>;
                                };
                        };

                        cooling-maps {
                        };
                };

                versal_thermal_aie: versal-aie-thermal {
                        phandle = <0xfe>;
                        thermal-sensors = <&sensor0 0x1>;
                        polling-delay = <0x3e8>;
                        polling-delay-passive = <0xfa>;

                        trips {

                                temp_alert_aie: temp-alert-aie {
                                        phandle = <0xff>;
                                        type = "passive";
                                        hysteresis = <0x0>;
                                        temperature = <0x11170>;
                                };

                                ot_crit_aie: ot-crit-aie {
                                        phandle = <0x100>;
                                        type = "critical";
                                        hysteresis = <0x0>;
                                        temperature = <0x1e848>;
                                };
                        };

                        cooling-maps {
                        };
                };
        };

        amba: axi {
                phandle = <0x2>;
                interrupt-parent = <&imux>;
                ranges;
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                bootph-all;
                compatible = "simple-bus";

                imux: interrupt-multiplex {
                        phandle = <0x1>;

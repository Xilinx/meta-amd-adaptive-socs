        domains {

                APU_Linux {
                        phandle = <0x254>;
                        compatible = "openamp,domain-v1";
                        reserved-memory = <0x249 0x24a 0x24b 0x24c 0x24d 0x24e>;
                        os,type = "linux";

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";

                                remoteproc-relation {
                                        compatible = "openamp,remoteproc-v2";

                                        relation0 {
                                                remote = <0x24f>;
                                                elfload = <&ddrboot>,
                                                 <&trace_buffer>,
                                                 <&rsctbl>;
                                        };
                                };

                                rpmsg-relation {
                                        compatible = "openamp,rpmsg-v1";

                                        relation0 {
                                                remote = <0x24f>;
                                                carveouts = <0x249 0x24a 0x24b>;
                                                mbox = <0x1b4>;
                                        };
                                };

                                libmetal-relation {
                                        compatible = "libmetal,ipc-v1";

                                        relation0 {
                                                remote = <0x250>;
                                                carveouts = <0x251 0x252 0x253>;
                                                mbox = <0x173>;
                                                timer = <0x78>;
                                        };
                                };
                        };
                };

                RPU_Zephyr {
                        phandle = <0x24f>;
                        compatible = "openamp,domain-v1";
                        os,type = "zephyr";
                        zephyr-version = "4.3";
                        xlnx,ddr-boot;
                        xlnx,zephyr,mems = "ddrboot@9800100";
                        sram = <0x0 0x9800100 0x0 0x5de00 0x0 0xeba00000 0x0 0x10000 0x0 0xeba10000 0x0 0x8000 0x0 0xeba20000 0x0 0x8000>;
                        reserved-memory = <0x24c 0x24d 0x24e>;
                        rpu_pd_val = <0x92 0x0>;
                        cpu_config_str = "split";
                        core_num = "0";
                        linker_file_output_name = "openamp-zephyr.ld";
                        linker-entry = "_vector_table";
                        linker_memories = <0x1d 0x1e 0x1f 0x24c 0x24e>;
                        linker-section-vector-table = <0x1d>;
                        linker-section-vector-table-offset = <0x0>;
                        linker-section-text = <0x1d>;
                        linker-section-rodata = <0x1d>;
                        linker-section-data = <0x1e>;
                        linker-section-bss = <0x1e>;
                        linker-section-noinit = <0x1e>;
                        linker-section-heap = <0x1e>;
                        linker-section-stack = <0x1e>;
                        linker-section-resource-table = <0x24e>;
                        linker-section-resource-table-offset = <0x0>;

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";
                                cluster_cpu = "cortexr52_0";

                                rpmsg-relation {
                                        compatible = "openamp,rpmsg-v1";

                                        relation0 {
                                                host = <0x254>;
                                                mbox = <0x1c2>;
                                                carveouts = <0x249 0x24a 0x24b>;
                                        };
                                };
                        };
                };

                RPU_1_BM {
                        phandle = <0x250>;
                        compatible = "openamp,domain-v1";
                        sram = <0x0 0x9968000 0x0 0x60000 0x0 0xeba80000 0x0 0x10000 0x0 0xeba90000 0x0 0x8000 0x0 0xebaa0000 0x0 0x8000>;
                        cpus = <&cpus_r52_1 0x0 0x80000003>;
                        os,type = "baremetal";
                        rpu_pd_val = <0x92 0x1>;
                        cpu_config_str = "split";
                        core_num = "1";

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";
                                cluster_cpu = "cortexr52_1";

                                libmetal-relation {
                                        compatible = "libmetal,ipc-v1";

                                        relation0 {
                                                host = <0x254>;
                                                carveouts = <0x251 0x252 0x253>;
                                                mbox = <0x165>;
                                                timer = <0x78>;
                                                elfload = <&libmetal_elf>;
                                        };
                                };
                        };
                };

                PMC_MB {
                        compatible = "openamp,domain-v1";
                };
        };

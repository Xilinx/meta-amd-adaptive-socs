/dts-v1/;
/ {
        compatible = "amd,versal2-vmk365-revA", "amd,versal2-vmk365", "amd,versal2";
        model = "AMD Versal VMK365 revA";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        interrupt-parent = <&gic_r52>;
        vivado-version = "2026.2.0";
        device_id = "xc2vm3654";
        xlnx,ddrmc5-debug-elf = "false";
        xlnx,ddrmc5-i2c-master = "PMC";
        variant = "Versal_2VE_2VM_Small";
        slrcount = <0x1>;
        family = "Versal_2VE_2VM";
        speed_grade = "1LHP";
        pruned-sdt = <0x1>;

        options {

                u-boot {
                        compatible = "u-boot,config";
                        bootscr-address = /bits/ 64 <0x78000000>;
                };
        };

        cpu_opp_table: opp-table {
                phandle = <0x85>;
                compatible = "operating-points-v2";

                opp-2150000000 {
                        opp-hz = /bits/ 64 <0x80266580>;
                        clock-latency-ns = <0x7a120>;
                        opp-microvolt = <0xf4240>;
                };

                opp-1075000000 {
                        opp-hz = /bits/ 64 <0x401332c0>;
                        clock-latency-ns = <0x7a120>;
                        opp-microvolt = <0xf4240>;
                };

                opp-716666667 {
                        opp-hz = /bits/ 64 <0x2ab7772b>;
                        clock-latency-ns = <0x7a120>;
                        opp-microvolt = <0xf4240>;
                };

                opp-537500000 {
                        opp-hz = /bits/ 64 <0x20099960>;
                        clock-latency-ns = <0x7a120>;
                        opp-microvolt = <0xf4240>;
                };
        };

        cpus_r52_1: cpus-r52@1 {
                phandle = <0xdb>;
                #address-cells = <0x1>;
                #size-cells = <0x0>;
                compatible = "cpus,cluster";
                address-map = <0xf0000000 &amba 0xf0000000 0x10000000>,
                 <0xf9000000 &amba_rpu 0xf9000000 0x3000>,
                 <0x100000 &noc2_ddr5_ddr_memory 0x100000 0x7ff00000>,
                 <0xeb350000 &ipi2 0xeb350000 0x10000>,
                 <0xeb3b2000 &ipi_nobuf3 0xeb3b2000 0x1000>,
                 <0xbbf00000 &ps_wizard_0_ps11_0_ocm_ram_0_memory 0xbbf00000 0x80000>,
                 <0xbbf80000 &ps_wizard_0_ps11_0_ocm_ram_1_memory 0xbbf80000 0x80000>,
                 <0xea460000 &ps_wizard_0_ps11_0_lpd_systmr_read 0xea460000 0x10000>,
                 <0xea470000 &ps_wizard_0_ps11_0_lpd_systmr_ctrl 0xea470000 0x10000>,
                 <0xeb400000 &ps_wizard_0_ps11_0_ocm_xmpu_0 0xeb400000 0x10000>,
                 <0xeb410000 &ps_wizard_0_ps11_0_lpd_slcr_0 0xeb410000 0x100000>,
                 <0xeb510000 &ps_wizard_0_ps11_0_lpd_slcr_secure_0 0xeb510000 0x40000>,
                 <0xeb580000 &ps_wizard_0_ps11_0_rpu_a 0xeb580000 0x8000>,
                 <0xeb590000 &ps_wizard_0_ps11_0_rpu_b 0xeb590000 0x8000>,
                 <0xeb5a0000 &ps_wizard_0_ps11_0_rpu_c 0xeb5a0000 0x8000>,
                 <0xeb5d0000 &ps_wizard_0_ps11_0_ocm_ctrl_0 0xeb5d0000 0x10000>,
                 <0xeb5e0000 &ps_wizard_0_ps11_0_crl_0 0xeb5e0000 0x300000>,
                 <0xeb960000 &ps_wizard_0_ps11_0_ocm_ctrl_1 0xeb960000 0x10000>,
                 <0xeb980000 &ps_wizard_0_ps11_0_ocm_xmpu_1 0xeb980000 0x10000>,
                 <0xeb990000 &ps_wizard_0_ps11_0_lpd_xppu_0 0xeb990000 0x10000>,
                 <0xeb9b0000 &ps_wizard_0_ps11_0_lpd_afi_0 0xeb9b0000 0x10000>,
                 <0xebd00000 &adma0 0xebd00000 0x10000>,
                 <0xebd10000 &adma1 0xebd10000 0x10000>,
                 <0xebd20000 &adma2 0xebd20000 0x10000>,
                 <0xebd30000 &adma3 0xebd30000 0x10000>,
                 <0xebd40000 &adma4 0xebd40000 0x10000>,
                 <0xebd50000 &adma5 0xebd50000 0x10000>,
                 <0xebd60000 &adma6 0xebd60000 0x10000>,
                 <0xebd70000 &adma7 0xebd70000 0x10000>,
                 <0xebd80000 &ps_wizard_0_ps11_0_sdma_0 0xebd80000 0x10000>,
                 <0xebd90000 &ps_wizard_0_ps11_0_sdma_1 0xebd90000 0x10000>,
                 <0xebda0000 &ps_wizard_0_ps11_0_sdma_2 0xebda0000 0x10000>,
                 <0xebdb0000 &ps_wizard_0_ps11_0_sdma_3 0xebdb0000 0x10000>,
                 <0xebdc0000 &ps_wizard_0_ps11_0_sdma_4 0xebdc0000 0x10000>,
                 <0xebdd0000 &ps_wizard_0_ps11_0_sdma_5 0xebdd0000 0x10000>,
                 <0xebde0000 &ps_wizard_0_ps11_0_sdma_6 0xebde0000 0x10000>,
                 <0xebdf0000 &ps_wizard_0_ps11_0_sdma_7 0xebdf0000 0x10000>,
                 <0xebe8c000 &asu_dma0 0xebe8c000 0x1000>,
                 <0xec200000 &ps_wizard_0_ps11_0_crf_0 0xec200000 0x100000>,
                 <0xec400000 &ps_wizard_0_ps11_0_intfpd_asild_config 0xec400000 0x100000>,
                 <0xec500000 &ps_wizard_0_ps11_0_intfpd_asilb_config 0xec500000 0x100000>,
                 <0xec800000 &ps_wizard_0_ps11_0_intfpd_asild_gpv 0xec800000 0x4000>,
                 <0xec804000 &ps_wizard_0_ps11_0_intfpd_asilb_gpv 0xec804000 0x4000>,
                 <0xec810000 &ps_wizard_0_ps11_0_fpd_slv_asild_xmpu_0 0xec810000 0x10000>,
                 <0xec820000 &ps_wizard_0_ps11_0_fpd_slv_asilb_xmpu_0 0xec820000 0x10000>,
                 <0xec880000 &ps_wizard_0_ps11_0_fpd_afi_0 0xec880000 0x10000>,
                 <0xec8c0000 &ps_wizard_0_ps11_0_fpd_slcr_0 0xec8c0000 0x10000>,
                 <0xec8e0000 &ps_wizard_0_ps11_0_fpd_slcr_secure_0 0xec8e0000 0x10000>,
                 <0xec910000 &ps_wizard_0_ps11_0_fpd_systmr_read 0xec910000 0x10000>,
                 <0xec920000 &ps_wizard_0_ps11_0_fpd_systmr_ctrl 0xec920000 0x10000>,
                 <0xecc00000 &ps_wizard_0_ps11_0_apu_0 0xecc00000 0x10000>,
                 <0xed000000 &gpu 0xed000000 0x800000>,
                 <0xeda00000 &ps_wizard_0_ps11_0_mmi_common 0xeda00000 0x300000>,
                 <0xf0310000 &pmc_ppu1_mdm_0 0xf0310000 0x8000>,
                 <0xf0800000 &coresight 0xf0800000 0x4000>,
                 <0xf08f0000 &ps_wizard_0_ps11_0_coresight_lpd_atm 0xf08f0000 0xf000>,
                 <0xf0c40000 &ps_wizard_0_ps11_0_coresight_fpd_stm 0xf0c40000 0x4000>,
                 <0xf1010000 &ospi 0xf1010000 0x10000>,
                 <0xf1020000 &gpio1 0xf1020000 0x10000>,
                 <0xf1040000 &sdhci0 0xf1040000 0x10000>,
                 <0xf10a0000 &ps_wizard_0_ps11_0_pmc_ufs_0 0xf10a0000 0x10000>,
                 <0xf10b0000 &ufshc 0xf10b0000 0x10000>,
                 <0xf1110000 &ps_wizard_0_ps11_0_pmc_global_0 0xf1110000 0x50000>,
                 <0xf11c0000 &dma0 0xf11c0000 0x10000>,
                 <0xf11d0000 &dma1 0xf11d0000 0x10000>,
                 <0xf11e0000 &ps_wizard_0_ps11_0_pmc_aes 0xf11e0000 0x10000>,
                 <0xf11f0000 &ps_wizard_0_ps11_0_pmc_bbram_ctrl 0xf11f0000 0x10000>,
                 <0xf1200000 &ps_wizard_0_ps11_0_pmc_rsa 0xf1200000 0x10000>,
                 <0xf1210000 &ps_wizard_0_ps11_0_pmc_sha3 0xf1210000 0x10000>,
                 <0xf1220000 &ps_wizard_0_ps11_0_pmc_slave_boot 0xf1220000 0x10000>,
                 <0xf1230000 &trng 0xf1230000 0x10000>,
                 <0xf1240000 &ps_wizard_0_ps11_0_pmc_efuse_ctrl 0xf1240000 0x10000>,
                 <0xf1250000 &ps_wizard_0_ps11_0_pmc_efuse_cache 0xf1250000 0x10000>,
                 <0xf1260000 &ps_wizard_0_ps11_0_crp_0 0xf1260000 0x10000>,
                 <0xf1270000 &sysmon0 0xf1270000 0x30000>,
                 <0xf12a0000 &rtc 0xf12a0000 0x10000>,
                 <0xf12b0000 &pmc_cfu_apb_0 0xf12b0000 0x10000>,
                 <0xf12d0000 &pmc_cfi_cframe_0 0xf12d0000 0x1000>,
                 <0xf12f0000 &ps_wizard_0_ps11_0_pmc_xmpu_0 0xf12f0000 0x10000>,
                 <0xf1300000 &ps_wizard_0_ps11_0_pmc_xppu_npi_0 0xf1300000 0x10000>,
                 <0xf1310000 &ps_wizard_0_ps11_0_pmc_xppu_0 0xf1310000 0x10000>,
                 <0xf1800000 &ps_wizard_0_ps11_0_pmc_sha2 0xf1800000 0x10000>,
                 <0xf1920000 &serial0 0xf1920000 0x10000>,
                 <0xf1930000 &serial1 0xf1930000 0x10000>,
                 <0xf1948000 &i3c0 0xf1948000 0x8000>,
                 <0xf1958000 &i3c1 0xf1958000 0x8000>,
                 <0xf1a20000 &ps_wizard_0_ps11_0_lpd_iou_slcr_0 0xf1a20000 0x20000>,
                 <0xf1a40000 &ps_wizard_0_ps11_0_lpd_iou_secure_slcr_0 0xf1a40000 0x10000>,
                 <0xf1a50000 &gpio0 0xf1a50000 0x10000>,
                 <0xf1a70000 &gem1 0xf1a70000 0x10000>,
                 <0xf1b00000 &dwc3_0 0xf1b00000 0x100000>,
                 <0xf1e60000 &ttc0 0xf1e60000 0x10000>,
                 <0xf1e70000 &ttc1 0xf1e70000 0x10000>,
                 <0xf1e80000 &ttc2 0xf1e80000 0x10000>,
                 <0xf1e90000 &ttc3 0xf1e90000 0x10000>,
                 <0xf1ea0000 &ttc4 0xf1ea0000 0x10000>,
                 <0xf1eb0000 &ttc5 0xf1eb0000 0x10000>,
                 <0xf1ec0000 &ttc6 0xf1ec0000 0x10000>,
                 <0xf1ed0000 &ttc7 0xf1ed0000 0x10000>,
                 <0xf1ee0000 &usb0 0xf1ee0000 0x10000>,
                 <0xf2100000 &ps_wizard_0_ps11_0_pmc_slave_boot_stream 0xf2100000 0x10000>,
                 <0xf6000000 &ps_wizard_0_ps11_0_pmc_ram_npi 0xf6000000 0x2000000>,
                 <0xf8000000 &ps_wizard_0_ps11_0_fpd_cmn 0xf8000000 0x4000000>,
                 <0xe2000000 &gic_r52 0xe2000000 0x10000>,
                 <0x0 &ps_wizard_0_ps11_0_r52_tcm_alias 0x0 0x100000>;
                #ranges-address-cells = <0x1>;
                #ranges-size-cells = <0x1>;

                cortexr52_1: cpu@1 {
                        phandle = <0xdc>;
                        compatible = "arm,cortex-r52";
                        device_type = "cpu";
                        reg = <0x1>;
                        power-domains = <&scmi_devpd 0x1>;
                        xlnx,is-cache-coherent = <0x0>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,ip-name = "cortexr52";
                        xlnx,cluster-number = <0x0>;
                        cpu-frequency = <0x3d181a32>;
                        bus-handle = <0x2>;
                        xlnx,cpu-clk-freq-hz = <0x3d181a32>;
                };
        };

        aliases {
                serial0 = "/axi/serial@f1920000";
                serial1 = "/axi/serial@f1930000";
                mmc0 = "/axi/mmc@f1040000";
                spi0 = "/axi/spi@f1010000";
                serial2 = "/axi/coresight@f0800000";
                ethernet0 = "/axi/ethernet@f1a70000";
        };

        firmware {

                psci: psci {
                        phandle = <0xe9>;
                        compatible = "arm,psci-1.0";
                        method = "smc";
                };

                scmi: scmi {
                        phandle = <0xea>;
                        compatible = "arm,scmi-smc";
                        arm,smc-id = <0xc2002000>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;
                        shmem = <0xb2>;
                        bootph-all;

                        scmi_reset: protocol@16 {
                                phandle = <0xbb>;
                                reg = <0x16>;
                                #reset-cells = <0x1>;
                        };

                        scmi_devpd: protocol@11 {
                                phandle = <0x92>;
                                reg = <0x11>;
                                #power-domain-cells = <0x1>;
                        };

                        scmi_clk: protocol@14 {
                                phandle = <0x88>;
                                reg = <0x14>;
                                #clock-cells = <0x1>;
                        };
                };

                versal2_firmware: versal2-firmware {
                        phandle = <0xeb>;
                        compatible = "xlnx,versal2-firmware";
                        bootph-all;
                        method = "smc";
                        #power-domain-cells = <0x1>;

                        versal_sec_cfg: versal-sec-cfg {
                                phandle = <0xef>;
                                compatible = "xlnx,versal-sec-cfg";

                                nvmem-layout {
                                        compatible = "fixed-layout";
                                        #address-cells = <0x1>;
                                        #size-cells = <0x1>;

                                        bbram_zeroize: bbram-zeroize@4 {
                                                phandle = <0xf0>;
                                                reg = <0x4 0x4>;
                                        };

                                        bbram_key: bbram-key@10 {
                                                phandle = <0xf1>;
                                                reg = <0x10 0x20>;
                                        };

                                        bbram_usr: bbram-usr@30 {
                                                phandle = <0xf2>;
                                                reg = <0x30 0x4>;
                                        };

                                        bbram_lock: bbram-lock@48 {
                                                phandle = <0xf3>;
                                                reg = <0x48 0x4>;
                                        };

                                        user_key0: user-key@110 {
                                                phandle = <0xf4>;
                                                reg = <0x110 0x20>;
                                        };

                                        user_key1: user-key@130 {
                                                phandle = <0xf5>;
                                                reg = <0x130 0x20>;
                                        };

                                        user_key2: user-key@150 {
                                                phandle = <0xf6>;
                                                reg = <0x150 0x20>;
                                        };

                                        user_key3: user-key@170 {
                                                phandle = <0xf7>;
                                                reg = <0x170 0x20>;
                                        };

                                        user_key4: user-key@190 {
                                                phandle = <0xf8>;
                                                reg = <0x190 0x20>;
                                        };

                                        user_key5: user-key@1b0 {
                                                phandle = <0xf9>;
                                                reg = <0x1b0 0x20>;
                                        };

                                        user_key6: user-key@1d0 {
                                                phandle = <0xfa>;
                                                reg = <0x1d0 0x20>;
                                        };

                                        user_key7: user-key@1f0 {
                                                phandle = <0xfb>;
                                                reg = <0x1f0 0x20>;
                                        };
                                };
                        };
                };
        };

        fpga: fpga-region {
                phandle = <0xfc>;
                compatible = "fpga-region";
                fpga-mgr = <&versal_fpga>;
                #address-cells = <0x2>;
                #size-cells = <0x2>;
        };

        timer: timer {
                phandle = <0xfd>;
                compatible = "arm,armv8-timer";
                interrupts = <0x1 0xd 0x4 0x1 0xe 0x4 0x1 0xb 0x4 0x1 0xa 0x4>;
        };

        versal_fpga: versal-fpga {
                phandle = <0xb5>;
                compatible = "xlnx,versal-fpga";
        };

        amba_apu: apu-bus {
                phandle = <0x3>;
                compatible = "simple-bus";
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                u-boot,dm-pre-reloc;
        };

        amba_rpu: rpu-bus {
                phandle = <0x8d>;
                compatible = "indirect-bus";
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                interrupt-parent = <&gic_r52>;
                u-boot,dm-pre-reloc;

                gic_r52: interrupt-controller@e2000000 {
                        phandle = <0x90>;
                        compatible = "arm,gic-v3", "arm,gic";
                        #interrupt-cells = <0x3>;
                        interrupt-controller;
                        interrupt-parent = <&gic_r52>;
                        interrupts = <0x1 0x9 0x4>;
                        #address-cells = <0x2>;
                        #size-cells = <0x2>;
                        reg = <0x0 0xe2000000 0x0 0x10000 0x0 0xe2100000 0x0 0x80000>;
                        status = "okay";
                        xlnx,ip-name = "rcpu_gic";
                        xlnx,name = "ps_wizard_0_ps11_0_rcpu_gic";
                };
        };

        sensor0: versal-thermal-sensor {
                phandle = <0xb6>;
                compatible = "xlnx,versal-thermal";
                #thermal-sensor-cells = <0x1>;
                io-channels = <&sysmon0 0x0>;
                io-channel-names = "sysmon-temp-channel";
        };

        thermal-zones {

                versal_thermal: versal-thermal {
                        phandle = <0x100>;
                        polling-delay-passive = <0xfa>;
                        polling-delay = <0x3e8>;
                        thermal-sensors = <&sensor0 0x0>;

                        trips {

                                temp_alert: temp-alert {
                                        phandle = <0x101>;
                                        temperature = <0x11170>;
                                        hysteresis = <0x0>;
                                        type = "passive";
                                };

                                ot_crit: ot-crit {
                                        phandle = <0x102>;
                                        temperature = <0x1e848>;
                                        hysteresis = <0x0>;
                                        type = "critical";
                                };
                        };

                        cooling-maps {
                        };
                };

                versal_thermal_aie: versal-aie-thermal {
                        phandle = <0x103>;
                        polling-delay-passive = <0xfa>;
                        polling-delay = <0x3e8>;
                        thermal-sensors = <&sensor0 0x1>;

                        trips {

                                temp_alert_aie: temp-alert-aie {
                                        phandle = <0x104>;
                                        temperature = <0x11170>;
                                        hysteresis = <0x0>;
                                        type = "passive";
                                };

                                ot_crit_aie: ot-crit-aie {
                                        phandle = <0x105>;
                                        temperature = <0x1e848>;
                                        hysteresis = <0x0>;
                                        type = "critical";
                                };
                        };

                        cooling-maps {
                        };
                };
        };

        amba: axi {
                phandle = <0x2>;
                compatible = "simple-bus";
                bootph-all;
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                interrupt-parent = <&gic_r52>;

                mmi_gpu_slcr@ed720000 {
                        reg = <0x0 0xed720000 0x0 0x20000>;
                        no-map;
                };

                gpu_physical_memory_group_manager: physical-memory-group-manager {
                        phandle = <0xba>;
                        compatible = "arm,physical-memory-group-manager";
                };

                gpu: gpu@ed000000 {
                        phandle = <0x4d>;
                        status = "okay";
                        compatible = "arm,mali-ptm";
                        ranges;
                        #address-cells = <0x2>;
                        #size-cells = <0x2>;
                        #interrupt-cells = <0x2>;
                        xlnx,gpu-slices = <0x1>;
                        xlnx,gpu-clk-freq-mhz = <0x3b9aca00>;
                        xlnx,gpu-slice0-cores = <0x1>;
                        xlnx,gpu-slice1-cores = <0x0>;
                        xlnx,ip-name = "mmi_gpu";
                        xlnx,gpu-clk-src = "MMI_PLL";
                        xlnx,name = "ps_wizard_0_ps11_0_mmi_gpu";

                        gpu_interface@ed700000 {
                                compatible = "arm,mali-ptm-interface";
                                ranges = <0x0 0x0 0x0 0xed700000 0x0 0x20000>;
                                reg = <0x0 0xed700000 0x0 0x20000>;
                                #address-cells = <0x2>;
                                #size-cells = <0x2>;

                                gpu_system: gpu_system@0 {
                                        phandle = <0x106>;
                                        compatible = "arm,mali-gpu-system";
                                        reg = <0x0 0x0 0x0 0x10000>;
                                        interrupt-parent = <&gic_r52>;
                                        interrupt-names = "PTM_UNCORRECTED_ERROR_IRQ", "PTM_DEFERRED_ERROR_IRQ";
                                        interrupts = <0x0 0xbc 0x4 0x0 0xbc 0x4>;
                                };

                                gpu_assign: gpu_assign@10000 {
                                        phandle = <0x107>;
                                        compatible = "arm,mali-gpu-assign";
                                        reg = <0x0 0x10000 0x0 0x10000>;
                                };
                        };

                        gpu_interface@ed000000 {
                                compatible = "arm,mali-ptm-interface";
                                ranges = <0x0 0x0 0x0 0xed000000 0x0 0x300000>;
                                reg = <0x0 0xed000000 0x0 0x300000>;
                                #address-cells = <0x2>;
                                #size-cells = <0x2>;

                                gpu_partition_config_a_0: gpu_partition_config@20000 {
                                        phandle = <0xb7>;
                                        compatible = "arm,mali-gpu-partition-config";
                                        reg = <0x0 0x20000 0x0 0x10000>;
                                };

                                gpu_partition_control_a_0: gpu_partition_control@30000 {
                                        phandle = <0xb8>;
                                        compatible = "arm,mali-gpu-partition-control";
                                        reg = <0x0 0x30000 0x0 0x10000>;
                                        interrupt-parent = <&gic_r52>;
                                        interrupt-names = "PTM_PARTITION_IRQ";
                                        interrupts = <0x0 0xbb 0x4>;
                                };

                                gpu_resource_group: gpu_resource_group@a0000 {
                                        phandle = <0x108>;
                                        compatible = "arm,mali-gpu-resource-group";
                                        reg = <0x0 0xa0000 0x0 0x10000>;
                                        partition-config = <&gpu_partition_config_a_0>;
                                        partition-control = <&gpu_partition_control_a_0>;
                                        interrupt-parent = <&gic_r52>;
                                        interrupt-names = "PTM_GROUP_IRQ";
                                        interrupts = <0x0 0xba 0x4>;
                                };

                                gpu_aw_message_a_0: gpu_aw_message@fffc0 {
                                        phandle = <0xb9>;
                                        compatible = "arm,mali-gpu-aw-message";
                                        reg = <0x0 0xfffc0 0x0 0x40>;
                                        interrupt-parent = <&gic_r52>;
                                        interrupt-names = "PTM_MESSAGE";
                                        interrupts = <0x0 0xb9 0x4>;
                                };

                                gpu_mali: gpu@e0000 {
                                        phandle = <0x109>;
                                        compatible = "arm,mali-midgard";
                                        reg = <0x0 0xe0000 0x0 0x1ffc0>;
                                        interrupt-parent = <&gic_r52>;
                                        interrupt-names = "JOB", "MMU", "GPU";
                                        interrupts = <0x0 0xb9 0x4 0x0 0xb9 0x4 0x0 0xb9 0x4>;
                                        arbiter-if = <&gpu_aw_message_a_0>;
                                        reset-names = "gpu", "gpu_recov";
                                        system-coherency = <0x1f>;
                                        physical-memory-group-manager = <&gpu_physical_memory_group_manager>;

/dts-v1/;
/ {
        compatible = "xlnx,versal-vhk158-revA", "xlnx,versal-vhk158", "xlnx,versal";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        model = "Xilinx Versal vhk158 Eval board revA";
        board = "vhk158";
        vivado-version = "2026.2.0";
        device_id = "xcvh1582";
        slrcount = <0x2>;
        family = "Versal";
        speed_grade = "2MP";
        pruned-sdt = <0x1>;

        cpus_r5_0: cpus {
                phandle = <0xca>;
                #address-cells = <0x1>;
                #size-cells = <0x0>;

                psv_cortexr5_0: cpu@0 {
                        phandle = <0xcb>;
                        compatible = "arm,cortex-r5";
                        device_type = "cpu";
                        reg = <0x0>;
                };
        };

        amba: axi {
                phandle = <0x1>;
                compatible = "simple-bus";
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                interrupt-parent = <&gic_r5>;
                bootph-all;

                lpd_dma_chan0: dma-controller@ffa80000 {
                        phandle = <0x81>;
                        compatible = "xlnx,zynqmp-dma-1.0";
                        reg = <0x0 0xffa80000 0x0 0x1000>;
                        interrupts = <0x0 0x3c 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                lpd_dma_chan1: dma-controller@ffa90000 {
                        phandle = <0x82>;
                        compatible = "xlnx,zynqmp-dma-1.0";
                        reg = <0x0 0xffa90000 0x0 0x1000>;
                        interrupts = <0x0 0x3d 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                lpd_dma_chan2: dma-controller@ffaa0000 {
                        phandle = <0x83>;
                        compatible = "xlnx,zynqmp-dma-1.0";
                        reg = <0x0 0xffaa0000 0x0 0x1000>;
                        interrupts = <0x0 0x3e 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                lpd_dma_chan3: dma-controller@ffab0000 {
                        phandle = <0x84>;
                        compatible = "xlnx,zynqmp-dma-1.0";
                        reg = <0x0 0xffab0000 0x0 0x1000>;
                        interrupts = <0x0 0x3f 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                lpd_dma_chan4: dma-controller@ffac0000 {
                        phandle = <0x85>;
                        compatible = "xlnx,zynqmp-dma-1.0";
                        reg = <0x0 0xffac0000 0x0 0x1000>;
                        interrupts = <0x0 0x40 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                lpd_dma_chan5: dma-controller@ffad0000 {
                        phandle = <0x86>;
                        compatible = "xlnx,zynqmp-dma-1.0";
                        reg = <0x0 0xffad0000 0x0 0x1000>;
                        interrupts = <0x0 0x41 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                lpd_dma_chan6: dma-controller@ffae0000 {
                        phandle = <0x87>;
                        compatible = "xlnx,zynqmp-dma-1.0";
                        reg = <0x0 0xffae0000 0x0 0x1000>;
                        interrupts = <0x0 0x42 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                lpd_dma_chan7: dma-controller@ffaf0000 {
                        phandle = <0x88>;
                        compatible = "xlnx,zynqmp-dma-1.0";
                        reg = <0x0 0xffaf0000 0x0 0x1000>;
                        interrupts = <0x0 0x43 0x4 0xa0>;
                        clock-names = "clk_main", "clk_apb";
                        #dma-cells = <0x1>;
                        clocks = <&adma_ref_clk>, <&adma_ref_clk>;
                };

                gem0: ethernet@ff0c0000 {
                        phandle = <0x71>;
                        compatible = "xlnx,gem-controller";
                        status = "okay";
                        reg = <0x0 0xff0c0000 0x0 0x1000>;

                        gem0_mac: ethernet_mac {
                                compatible = "xlnx,gem";
                                status = "okay";
                                clock-frequency = <0x773545d>;
                                interrupts = <0x0 0x38 0x4 0xa0 0x0 0x38 0x4 0xa0>;
                                amba-ahb-burst-length = <0x10>;
                                hw-rx-buffer-size = <0x3>;
                                hw-rx-buffer-offset = <0x0>;
                                hw-tx-buffer-size-full;
                                rx-buffer-descriptors = <0x20>;
                                tx-buffer-descriptors = <0x20>;
                                rx-buffer-size = <0x600>;
                                tx-buffer-size = <0x600>;
                                discard-rx-fcs;
                                unicast-hash;
                                local-mac-address = [00 0A 35 00 01 02];
                        };
                };

                gpio1: gpio@f1020000 {
                        phandle = <0x34>;
                        compatible = "xlnx,ps-gpio";
                        reg = <0x0 0xf1020000 0x0 0x1000>;
                        interrupts = <0x0 0x7a 0x4 0xa0>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;

                        gpio1_bank0: gpio1_bank@0 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x0>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x1a>;
                        };

                        gpio1_bank1: gpio1_bank@1 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x1>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x1a>;
                        };

                        gpio1_bank3: gpio1_bank@3 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x3>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x20>;
                        };

                        gpio1_bank4: gpio1_bank@4 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x4>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x20>;
                        };

                        gpio1_bank2: gpio1_bank@2 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x2>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x1a>;
                        };

                        gpio1_bank5: gpio1_bank@5 {
                                compatible = "xlnx,ps-gpio-bank";
                                reg = <0x5>;
                                #gpio-cells = <0x2>;
                                gpio-controller;
                                ngpios = <0x20>;
                        };
                };

                i2c0: i2c@ff020000 {
                        phandle = <0x6d>;
                        compatible = "cdns,i2c";
                        status = "okay";
                        reg = <0x0 0xff020000 0x0 0x1000>;
                        interrupts = <0x0 0xe 0x4 0xa0>;
                        interrupt-parent = <&gic_r5>;
                        clock-frequency = <0x186a0>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;
                        fifo-depth = <0x10>;
                        clocks = <&i2c0_ref_clock>;
                };

                i2c1: i2c@ff030000 {
                        phandle = <0x6e>;
                        compatible = "cdns,i2c";
                        status = "okay";
                        reg = <0x0 0xff030000 0x0 0x1000>;
                        interrupts = <0x0 0xf 0x4 0xa0>;
                        interrupt-parent = <&gic_r5>;
                        clock-frequency = <0x186a0>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;
                        fifo-depth = <0x10>;
                        clocks = <&i2c1_ref_clock>;
                };

                rtc: rtc@f12a0000 {
                        phandle = <0x46>;
                        compatible = "xlnx,zynqmp-rtc";
                        status = "okay";
                        reg = <0x0 0xf12a0000 0x0 0x100>;
                        interrupt-names = "alarm", "sec";
                        interrupts = <0x0 0x8e 0x4 0xa0 0x0 0x8f 0x4 0xa0>;
                        interrupt-parent = <&gic_r5>;
                        clock-frequency = <0x8000>;

                        rtc-counter {
                                compatible = "zephyr,rtc-counter";
                                status = "okay";
                                alarms-count = <0x1>;
                        };
                };

                sdhci1: mmc@f1050000 {
                        phandle = <0x35>;
                        compatible = "xlnx,versal-8.9a";
                        reg = <0x0 0xf1050000 0x0 0x10000>;
                        interrupts = <0x0 0x80 0x4 0xa0>;
                        power-delay-ms = <0xa>;
                        clocks = <&sdhci1_ref_clock>;

                        sdmmc {
                                compatible = "zephyr,sdmmc-disk";
                                disk-name = "SD";
                        };
                };

                serial0: serial@ff000000 {
                        phandle = <0x6c>;
                        compatible = "arm,sbsa-uart";
                        status = "okay";
                        reg = <0x0 0xff000000 0x0 0x1000>;
                        interrupts = <0x0 0x12 0x4 0xa0>;
                        interrupt-parent = <&gic_r5>;
                        interrupt-names = "serial0";
                };

                ospi: spi@f1010000 {
                        phandle = <0x33>;
                        compatible = "xlnx,versal-ospi-1.0";
                        status = "okay";
                        reg = <0x0 0xf1010000 0x0 0x10000 0x0 0xc0000000 0x0 0x20000000>;
                        interrupts = <0x0 0x7c 0x4 0xa0>;
                        interrupt-parent = <&gic_r5>;
                        cdns,fifo-depth = <0x100>;
                        cdns,fifo-width = <0x4>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;
                        clock-frequency = <0xbebba31>;
                };

                ttc0: timer@ff0e0000 {
                        phandle = <0x72>;
                        compatible = "xlnx,ttcps";
                        status = "okay";
                        interrupts = <0x0 0x25 0x4 0xa0 0x0 0x26 0x4 0xa0 0x0 0x27 0x4 0xa0>;
                        reg = <0x0 0xff0e0000 0x0 0x1000>;
                        interrupt-names = "irq_0", "irq_1", "irq_2";
                        clock-frequency = <0x8f0d180>;
                };

                ttc1: timer@ff0f0000 {
                        phandle = <0x73>;
                        compatible = "xlnx,ttcps";
                        status = "okay";
                        interrupts = <0x0 0x28 0x4 0xa0 0x0 0x29 0x4 0xa0 0x0 0x2a 0x4 0xa0>;
                        reg = <0x0 0xff0f0000 0x0 0x1000>;
                        interrupt-names = "irq_0", "irq_1", "irq_2";
                        clock-frequency = <0x8f0d180>;
                };

                ttc3: timer@ff110000 {
                        phandle = <0x75>;
                        compatible = "xlnx,ttcps";
                        status = "okay";
                        interrupts = <0x0 0x2e 0x4 0xa0 0x0 0x2f 0x4 0xa0 0x0 0x30 0x4 0xa0>;
                        reg = <0x0 0xff110000 0x0 0x1000>;
                        interrupt-names = "irq_0", "irq_1", "irq_2";
                        clock-frequency = <0x8f0d180>;
                };

                ipi1: mailbox@ff340000 {
                        phandle = <0x9c>;
                        compatible = "xlnx,mbox-versal-ipi-mailbox";
                        interrupt-parent = <&gic_r5>;
                        interrupts = <0x0 0x1f 0x4 0xa0>;
                        reg = <0x0 0xff340000 0x0 0x10000 0x0 0xff3f0600 0x0 0x200>;
                        xlnx,ipi-id = <0x3>;
                        #address-cells = <0x2>;
                        #size-cells = <0x2>;
                        reg-names = "ctrl", "msg";

                        ipi_1_to_ipi_0: child@ff330000 {
                                phandle = <0x11a>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x2>;
                                reg = <0x0 0xff330000 0x0 0x10000 0x0 0xff3f0400 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_1: child@ff340000 {
                                phandle = <0x11b>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x3>;
                                reg = <0x0 0xff340000 0x0 0x10000 0x0 0xff3f0600 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_2: child@ff350000 {
                                phandle = <0x11c>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x4>;
                                reg = <0x0 0xff350000 0x0 0x10000 0x0 0xff3f0800 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_3: child@ff360000 {
                                phandle = <0x11d>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x5>;
                                reg = <0x0 0xff360000 0x0 0x10000 0x0 0xff3f0a00 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_4: child@ff370000 {
                                phandle = <0x11e>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x6>;
                                reg = <0x0 0xff370000 0x0 0x10000 0x0 0xff3f0c00 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_5: child@ff380000 {
                                phandle = <0x11f>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x7>;
                                reg = <0x0 0xff380000 0x0 0x10000 0x0 0xff3f0e00 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_6: child@ff3a0000 {
                                phandle = <0x120>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x9>;
                                reg = <0x0 0xff3a0000 0x0 0x10000>;
                                reg-names = "ctrl";
                        };

                        ipi_1_to_ipi_pmc: child@ff320000 {
                                phandle = <0x121>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x1>;
                                reg = <0x0 0xff320000 0x0 0x10000 0x0 0xff3f0200 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };

                        ipi_1_to_ipi_pmc_nobuf: child@ff390000 {
                                phandle = <0x122>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x8>;
                                reg = <0x0 0xff390000 0x0 0x10000>;
                                reg-names = "ctrl";
                        };

                        ipi_1_to_ipi_psm: child@ff310000 {
                                phandle = <0x123>;
                                compatible = "xlnx,mbox-versal-ipi-dest-mailbox";
                                #mbox-cells = <0x1>;
                                xlnx,ipi-id = <0x0>;
                                reg = <0x0 0xff310000 0x0 0x10000 0x0 0xff3f0000 0x0 0x200>;
                                reg-names = "ctrl", "msg";
                        };
                };

                CIPS_0_pspmc_0_psv_r5_0_atcm: CIPS_0_pspmc_0_psv_r5_0_atcm@0 {
                        phandle = <0x9d>;
                        compatible = "zephyr,memory-region", "xlnx,psv-r5-tcm-1.0";
                        status = "okay";
                        reg = <0x0 0x0 0x0 0x10000>;
                        zephyr,memory-region = "CIPS_0_PSPMC_0_PSV_R5_0_ATCM";
                };

                CIPS_0_pspmc_0_psv_r5_0_btcm: CIPS_0_pspmc_0_psv_r5_0_btcm@20000 {
                        phandle = <0x9f>;
                        compatible = "zephyr,memory-region", "xlnx,psv-r5-tcm-1.0";
                        status = "okay";
                        reg = <0x0 0x20000 0x0 0x10000>;
                        zephyr,memory-region = "CIPS_0_PSPMC_0_PSV_R5_0_BTCM";
                        zephyr,memory-attr = <0x100000>;
                };

                gic_r5: interrupt-controller@f9000000  {
                        phandle = <0xa0>;
                        reg = <0x0 0xf9000000 0x0 0x1000 0x0 0xf9001000 0x0 0x1000>;
                        status = "okay";
                        interrupt-controller;
                        #interrupt-cells = <0x4>;
                        compatible = "arm,gic-v1", "arm,gic";
                };
        };

        amba_pl: amba_pl {
                phandle = <0x181>;
                ranges;
                compatible = "simple-bus";
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                firmware-name = "vhk158_base_pld.pdi";

                misc_clk_0: misc_clk_0 {
                        phandle = <0xc4>;
                        compatible = "fixed-clock";
                        clock-frequency = <0x5f5dd18>;
                        #clock-cells = <0x0>;
                };

                axi_gpio_0: gpio@a6010000 {
                        phandle = <0xf>;
                        compatible = "xlnx,xps-gpio-1.00.a";
                        xlnx,all-outputs = <0x1>;
                        #gpio-cells = <0x2>;
                        xlnx,gpio-width = <0x4>;
                        xlnx,dout-default = <0x0>;
                        xlnx,is-dual = <0x0>;
                        xlnx,tri-default-2 = <0xffffffff>;
                        reg = <0x0 0xa6010000 0x0 0x10000>;
                        xlnx,all-inputs-2 = <0x0>;
                        xlnx,all-outputs-2 = <0x0>;
                        gpio-controller;
                        xlnx,dout-default-2 = <0x0>;
                        xlnx,gpio2-width = <0x20>;
                        xlnx,tri-default = <0xffffffff>;
                        xlnx,all-inputs = <0x0>;
                };

                axi_gpio_1: gpio@a6020000 {
                        phandle = <0x10>;
                        compatible = "xlnx,xps-gpio-1.00.a";
                        xlnx,all-outputs = <0x0>;
                        #gpio-cells = <0x2>;
                        xlnx,gpio-width = <0x2>;
                        xlnx,dout-default = <0x0>;
                        xlnx,is-dual = <0x0>;
                        xlnx,tri-default-2 = <0xffffffff>;
                        reg = <0x0 0xa6020000 0x0 0x10000>;
                        xlnx,all-inputs-2 = <0x0>;
                        xlnx,all-outputs-2 = <0x0>;
                        gpio-controller;
                        xlnx,dout-default-2 = <0x0>;
                        xlnx,gpio2-width = <0x20>;
                        xlnx,tri-default = <0xffffffff>;
                        xlnx,all-inputs = <0x1>;
                };

                axi_gpio_2: gpio@a6030000 {
                        phandle = <0x11>;
                        compatible = "xlnx,xps-gpio-1.00.a";
                        xlnx,all-outputs = <0x0>;
                        #gpio-cells = <0x2>;
                        xlnx,gpio-width = <0x4>;
                        xlnx,dout-default = <0x0>;
                        xlnx,is-dual = <0x0>;
                        xlnx,tri-default-2 = <0xffffffff>;
                        reg = <0x0 0xa6030000 0x0 0x10000>;
                        xlnx,all-inputs-2 = <0x0>;
                        xlnx,all-outputs-2 = <0x0>;
                        gpio-controller;
                        xlnx,dout-default-2 = <0x0>;
                        xlnx,gpio2-width = <0x20>;
                        xlnx,tri-default = <0xffffffff>;
                        xlnx,all-inputs = <0x1>;
                };

                axi_uart16550_0: serial@a6000000 {
                        phandle = <0xe>;
                        compatible = "ns16550";
                        reg = <0x0 0xa6000000 0x0 0x10000>;
                        clock-frequency = <0x5f5dd18>;
                        reg-shift = <0x2>;
                        current-speed = <0x2580>;
                };
        };

        axi_bram_ctrl_0_memory: memory@a4000000 {
                phandle = <0x3>;
                compatible = "xlnx,axi-bram-ctrl-4.1";
                #address-cells = <0x2>;
                xlnx,ip-name = "axi_bram_ctrl";
                device_type = "memory";
                #size-cells = <0x2>;
                memory_type = "memory";
                reg = <0x0 0xa4000000 0x0 0x2000>;
        };

        chosen {
                zephyr,ram-console = "/reserved-memory/trace@985f000";
                stdout-path = "serial0:115200";
                bootargs = "console=ttyAMA0 earlycon=pl011,mmio32,0xFF000000,115200n8 clk_ignore_unused";
                zephyr,ipc_shm = "/reserved-memory/ipc@9880000";
                zephyr,ipc = "/mbox_ipi_ff360000_ff340000";
                zephyr,sram = "/axi/CIPS_0_pspmc_0_psv_r5_0_atcm@0";
                zephyr,console = "serial0";
                zephyr,shell-uart = "serial0";
        };

        aliases {
                serial0 = "/axi/serial@ff000000";
                spi0 = "/axi/spi@f1010000";
                serial1 = "/amba_pl/serial@a6000000";
                i2c0 = "/axi/i2c@ff020000";
                i2c1 = "/axi/i2c@ff030000";
                ethernet0 = "/axi/ethernet@ff0c0000";
                mmc0 = "/axi/mmc@f1050000";
                rtc0 = "/axi/rtc@f12a0000";
                rtc = "/axi/rtc@f12a0000/rtc-counter";
        };

        reserved-memory {
                ranges;
                #size-cells = <0x2>;
                #address-cells = <0x2>;

                trace_buffer: trace@985f000 {
                        phandle = <0x186>;
                        reg = <0x0 0x985f000 0x0 0x1000>;
                        compatible = "zephyr,memory-region";
                        zephyr,memory-region = "TRACE_BUFFER";
                        zephyr,memory-attr = <0x200000>;
                };

                rproc0: rproc0@9800000 {
                        phandle = <0x185>;
                        reg = <0x0 0x9800000 0x0 0x20000>;
                        compatible = "zephyr,memory-region";
                        zephyr,memory-region = "RPROC0";
                };

                rsctbl: rsctbl@9820000 {
                        phandle = <0x187>;
                        reg = <0x0 0x9820000 0x0 0x100>;
                        compatible = "zephyr,memory-region";
                        zephyr,memory-region = "RSCTBL";
                        zephyr,memory-attr = <0x200000>;
                };

                libmetal_elf: libmetal_elf@9968000 {
                        phandle = <0x18e>;
                        label = "libmetal_elf";
                        no-map;
                        reg = <0x0 0x9968000 0x0 0x60000>;
                };

                libmetal_desc0: libmetal_desc0@99c8000 {
                        phandle = <0x18f>;
                        label = "libmetal_desc0";
                        no-map;
                        reg = <0x0 0x99c8000 0x0 0x4000>;
                };

                libmetal_desc1: libmetal_desc1@99cc000 {
                        phandle = <0x190>;
                        label = "libmetal_desc1";
                        no-map;
                        reg = <0x0 0x99cc000 0x0 0x4000>;
                };

                libmetal_data: libmetal_data@99d0000 {
                        phandle = <0x191>;
                        label = "libmetal_data";
                        no-map;
                        reg = <0x0 0x99d0000 0x0 0x40000>;
                };

                ipc_shm: ipc@9880000 {
                        phandle = <0x192>;
                        reg = <0x0 0x9880000 0x0 0x80000>;
                        compatible = "zephyr,memory-region", "mmio-sram";
                        status = "okay";
                        zephyr,memory-region = "IPC_SHM";
                        zephyr,memory-attr = <0x200000>;
                };
        };

        mbox-consumer {
                compatible = "vnd,mbox-consumer";
                mboxes = <&ipi_1_to_ipi_3 0x0>,
                 <&ipi_1_to_ipi_3 0x1>;
                mbox-names = "tx", "rx";
        };

        mbox_ipi_ff360000_ff340000 {
                compatible = "zephyr,mbox-ipm";
                mbox-names = "tx", "rx";
                status = "okay";
                mboxes = <&ipi_1_to_ipi_3 0x0>,
                 <&ipi_1_to_ipi_3 0x1>;
        };

        noc_ddr0_ddr_memory: memory@40000 {
                phandle = <0x5>;
                compatible = "xlnx,axi-noc-1.1";
                xlnx,ip-name = "axi_noc";
                device_type = "memory";
                reg = <0x0 0x40000 0x0 0x7ffc0000>;
                memory_type = "memory";
        };

        CIPS_0_pspmc_0_psv_ocm_ram_0_memory: memory@fffc0000 {
                phandle = <0xd>;
                compatible = "xlnx,psv-ocm-ram-0-1.0", "mmio-sram";
                reg = <0x0 0xfffc0000 0x0 0x40000>;
        };

        adma_ref_clk: adma_ref_clk {
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x1ad27480>;
        };

        i2c0_ref_clock: i2c0_ref_clock {
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x5f5dd19>;
        };

        i2c1_ref_clock: i2c1_ref_clock {
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x5f5dd19>;
        };

        sdhci1_ref_clock: sdhci1_ref_clock {
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0xbebba31>;
        };
};

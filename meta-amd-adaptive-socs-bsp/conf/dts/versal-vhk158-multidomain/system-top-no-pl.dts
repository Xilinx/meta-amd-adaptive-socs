/dts-v1/;
/ {
        speed_grade = "2MP";
        family = "Versal";
        slrcount = <0x2>;
        device_id = "xcvh1582";
        vivado-version = "2026.2.0";
        board = "vhk158";
        model = "Xilinx Versal vhk158 Eval board revA";
        #size-cells = <0x2>;
        #address-cells = <0x2>;
        compatible = "xlnx,versal-vhk158-revA", "xlnx,versal-vhk158", "xlnx,versal";

        options {

                u-boot {
                        bootscr-address = /bits/ 64 <0x20000000>;
                        compatible = "u-boot,config";
                };
        };

        cpus_a72: cpus-a72@0 {
                phandle = <0xc6>;
                #ranges-size-cells = <0x2>;

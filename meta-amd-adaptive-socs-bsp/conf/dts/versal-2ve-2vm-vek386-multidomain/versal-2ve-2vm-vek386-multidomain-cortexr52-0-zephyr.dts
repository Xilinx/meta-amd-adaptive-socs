                        phandle = <0x2b0>;
                        reg = <0x0 0x9880000 0x0 0x80000>;
                        compatible = "mmio-sram";
                        status = "okay";
                };
        };

        chosen {
                zephyr,ram-console = "/reserved-memory/trace@985f000";
                stdout-path = "serial0:115200n8";
                bootargs = "console=ttyAMA0,115200";
                zephyr,console = "serial0";
                zephyr,shell-uart = "serial0";
                zephyr,ipc_shm = "/reserved-memory/ipc@9880000";
                zephyr,sram = "/axi/r52_0a_atcm_global@0";
                zephyr,ipc = "/mbox_ipi_eb3b0000_eb3b1000";
        };


/dts-v1/;
/ {
        speed_grade = "2MP";
        family = "Versal_2VE_2VM";
        slrcount = <0x1>;
        xlnx,ddrmc5-i2c-master = "PMC";
        xlnx,ddrmc5-debug-elf = "false";
        device_id = "xc2ve3858";
        vivado-version = "2026.2";
        board = "vek386";
        interrupt-parent = <&gic>;
        #size-cells = <0x2>;
        #address-cells = <0x2>;
        model = "AMD Versal VEK385 revB";
        compatible = "amd,versal2-vek385-revB", "amd,versal2-vek385", "amd,versal2";

        options {

                u-boot {
                        bootscr-address = /bits/ 64 <0x78000000>;
                        compatible = "u-boot,config";
                };
        };

        cpus_a78: cpus {
                phandle = <0x139>;
                #ranges-size-cells = <0x2>;
                #ranges-address-cells = <0x2>;
                compatible = "cpus,cluster";
                #size-cells = <0x0>;
                #address-cells = <0x1>;

                cpu-map {

                        cluster0 {

                                core0 {
                                        cpu = <&cortexa78_0>;
                                };

                                core1 {
                                        cpu = <&cortexa78_1>;
                                };
                        };

                        cluster1 {

                                core0 {
                                        cpu = <&cortexa78_2>;
                                };

                                core1 {
                                        cpu = <&cortexa78_3>;
                                };
                        };

                        cluster2 {

                                core0 {
                                        cpu = <&cortexa78_4>;
                                };

                                core1 {
                                        cpu = <&cortexa78_5>;
                                };
                        };

                        cluster3 {

                                core0 {
                                        cpu = <&cortexa78_6>;
                                };

                                core1 {
                                        cpu = <&cortexa78_7>;
                                };
                        };
                };

                cortexa78_0: cpu@0 {
                        phandle = <0xd0>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x6f42c98d>;
                        xlnx,cpu-clk-freq-hz = <0x6f42c98d>;
                        xlnx,cluster-number = <0x0>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&scmi_clk 0x43>;
                        next-level-cache = <&l2_00>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        reg = <0x0>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_00: l2-cache {
                                phandle = <0xd8>;
                                next-level-cache = <&l3_0>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_1: cpu@100 {
                        phandle = <0xd1>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x6f42c98d>;
                        xlnx,cpu-clk-freq-hz = <0x6f42c98d>;
                        xlnx,cluster-number = <0x0>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&scmi_clk 0x43>;
                        next-level-cache = <&l2_00>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        reg = <0x100>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_01: l2-cache {
                                phandle = <0x13a>;
                                next-level-cache = <&l3_0>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_2: cpu@10000 {
                        phandle = <0xd2>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x6f42c98d>;
                        xlnx,cpu-clk-freq-hz = <0x6f42c98d>;
                        xlnx,cluster-number = <0x1>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&scmi_clk 0x46>;
                        next-level-cache = <&l2_10>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        reg = <0x10000>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_10: l2-cache {
                                phandle = <0xdb>;
                                next-level-cache = <&l3_1>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_3: cpu@10100 {
                        phandle = <0xd3>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x6f42c98d>;
                        xlnx,cpu-clk-freq-hz = <0x6f42c98d>;
                        xlnx,cluster-number = <0x1>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&scmi_clk 0x46>;
                        next-level-cache = <&l2_10>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        reg = <0x10100>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_11: l2-cache {
                                phandle = <0x13b>;
                                next-level-cache = <&l3_1>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_4: cpu@20000 {
                        phandle = <0xd4>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x6f42c98d>;
                        xlnx,cpu-clk-freq-hz = <0x6f42c98d>;
                        xlnx,cluster-number = <0x2>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&scmi_clk 0x45>;
                        next-level-cache = <&l2_20>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        reg = <0x20000>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_20: l2-cache {
                                phandle = <0xdd>;
                                next-level-cache = <&l3_2>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_5: cpu@20100 {
                        phandle = <0xd5>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x6f42c98d>;
                        xlnx,cpu-clk-freq-hz = <0x6f42c98d>;
                        xlnx,cluster-number = <0x2>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&scmi_clk 0x45>;
                        next-level-cache = <&l2_20>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        reg = <0x20100>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_21: l2-cache {
                                phandle = <0x13c>;
                                next-level-cache = <&l3_2>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_6: cpu@30000 {
                        phandle = <0xd6>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x6f42c98d>;
                        xlnx,cpu-clk-freq-hz = <0x6f42c98d>;
                        xlnx,cluster-number = <0x3>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&scmi_clk 0x44>;
                        next-level-cache = <&l2_30>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        reg = <0x30000>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_30: l2-cache {
                                phandle = <0xdf>;
                                next-level-cache = <&l3_3>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                cortexa78_7: cpu@30100 {
                        phandle = <0xd7>;
                        bus-handle = <0x2>;
                        cpu-frequency = <0x6f42c98d>;
                        xlnx,cpu-clk-freq-hz = <0x6f42c98d>;
                        xlnx,cluster-number = <0x3>;
                        xlnx,ip-name = "cortexa78";
                        stamp-frequency = <0x5f5dd19>;
                        xlnx,pss-ref-clk-freq = <0x1fc9f08>;
                        xlnx,timestamp-clk-freq = <0x5f5dd19>;
                        clocks = <&scmi_clk 0x44>;
                        next-level-cache = <&l2_30>;
                        i-cache-sets = <0x100>;
                        i-cache-line-size = <0x40>;
                        i-cache-size = <0x10000>;
                        d-cache-sets = <0x100>;
                        d-cache-line-size = <0x40>;
                        d-cache-size = <0x10000>;
                        reg = <0x30100>;
                        enable-method = "psci";
                        device_type = "cpu";
                        compatible = "arm,cortex-a78";

                        l2_31: l2-cache {
                                phandle = <0x13d>;
                                next-level-cache = <&l3_3>;
                                cache-unified;
                                cache-sets = <0x400>;
                                cache-line-size = <0x40>;
                                cache-size = <0x80000>;
                                cache-level = <0x2>;
                                compatible = "cache";
                        };
                };

                l3_0: l3-0-cache {
                        phandle = <0xda>;
                        next-level-cache = <&llc>;
                        cache-unified;
                        cache-sets = <0x400>;
                        cache-line-size = <0x40>;
                        cache-size = <0x100000>;
                        cache-level = <0x3>;
                        compatible = "cache";
                };

                l3_1: l3-1-cache {
                        phandle = <0xdc>;
                        next-level-cache = <&llc>;
                        cache-unified;
                        cache-sets = <0x400>;
                        cache-line-size = <0x40>;
                        cache-size = <0x100000>;
                        cache-level = <0x3>;
                        compatible = "cache";
                };

                l3_2: l3-2-cache {
                        phandle = <0xde>;
                        next-level-cache = <&llc>;
                        cache-unified;
                        cache-sets = <0x400>;
                        cache-line-size = <0x40>;
                        cache-size = <0x100000>;
                        cache-level = <0x3>;
                        compatible = "cache";
                };

                l3_3: l3-3-cache {
                        phandle = <0xe0>;
                        next-level-cache = <&llc>;
                        cache-unified;
                        cache-sets = <0x400>;
                        cache-line-size = <0x40>;
                        cache-size = <0x100000>;
                        cache-level = <0x3>;
                        compatible = "cache";
                };

                llc: l4-cache {
                        phandle = <0xe1>;
                        cache-unified;
                        cache-size = <0x400000>;
                        cache-level = <0x4>;
                        compatible = "cache";
                };
        };

        cpu_opp_table: opp-table {
                phandle = <0x13e>;
                compatible = "operating-points-v2";

                opp-1867000000 {
                        opp-microvolt = <0xf4240>;
                        clock-latency-ns = <0x7a120>;
                        opp-hz = /bits/ 64 <0x6f4828c0>;
                };

                opp-933500000 {
                        opp-microvolt = <0xf4240>;
                        clock-latency-ns = <0x7a120>;
                        opp-hz = /bits/ 64 <0x37a41460>;
                };

                opp-622333333 {
                        opp-microvolt = <0xf4240>;
                        clock-latency-ns = <0x7a120>;
                        opp-hz = /bits/ 64 <0x25180d95>;
                };

                opp-466750000 {
                        opp-microvolt = <0xf4240>;
                        clock-latency-ns = <0x7a120>;
                        opp-hz = /bits/ 64 <0x1bd20a30>;
                };
        };

        aliases {
                nvmem0 = "/axi/i2c@f1950000/i2c-arbitrator@72/i2c-arb/eeprom@54";
                ethernet0 = "/axi/ethernet@f1a60000";
                serial2 = "/axi/coresight@f0800000";
                spi3 = "/axi/spi@f19d0000";
                spi2 = "/axi/spi@f19c0000";
                spi1 = "/axi/spi@f1030000";
                spi0 = "/axi/spi@f1010000";
                i2c8 = "/axi/i2c@f1000000";
                i2c7 = "/axi/i2c@f19b0000";
                i2c6 = "/axi/i2c@f19a0000";
                i2c5 = "/axi/i2c@f1990000";
                i2c4 = "/axi/i2c@f1980000";
                i2c3 = "/axi/i2c@f1970000";
                i2c2 = "/axi/i2c@f1950000";
                i2c1 = "/axi/i2c@f1940000";
                mmc1 = "/axi/mmc@f1050000";
                mmc0 = "/axi/mmc@f1040000";
                serial1 = "/axi/serial@f1930000";
                serial0 = "/axi/serial@f1920000";
                nvmem1 = "/axi/i2c@f1950000/i2c-arbitrator@72/i2c-arb/eeprom@54";
        };

        firmware {

                psci: psci {
                        phandle = <0x14d>;
                        method = "smc";
                        compatible = "arm,psci-1.0";
                };

                scmi: scmi {
                        phandle = <0x14e>;
                        bootph-all;
                        shmem = <0x111>;
                        #size-cells = <0x0>;
                        #address-cells = <0x1>;
                        arm,smc-id = <0xc2002001>;
                        compatible = "arm,scmi-smc";

                        scmi_reset: protocol@16 {
                                phandle = <0x11c>;
                                #reset-cells = <0x1>;
                                reg = <0x16>;
                        };

                        scmi_devpd: protocol@11 {
                                phandle = <0xe8>;
                                #power-domain-cells = <0x1>;
                                reg = <0x11>;
                        };

                        scmi_clk: protocol@14 {
                                phandle = <0xd9>;
                                #clock-cells = <0x1>;
                                reg = <0x14>;
                        };
                };

                versal2_firmware: versal2-firmware {
                        phandle = <0x14f>;
                        #power-domain-cells = <0x1>;
                        method = "smc";
                        bootph-all;
                        compatible = "xlnx,versal2-firmware";

                        versal_sec_cfg: versal-sec-cfg {
                                phandle = <0x150>;
                                compatible = "xlnx,versal-sec-cfg";

                                nvmem-layout {
                                        #size-cells = <0x1>;
                                        #address-cells = <0x1>;
                                        compatible = "fixed-layout";

                                        bbram_zeroize: bbram-zeroize@4 {
                                                phandle = <0x151>;
                                                reg = <0x4 0x4>;
                                        };

                                        bbram_key: bbram-key@10 {
                                                phandle = <0x152>;
                                                reg = <0x10 0x20>;
                                        };

                                        bbram_usr: bbram-usr@30 {
                                                phandle = <0x153>;
                                                reg = <0x30 0x4>;
                                        };

                                        bbram_lock: bbram-lock@48 {
                                                phandle = <0x154>;
                                                reg = <0x48 0x4>;
                                        };

                                        user_key0: user-key@110 {
                                                phandle = <0x155>;
                                                reg = <0x110 0x20>;
                                        };

                                        user_key1: user-key@130 {
                                                phandle = <0x156>;
                                                reg = <0x130 0x20>;
                                        };

                                        user_key2: user-key@150 {
                                                phandle = <0x157>;
                                                reg = <0x150 0x20>;
                                        };

                                        user_key3: user-key@170 {
                                                phandle = <0x158>;
                                                reg = <0x170 0x20>;
                                        };

                                        user_key4: user-key@190 {
                                                phandle = <0x159>;
                                                reg = <0x190 0x20>;
                                        };

                                        user_key5: user-key@1b0 {
                                                phandle = <0x15a>;
                                                reg = <0x1b0 0x20>;
                                        };

                                        user_key6: user-key@1d0 {
                                                phandle = <0x15b>;
                                                reg = <0x1d0 0x20>;
                                        };

                                        user_key7: user-key@1f0 {
                                                phandle = <0x15c>;
                                                reg = <0x1f0 0x20>;
                                        };
                                };
                        };
                };

                fwu-mdata {
                        compatible = "u-boot,fwu-mdata-mtd";
                        fwu-mdata-store = <&spi_flash>;
                        mdata-parts = "SystemReady-DT Update Metadata", "SystemReady-DT Update Metadata Backup";

                        fwu-bank0 {
                                id = <0x0>;
                                label = "Bank A Space";

                                fwu-image0 {
                                        id = <0x0>;
                                        offset = <0x0>;
                                        size = <0x7200000>;
                                        uuid = "0b931b7e-b2f6-11ef-8565-eb65d140066b";
                                };
                        };

                        fwu-bank1 {
                                id = <0x1>;
                                label = "Bank B Space";

                                fwu-image0 {
                                        id = <0x0>;
                                        offset = <0x0>;
                                        size = <0x7200000>;
                                        uuid = "1243d800-b2f6-11ef-8f4f-8bddc3aa326d";
                                };
                        };
                };
        };

        fpga: fpga-region {
                phandle = <0x15d>;
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                fpga-mgr = <&versal_fpga>;
                compatible = "fpga-region";
        };

        pmu: pmu {
                phandle = <0x2a5>;
                interrupts = <0x1 0x7 0x4>;
                compatible = "arm,cortex-a78-pmu";
        };

        timer: timer {
                phandle = <0x15e>;
                interrupts = <0x1 0xd 0x4 0x1 0xe 0x4 0x1 0xb 0x4 0x1 0xa 0x4>;
                compatible = "arm,armv8-timer";
        };

        versal_fpga: versal-fpga {
                phandle = <0x112>;
                compatible = "xlnx,versal-fpga";
        };

        sensor0: versal-thermal-sensor {
                phandle = <0x113>;
                io-channel-names = "sysmon-temp-channel", "aie-temp-ch1", "aie-temp-ch2", "aie-temp-ch3", "aie-temp-ch4", "aie-temp-ch5", "aie-temp-ch6", "aie-temp-ch7", "aie-temp-ch8";
                io-channels = <&sysmon0 0x12>,
                 <&sysmon0 0xa>,
                 <&sysmon0 0xb>,
                 <&sysmon0 0xc>,
                 <&sysmon0 0xd>,
                 <&sysmon0 0xe>,
                 <&sysmon0 0xf>,
                 <&sysmon0 0x10>,
                 <&sysmon0 0x11>;
                #thermal-sensor-cells = <0x1>;
                compatible = "xlnx,versal-thermal";
        };

        thermal-zones {

                versal_thermal: versal-thermal {
                        phandle = <0x15f>;
                        thermal-sensors = <&sensor0 0x0>;
                        polling-delay = <0x3e8>;
                        polling-delay-passive = <0xfa>;

                        trips {

                                temp_alert: temp-alert {
                                        phandle = <0x160>;
                                        type = "passive";
                                        hysteresis = <0x0>;
                                        temperature = <0x11170>;
                                };

                                ot_crit: ot-crit {
                                        phandle = <0x161>;
                                        type = "critical";
                                        hysteresis = <0x0>;
                                        temperature = <0x1e848>;
                                };
                        };

                        cooling-maps {
                        };
                };

                versal_thermal_aie: versal-aie-thermal {
                        phandle = <0x162>;
                        thermal-sensors = <&sensor0 0x1>;
                        polling-delay = <0x3e8>;
                        polling-delay-passive = <0xfa>;

                        trips {

                                temp_alert_aie: temp-alert-aie {
                                        phandle = <0x163>;
                                        type = "passive";
                                        hysteresis = <0x0>;
                                        temperature = <0x11170>;
                                };

                                ot_crit_aie: ot-crit-aie {
                                        phandle = <0x164>;
                                        type = "critical";
                                        hysteresis = <0x0>;
                                        temperature = <0x1e848>;
                                };
                        };

                        cooling-maps {
                        };
                };
        };

        amba: axi {
                phandle = <0x2>;
                interrupt-parent = <&gic>;
                ranges;
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                bootph-all;
                compatible = "simple-bus";

                mmi_gpu_slcred720000: mmi_gpu_slcr@ed720000 {
                        phandle = <0x2a9>;
                        no-map;
                        reg = <0x0 0xed720000 0x0 0x20000>;

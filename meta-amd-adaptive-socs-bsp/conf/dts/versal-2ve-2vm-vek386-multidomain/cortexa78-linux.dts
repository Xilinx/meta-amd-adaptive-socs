                };
        };

        ref_clk: ref-clk {
                phandle = <0x29f>;
                clock-output-names = "board_ref_clk";
                clock-frequency = <0x1fca055>;
                #clock-cells = <0x0>;
                compatible = "fixed-clock";
                bootph-all;
        };

        rtc_clk: rtc-clk {
                phandle = <0x12c>;

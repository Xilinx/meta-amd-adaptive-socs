                ospi: spi@f1010000 {
                        phandle = <0x88>;
                        #size-cells = <0x0>;
                        #address-cells = <0x1>;
                        is-dual = <0x0>;
                        xlnx,clock-freq = <0xbebba31>;
                        xlnx,ospi-bus-width = <0x8>;
                        xlnx,ospi-mode = <0x0>;
                        is-stacked = <0x0>;
                        xlnx,coherency = <0x0>;
                        xlnx,ip-name = "pmc_ospi";
                        xlnx,route-through-fpd = <0x0>;
                        xlnx,ospi-clk-freq-hz = <0xbebba31>;
                        xlnx,is-cache-coherent = <0x0>;
                        resets = <&scmi_reset 0x1>;
                        power-domains = <&scmi_devpd 0x1b>;
                        clocks = <&scmi_clk 0x1c>;
                        reset-names = "qspi";
                        clock-names = "ref";
                        cdns,trigger-address = <0xc0000000>;
                        cdns,is-dma = <0x1>;
                        cdns,fifo-width = <0x4>;
                        cdns,fifo-depth = <0x100>;
                        interrupts = <0x0 0xd8 0x4>;
                        interrupt-parent = <&gic>;
                        reg = <0x0 0xf1010000 0x0 0x10000 0x0 0xc0000000 0x0 0x20000000>;
                        status = "okay";
                        compatible = "amd,versal2-ospi", "cdns,qspi-nor";
                        iommus = <&smmu 0x245>;

                        spi_flash: flash@0 {
                                phandle = <0x17e>;
                                no-wp;
                                reg = <0x0>;
                                cdns,read-delay = <0x0>;
                                cdns,tshsl-ns = <0x0>;
                                cdns,tsd2d-ns = <0x0>;
                                cdns,tchsh-ns = <0x1>;
                                cdns,tslch-ns = <0x1>;
                                spi-tx-bus-width = <0x8>;
                                spi-rx-bus-width = <0x8>;
                                spi-max-frequency = <0x1312d00>;
                                compatible = "jedec,spi-nor";

                                partitions {
                                        compatible = "fixed-partitions";
                                        #address-cells = <0x1>;
                                        #size-cells = <0x1>;

                                        partition@0 {
                                                label = "Image Selector";
                                                reg = <0x0 0x60000>;
                                        };

                                        partition@60000 {
                                                label = "Image Selector Backup";
                                                reg = <0x60000 0x60000>;
                                        };

                                        partition@c0000 {
                                                label = "Image Selector Scratchpad";
                                                reg = <0xc0000 0x20000>;
                                        };

                                        partition@e0000 {
                                                label = "Image Recovery";
                                                reg = <0xe0000 0x1400000>;
                                        };

                                        partition@14e0000 {
                                                label = "Image Recovery Scratchpad";
                                                reg = <0x14e0000 0x20000>;
                                        };

                                        partition@1500000 {
                                                label = "SystemReady-DT Update Metadata";
                                                reg = <0x1500000 0x20000>;
                                        };

                                        partition@1520000 {
                                                label = "SystemReady-DT Update Metadata Backup";
                                                reg = <0x1520000 0x20000>;
                                        };

                                        partition@1540000 {
                                                label = "U-Boot Variables";
                                                reg = <0x1540000 0x20000>;
                                        };

                                        partition@1560000 {
                                                label = "U-Boot Variables Backup";
                                                reg = <0x1560000 0x20000>;
                                        };

                                        partition@1580000 {
                                                label = "U-Boot UEFI Variables";
                                                reg = <0x1580000 0x40000>;
                                        };

                                        partition@15c0000 {
                                                label = "Bank A Space";
                                                reg = <0x15c0000 0x7200000>;
                                        };

                                        partition@87c0000 {
                                                label = "U-Boot Variables Bank A";
                                                reg = <0x87c0000 0x20000>;
                                        };

                                        partition@87e0000 {
                                                label = "U-Boot Variables Bank A Backup";
                                                reg = <0x87e0000 0x20000>;
                                        };

                                        partition@8800000 {
                                                label = "Bank B Space";
                                                reg = <0x8800000 0x7200000>;
                                        };

                                        partition@fa00000 {
                                                label = "U-Boot Variables Bank B";
                                                reg = <0xfa00000 0x20000>;
                                        };

                                        partition@fa20000 {
                                                label = "U-Boot Variables Bank B Backup";
                                                reg = <0xfa20000 0x20000>;
                                        };

                                        partition@fa40000 {
                                                label = "User Scratchpad";
                                                reg = <0xfa40000 0x5c0000>;
                                        };
                                };
                        };
                };


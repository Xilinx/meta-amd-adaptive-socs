                        xlnx,s7-axis-protocol = "GENERIC";
                        xlnx,lockstep-slave = <0x0>;
                        xlnx,debug-profile-size = <0x0>;
                        xlnx,s2-axis-protocol = "GENERIC";
                        xlnx,m9-axis-protocol = "GENERIC";
                        xlnx,debug-counter-width = <0x20>;
                        xlnx,icache-data-width = <0x0>;
                        xlnx,m-axi-dc-ruser-width = <0x1>;
                        xlnx,reset-msr-dce = <0x0>;
                        xlnx,ip-name = "pmc";
                        xlnx,ip-axi-mon = <0x0>;
                        xlnx,m-axi-dp-data-width = <0x20>;
                        xlnx,m4-axis-protocol = "GENERIC";
                        xlnx,dcache-always-used = <0x0>;
                        xlnx,ill-opcode-exception = <0x1>;
                        xlnx,trace = <0x1>;
                        xlnx,pvr = <0x2>;
                        xlnx,debug-trace-size = <0x2000>;
                        i-cache-line-size = <0x10>;
                        xlnx,m13-axis-protocol = "GENERIC";
                        xlnx,s11-axis-data-width = <0x20>;
                        xlnx,m-axi-dc-addr-width = <0x20>;
                        xlnx,s13-axis-data-width = <0x20>;
                        xlnx,ecc-use-ce-exception = <0x0>;
                        xlnx,opcode-0x0-illegal = <0x1>;
                        xlnx,pvr-user2 = <0x0>;
                        xlnx,s15-axis-data-width = <0x20>;
                        xlnx,s13-axis-protocol = "GENERIC";
                        xlnx,m0-axis-data-width = <0x20>;
                        i-cache-highaddr = <0x3fffffff>;
                        xlnx,s8-axis-protocol = "GENERIC";
                        xlnx,m2-axis-data-width = <0x20>;
                        xlnx,num-sync-ff-clk-debug = <0x2>;
                        xlnx,allow-icache-wr = <0x1>;
                        xlnx,m4-axis-data-width = <0x20>;
                        xlnx,g-template-list = <0x0>;
                        xlnx,m6-axis-data-width = <0x20>;
                        xlnx,m-axi-ic-data-width = <0x20>;
                        xlnx,m8-axis-data-width = <0x20>;
                        xlnx,use-hw-mul = <0x2>;
                        xlnx,use-fpu = <0x0>;
                        xlnx,s3-axis-protocol = "GENERIC";
                        xlnx,use-non-secure = <0x0>;
                        d-cache-baseaddr = <0x0>;
                        xlnx,m11-axis-data-width = <0x20>;
                        xlnx,m13-axis-data-width = <0x20>;
                        xlnx,instr-size = <0x20>;
                        xlnx,m15-axis-data-width = <0x20>;
                        xlnx,mmu-dtlb-size = <0x4>;
                        xlnx,fsl-links = <0x0>;
                        xlnx,m5-axis-protocol = "GENERIC";
                        xlnx,dcache-victims = <0x0>;
                        xlnx,m-axi-dc-user-value = <0x1f>;
                        xlnx,unaligned-exceptions = <0x1>;
                        phandle = <0x116>;
                };
        };

        aliases {
                serial0 = "/axi/serial@f1920000";
                serial1 = "/axi/serial@f1930000";
                mmc0 = "/axi/mmc@f1040000";
                mmc1 = "/axi/mmc@f1050000";
                i2c0 = "/axi/i2c@f1940000";
                i2c1 = "/axi/i2c@f1950000";
                i2c2 = "/axi/i2c@f1960000";
                i2c3 = "/axi/i2c@f1970000";
                i2c4 = "/axi/i2c@f1980000";
                i2c5 = "/axi/i2c@f1990000";
                i2c6 = "/axi/i2c@f19a0000";
                i2c7 = "/axi/i2c@f19b0000";
                i2c8 = "/axi/i2c@f1000000";
                spi0 = "/axi/spi@f1010000";
                spi1 = "/axi/spi@f1030000";
                spi2 = "/axi/spi@f19c0000";
                spi3 = "/axi/spi@f19d0000";
                serial2 = "/amba_pl/serial@b2090000";
                serial3 = "/axi/coresight@f0800000";
        };

        firmware {

                psci: psci {
                        compatible = "arm,psci-1.0";
                        method = "smc";
                        phandle = <0x119>;
                };

                versal2_firmware: versal2-firmware {
                        compatible = "xlnx,versal2-firmware";
                        bootph-all;
                        method = "smc";
                        #power-domain-cells = <0x1>;
                        phandle = <0xbf>;

                        versal2_reset: reset-controller {
                                compatible = "xlnx,versal-reset";
                                #reset-cells = <0x1>;
                                phandle = <0xee>;
                        };

                        versal2_clk: clock-controller {
                                #clock-cells = <0x1>;
                                compatible = "xlnx,versal2-clk";
                                bootph-all;
                                clocks = <&ref_clk>,
                                 <&ref_clk>;
                                clock-names = "ref", "pl_alt_ref";
                                phandle = <0xba>;
                        };

                        versal_net_power: zynqmp-power {
                                compatible = "xlnx,zynqmp-power";
                                interrupt-parent = <&imux>;
                                interrupts = <0x0 0x39 0x4>;
                                mboxes = <&ipi_mailbox_pmu1 0x0>,
                                 <&ipi_mailbox_pmu1 0x1>;
                                mbox-names = "tx", "rx";
                                phandle = <0x11a>;
                        };

                        versal_sec_cfg: versal-sec-cfg {
                                compatible = "xlnx,versal-sec-cfg";
                                #address-cells = <0x1>;
                                #size-cells = <0x1>;
                                phandle = <0x11b>;

                                bbram_zeroize: bbram-zeroize@4 {
                                        reg = <0x4 0x4>;
                                        phandle = <0x11c>;
                                };

                                bbram_key: bbram-key@10 {
                                        reg = <0x10 0x20>;
                                        phandle = <0x11d>;
                                };

                                bbram_usr: bbram-usr@30 {
                                        reg = <0x30 0x4>;
                                        phandle = <0x11e>;
                                };

                                bbram_lock: bbram-lock@48 {
                                        reg = <0x48 0x4>;
                                        phandle = <0x11f>;
                                };

                                user_key0: user-key@110 {
                                        reg = <0x110 0x20>;
                                        phandle = <0x120>;
                                };

                                user_key1: user-key@130 {
                                        reg = <0x130 0x20>;
                                        phandle = <0x121>;
                                };

                                user_key2: user-key@150 {
                                        reg = <0x150 0x20>;
                                        phandle = <0x122>;
                                };

                                user_key3: user-key@170 {
                                        reg = <0x170 0x20>;
                                        phandle = <0x123>;
                                };

                                user_key4: user-key@190 {
                                        reg = <0x190 0x20>;
                                        phandle = <0x124>;
                                };

                                user_key5: user-key@1b0 {
                                        reg = <0x1b0 0x20>;
                                        phandle = <0x125>;
                                };

                                user_key6: user-key@1d0 {
                                        reg = <0x1d0 0x20>;
                                        phandle = <0x126>;
                                };

                                user_key7: user-key@1f0 {
                                        reg = <0x1f0 0x20>;
                                        phandle = <0x127>;
                                };
                        };
                };
        };

        fpga: fpga-region {
                compatible = "fpga-region";
                fpga-mgr = <&versal_fpga>;
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                phandle = <0x128>;
        };

        timer: timer {
                compatible = "arm,armv8-timer";
                interrupts = <0x1 0xd 0x4 0x1 0xe 0x4 0x1 0xb 0x4 0x1 0xa 0x4>;
                phandle = <0x129>;
        };

        versal_fpga: versal-fpga {
                compatible = "xlnx,versal-fpga";
                phandle = <0xe4>;
        };

        amba_apu: apu-bus {
                compatible = "simple-bus";
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                u-boot,dm-pre-reloc;
                phandle = <0x3>;
        };

        amba_rpu: rpu-bus {
                compatible = "indirect-bus";
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                u-boot,dm-pre-reloc;
                phandle = <0xbb>;
        };

        amba: axi {
                compatible = "simple-bus";
                bootph-all;
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;
                interrupt-parent = <&imux>;
                phandle = <0x2>;

                imux: interrupt-multiplex {
                        compatible = "interrupt-multiplex";
                        #address-cells = <0x0>;
                        #interrupt-cells = <0x3>;
                        interrupt-controller;
                        interrupt-map-mask = <0x0 0xffff 0x0>;
                        interrupt-map = <0x0 0x14 0x0 0x22 0x0 0x14 0x4 0x0 0x15 0x0 0x22 0x0 0x15 0x4 0x0 0x16 0x0 0x22 0x0 0x16 0x4 0x0 0x17 0x0 0x22 0x0 0x17 0x4 0x0 0x18 0x0 0x22 0x0 0x18 0x4 0x0 0x19 0x0 0x22 0x0 0x19 0x4 0x0 0x1a 0x0 0x22 0x0 0x1a 0x4 0x0 0x1b 0x0 0x22 0x0 0x1b 0x4 0x0 0x1c 0x0 0x22 0x0 0x1c 0x4 0x0 0x1d 0x0 0x22 0x0 0x1d 0x4 0x0 0x21 0x0 0x22 0x0 0x21 0x4 0x0 0x22 0x0 0x22 0x0 0x22 0x4 0x0 0x26 0x0 0x22 0x0 0x26 0x4 0x0 0x27 0x0 0x22 0x0 0x27 0x4 0x0 0x29 0x0 0x22 0x0 0x29 0x4 0x0 0x2b 0x0 0x22 0x0 0x2b 0x4 0x0 0x2c 0x0 0x22 0x0 0x2c 0x4 0x0 0x2d 0x0 0x22 0x0 0x2d 0x4 0x0 0x2e 0x0 0x22 0x0 0x2e 0x4 0x0 0x2f 0x0 0x22 0x0 0x2f 0x4 0x0 0x30 0x0 0x22 0x0 0x30 0x4 0x0 0x31 0x0 0x22 0x0 0x31 0x4 0x0 0x32 0x0 0x22 0x0 0x32 0x4 0x0 0x33 0x0 0x22 0x0 0x33 0x4 0x0 0x34 0x0 0x22 0x0 0x34 0x4 0x0 0x35 0x0 0x22 0x0 0x35 0x4 0x0 0x36 0x0 0x22 0x0 0x36 0x4 0x0 0x48 0x0 0x22 0x0 0x48 0x4 0x0 0x49 0x0 0x22 0x0 0x49 0x4 0x0 0x4a 0x0 0x22 0x0 0x4a 0x4 0x0 0x4b 0x0 0x22 0x0 0x4b 0x4 0x0 0x4c 0x0 0x22 0x0 0x4c 0x4 0x0 0x4d 0x0 0x22 0x0 0x4d 0x4 0x0 0x4e 0x0 0x22 0x0 0x4e 0x4 0x0 0x4f 0x0 0x22 0x0 0x4f 0x4 0x0 0x62 0x0 0x22 0x0 0x62 0x4 0x0 0x63 0x0 0x22 0x0 0x63 0x4 0x0 0xa9 0x0 0x22 0x0 0xa9 0x4 0x0 0xb4 0x0 0x22 0x0 0xb4 0x4 0x0 0xb5 0x0 0x22 0x0 0xb5 0x4 0x0 0xb6 0x0 0x22 0x0 0xb6 0x4 0x0 0xb7 0x0 0x22 0x0 0xb7 0x4 0x0 0xb9 0x0 0x22 0x0 0xb9 0x4 0x0 0xbe 0x0 0x22 0x0 0xbe 0x4 0x0 0xbf 0x0 0x22 0x0 0xbf 0x4 0x0 0xc8 0x0 0x22 0x0 0xc8 0x4 0x0 0xc9 0x0 0x22 0x0 0xc9 0x4 0x0 0x8b 0x0 0x22 0x0 0x8b 0x1 0x0 0x8c 0x0 0x22 0x0 0x8c 0x1 0x0 0x8f 0x0 0x22 0x0 0x8f 0x1 0x0 0x90 0x0 0x22 0x0 0x90 0x1 0x0 0x93 0x0 0x22 0x0 0x93 0x1 0x0 0x94 0x0 0x22 0x0 0x94 0x1 0x0 0xa4 0x0 0x22 0x0 0xa4 0x1 0x0 0xa5 0x0 0x22 0x0 0xa5 0x1 0x0 0x14 0x0 0xbe 0x0 0x14 0x4 0x0 0x15 0x0 0xbe 0x0 0x15 0x4 0x0 0x16 0x0 0xbe 0x0 0x16 0x4 0x0 0x17 0x0 0xbe 0x0 0x17 0x4 0x0 0x18 0x0 0xbe 0x0 0x18 0x4 0x0 0x19 0x0 0xbe 0x0 0x19 0x4 0x0 0x1a 0x0 0xbe 0x0 0x1a 0x4 0x0 0x1b 0x0 0xbe 0x0 0x1b 0x4 0x0 0x
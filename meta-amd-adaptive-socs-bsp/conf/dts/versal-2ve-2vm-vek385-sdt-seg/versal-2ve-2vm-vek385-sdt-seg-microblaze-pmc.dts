                };

                i2c1: i2c@f1950000 {
                        compatible = "cdns,i2c-r1p14";
                        status = "okay";
                        reg = <0x0 0xf1950000 0x0 0x1000>;
                        interrupt-parent = <&imux>;
                        interrupts = <0x0 0x16 0x4>;
                        clocks = <&versal2_clk 0x9f>;
                        power-domains = <&versal2_firmware 0x1822401e>;
                        xlnx,clock-freq = <0x98961be>;
                        xlnx,i2c-clk-freq-hz = <0x98961be>;
                        xlnx,ip-name = "i2c";
                        xlnx,iic-board-interface = "custom";
                        xlnx,name = "ps_wizard_0_ps11_0_i2c_1";
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;
                        bootph-all;
                        clock-frequency = <0x61a80>;
                        phandle = <0x98>;

                        i2c-arbitrator@72 {
                                compatible = "nxp,pca9541";
                                #address-cells = <0x1>;
                                #size-cells = <0x0>;
                                bootph-all;
                                reg = <0x72>;

                                i2c-arb@0 {
                                        #address-cells = <0x1>;
                                        #size-cells = <0x0>;
                                        reg = <0x0>;

                                        tca6416_u37: gpio@20 {
                                                compatible = "ti,tca6416";
                                                reg = <0x20>;
                                                #gpio-cells = <0x2>;
                                                gpio-controller;
                                                phandle = <0xfb>;
                                        };

                                        eeprom: eeprom@54 {
                                                compatible = "atmel,24c128";
                                                bootph-all;
                                                reg = <0x54>;
                                                phandle = <0x12d>;
                                        };

                                        i2c-mux@77 {
                                                compatible = "nxp,pca9548";
                                                #address-cells = <0x1>;
                                                #size-cells = <0x0>;
                                                reg = <0x77>;
                                                i2c-mux-idle-disconnect;

                                                i2c@0 {
                                                        #address-cells = <0x1>;
                                                        #size-cells = <0x0>;
                                                        reg = <0x0>;
                                                };

                                                i2c@1 {
                                                        #address-cells = <0x1>;
                                                        #size-cells = <0x0>;
                                                        reg = <0x1>;
                                                };

                                                i2c@2 {
                                                        #address-cells = <0x1>;
                                                        #size-cells = <0x0>;
                                                        reg = <0x2>;
                                                };

                                                i2c@3 {
                                                        #address-cells = <0x1>;
                                                        #size-cells = <0x0>;
                                                        reg = <0x3>;
                                                };

                                                i2c@4 {
                                                        #address-cells = <0x1>;
                                                        #size-cells = <0x0>;
                                                        reg = <0x4>;

                                                        hub: usb-hub@2d {
                                                                compatible = "microchip,usb5744";

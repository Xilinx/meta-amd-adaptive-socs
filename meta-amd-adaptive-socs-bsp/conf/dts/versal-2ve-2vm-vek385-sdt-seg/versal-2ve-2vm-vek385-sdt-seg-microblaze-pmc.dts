                         <&mmi_tsu_ext_clk>;
                        xlnx,mdio-io = "None";
                        xlnx,has-mdio = <0x0>;
                        xlnx,enet-tsu-clk-source = "MIO";
                        xlnx,enet-tsu-clk-freq-hz = <0xee6b280>;
                        xlnx,enet-hs-mode = <0x1>;
                        xlnx,lane-config = "Lane3";
                        xlnx,ip-name = "mmi_10gbe";
                        xlnx,name = "ps_wizard_0_mmi_0_mmi_10gbe";
                        phy-mode = "10gbase-r";
                        phandle = <0x6b>;

                        fixed-link {
                                speed = <0x2710>;
                                full-duplex;
                        };
                };


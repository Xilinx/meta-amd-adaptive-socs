                        clocks = <&versal2_clk 0x9d>;
                        power-domains = <&versal2_firmware 0x1822401d>;
                        xlnx,clock-freq = <0x98961be>;
                        xlnx,i2c-clk-freq-hz = <0x98961be>;
                        xlnx,ip-name = "i2c";

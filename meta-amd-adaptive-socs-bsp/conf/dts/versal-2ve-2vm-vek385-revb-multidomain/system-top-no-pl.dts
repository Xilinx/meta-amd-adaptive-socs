        aliases {
                nvmem0 = "/axi/i2c@f1950000/i2c-arbitrator@72/i2c-arb/eeprom@54";
                ethernet0 = "/axi/ethernet@f1a60000";
                serial2 = "/axi/coresight@f0800000";
                spi3 = "/axi/spi@f19d0000";
                spi2 = "/axi/spi@f19c0000";
                spi1 = "/axi/spi@f1030000";
                spi0 = "/axi/spi@f1010000";
                i2c8 = "/axi/i2c@f1000000";
                i2c7 = "/axi/i2c@f19b0000";
                i2c6 = "/axi/i2c@f19a0000";
                i2c5 = "/axi/i2c@f1990000";
                i2c4 = "/axi/i2c@f1980000";
                i2c3 = "/axi/i2c@f1970000";
                i2c2 = "/axi/i2c@f1950000";
                i2c1 = "/axi/i2c@f1940000";
                mmc1 = "/axi/mmc@f1050000";
                mmc0 = "/axi/mmc@f1040000";
                serial1 = "/axi/serial@f1930000";
                serial0 = "/axi/serial@f1920000";
        };

        firmware {

                psci: psci {
                        phandle = <0x13e>;
                        method = "smc";
                        compatible = "arm,psci-1.0";
                };

                scmi: scmi {
                        phandle = <0x13f>;
                        bootph-all;
                        shmem = <0x102>;
                        #size-cells = <0x0>;
                        #address-cells = <0x1>;
                        arm,smc-id = <0xc2002001>;
                        compatible = "arm,scmi-smc";

                        scmi_reset: protocol@16 {
                                phandle = <0x10d>;
                                #reset-cells = <0x1>;
                                reg = <0x16>;
                        };

                        scmi_devpd: protocol@11 {
                                phandle = <0xd9>;
                                #power-domain-cells = <0x1>;
                                reg = <0x11>;
                        };

                        scmi_clk: protocol@14 {
                                phandle = <0xca>;
                                #clock-cells = <0x1>;
                                reg = <0x14>;
                        };
                };

                versal2_firmware: versal2-firmware {
                        phandle = <0x140>;
                        #power-domain-cells = <0x1>;
                        method = "smc";
                        bootph-all;
                        compatible = "xlnx,versal2-firmware";

                        versal_sec_cfg: versal-sec-cfg {
                                phandle = <0x141>;
                                compatible = "xlnx,versal-sec-cfg";

                                nvmem-layout {
                                        #size-cells = <0x1>;
                                        #address-cells = <0x1>;
                                        compatible = "fixed-layout";

                                        bbram_zeroize: bbram-zeroize@4 {
                                                phandle = <0x142>;
                                                reg = <0x4 0x4>;
                                        };

                                        bbram_key: bbram-key@10 {
                                                phandle = <0x143>;
                                                reg = <0x10 0x20>;
                                        };

                                        bbram_usr: bbram-usr@30 {
                                                phandle = <0x144>;
                                                reg = <0x30 0x4>;
                                        };

                                        bbram_lock: bbram-lock@48 {
                                                phandle = <0x145>;
                                                reg = <0x48 0x4>;
                                        };

                                        user_key0: user-key@110 {
                                                phandle = <0x146>;
                                                reg = <0x110 0x20>;
                                        };

                                        user_key1: user-key@130 {
                                                phandle = <0x147>;
                                                reg = <0x130 0x20>;
                                        };

                                        user_key2: user-key@150 {
                                                phandle = <0x148>;
                                                reg = <0x150 0x20>;
                                        };

                                        user_key3: user-key@170 {
                                                phandle = <0x149>;
                                                reg = <0x170 0x20>;
                                        };

                                        user_key4: user-key@190 {
                                                phandle = <0x14a>;
                                                reg = <0x190 0x20>;
                                        };

                                        user_key5: user-key@1b0 {
                                                phandle = <0x14b>;
                                                reg = <0x1b0 0x20>;
                                        };

                                        user_key6: user-key@1d0 {
                                                phandle = <0x14c>;
                                                reg = <0x1d0 0x20>;
                                        };

                                        user_key7: user-key@1f0 {
                                                phandle = <0x14d>;
                                                reg = <0x1f0 0x20>;
                                        };
                                };
                        };
                };
        };

        fpga: fpga-region {
                phandle = <0x14e>;
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                fpga-mgr = <&versal_fpga>;
                compatible = "fpga-region";
        };

        timer: timer {
                phandle = <0x14f>;
                interrupts = <0x1 0xd 0x4 0x1 0xe 0x4 0x1 0xb 0x4 0x1 0xa 0x4>;
                compatible = "arm,armv8-timer";
        };

        versal_fpga: versal-fpga {
                phandle = <0x103>;
                compatible = "xlnx,versal-fpga";
        };

        amba_apu: apu-bus {
                phandle = <0x3>;
                u-boot,dm-pre-reloc;
                interrupt-parent = <&gic_a78>;
                ranges;
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                compatible = "simple-bus";

                gic_a78: interrupt-controller@e2000000 {
                        phandle = <0x14>;
                        xlnx,name = "ps_wizard_0_ps11_0_acpu_gic";
                        xlnx,ip-name = "acpu_gic";
                        status = "okay";
                        ranges;
                        #size-cells = <0x2>;
                        #address-cells = <0x2>;
                        interrupts = <0x1 0x9 0x4>;
                        interrupt-parent = <&gic_a78>;
                        interrupt-controller;
                        reg = <0x0 0xe2000000 0x0 0x10000 0x0 0xe2060000 0x0 0x100000>;
                        #interrupt-cells = <0x3>;
                        compatible = "arm,gic-v3";

                        its: msi-controller@e2040000 {
                                phandle = <0x126>;
                                reg = <0x0 0xe2040000 0x0 0x20000>;
                                #msi-cells = <0x1>;
                                msi-controller;
                                compatible = "arm,gic-v3-its";
                        };
                };
        };

        amba_rpu: rpu-bus {
                phandle = <0xd3>;
                u-boot,dm-pre-reloc;
                interrupt-parent = <&gic_r52>;
                ranges;
                #size-cells = <0x2>;
                #address-cells = <0x2>;
                compatible = "indirect-bus";

                gic_r52: interrupt-controller@e2000000 {
                        phandle = <0xd6>;
                        xlnx,name = "ps_wizard_0_ps11_0_rcpu_gic";
                        xlnx,ip-name = "rcpu_gic";
                        status = "okay";
                        reg = <0x0 0xe2000000 0x0 0x10000 0x0 0xe2100000 0x0 0x80000>;
                        #size-cells = <0x2>;
                        #address-cells = <0x2>;
                        interrupts = <0x1 0x9 0x4>;
                        interrupt-parent = <&gic_r52>;
                        interrupt-controller;
                        #interrupt-cells = <0x3>;
                        compatible = "arm,gic-v3", "arm,gic";
                };
        };

        sensor0: versal-thermal-sensor {
                phandle = <0x104>;
                io-channel-names = "sysmon-temp-channel", "aie-temp-ch1", "aie-temp-ch2", "aie-temp-ch3", "aie-temp-ch4", "aie-temp-ch5", "aie-temp-ch6", "aie-temp-ch7", "aie-temp-ch8";
                io-channels = <&sysmon0 0x12>,
                 <&sysmon0 0xa>,
                 <&sysmon0 0xb>,
                 <&sysmon0 0xc>,
                 <&sysmon0 0xd>,

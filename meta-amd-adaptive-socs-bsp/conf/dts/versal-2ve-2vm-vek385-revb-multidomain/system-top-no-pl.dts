                phandle = <0x123>;
                clock-frequency = <0x16e3600>;
                #clock-cells = <0x0>;
                compatible = "fixed-clock";
                bootph-all;
        };

        can0_phy: can-phy0 {
                phandle = <0x113>;
                standby-gpios = <&gpio0 0xd 0x1>;
                max-bitrate = <0x4c4b40>;
                #phy-cells = <0x0>;
                compatible = "ti,tcan1043";
        };

        can1_phy: can-phy1 {
                phandle = <0x115>;
                standby-gpios = <&gpio0 0x16 0x1>;
                max-bitrate = <0x4c4b40>;
                #phy-cells = <0x0>;
                compatible = "ti,tcan1043";

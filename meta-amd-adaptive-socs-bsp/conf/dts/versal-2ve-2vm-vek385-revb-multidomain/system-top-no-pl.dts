                 <&sysmon0 0xf>,
                 <&sysmon0 0x10>,
                 <&sysmon0 0x11>;
                #thermal-sensor-cells = <0x1>;
                compatible = "xlnx,versal-thermal";
        };

        thermal-zones {

                versal_thermal: versal-thermal {
                        phandle = <0x150>;
                        thermal-sensors = <&sensor0 0x0>;
                        polling-delay = <0x3e8>;
                        polling-delay-passive = <0xfa>;

                        trips {

                                temp_alert: temp-alert {
                                        phandle = <0x151>;
                                        type = "passive";
                                        hysteresis = <0x0>;
                                        temperature = <0x11170>;
                                };

                                ot_crit: ot-crit {
                                        phandle = <0x152>;
                                        type = "critical";
                                        hysteresis = <0x0>;
                                        temperature = <0x1e848>;
                                };
                        };

                        cooling-maps {
                        };
                };

                versal_thermal_aie: versal-aie-thermal {
                        phandle = <0x153>;
                        thermal-sensors = <&sensor0 0x1>;
                        polling-delay = <0x3e8>;
                        polling-delay-passive = <0xfa>;

                        trips {

                                temp_alert_aie: temp-alert-aie {
                                        phandle = <0x154>;
                                        type = "passive";
                                        hysteresis = <0x0>;
                                        temperature = <0x11170>;
                                };

                                ot_crit_aie: ot-crit-aie {
                                        phandle = <0x155>;
                                        type = "critical";
                                        hysteresis = <0x0>;
                                        temperature = <0x1e848>;
                                };
                        };

                        cooling-maps {
                        };
                };
        };


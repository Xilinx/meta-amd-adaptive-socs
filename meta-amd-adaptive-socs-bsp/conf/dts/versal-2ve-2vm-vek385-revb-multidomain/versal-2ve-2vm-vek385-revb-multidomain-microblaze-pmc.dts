        zynqmp-ipi {
                compatible = "xlnx,zynqmp-ipi-mailbox";
                interrupt-parent = <&imux>;
                interrupts = <0x0 0x39 0x4>;
                xlnx,ipi-id = <0x2>;
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;

                ipi_mailbox_pmu1: mailbox@eb3f0440 {
                        phandle = <0xfa>;
                        compatible = "xlnx,zynqmp-ipi-dest-mailbox";
                        reg = <0x0 0xeb3f0440 0x0 0x20 0x0 0xeb3f0460 0x0 0x20 0x0 0xeb3f0280 0x0 0x20 0x0 0xeb3f02a0 0x0 0x20>;
                        reg-names = "local_request_region", "local_response_region", "remote_request_region", "remote_response_region";
                        #mbox-cells = <0x1>;
                        xlnx,ipi-id = <0x1>;
                };
        };

        ref_clk: ref-clk {
                phandle = <0xf9>;
                bootph-all;
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x1fca055>;
                clock-output-names = "board_ref_clk";
        };

        rtc_clk: rtc-clk {
                phandle = <0x117>;
                bootph-all;
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x8000>;
                clock-output-names = "rtc_clk";
        };

        can0_clk: can0-clk {
                phandle = <0x10c>;
                #clock-cells = <0x0>;
                compatible = "fixed-factor-clock";
                clocks = <&scmi_clk 0x48>;
                clock-div = <0x2>;
                clock-mult = <0x1>;
        };

        can1_clk: can1-clk {
                phandle = <0x10e>;
                #clock-cells = <0x0>;
                compatible = "fixed-factor-clock";
                clocks = <&scmi_clk 0x4e>;
                clock-div = <0x2>;
                clock-mult = <0x1>;
        };

        can2_clk: can2-clk {
                phandle = <0x110>;
                #clock-cells = <0x0>;
                compatible = "fixed-factor-clock";
                clocks = <&scmi_clk 0x5a>;
                clock-div = <0x2>;
                clock-mult = <0x1>;
        };

        can3_clk: can3-clk {
                phandle = <0x111>;
                #clock-cells = <0x0>;
                compatible = "fixed-factor-clock";
                clocks = <&scmi_clk 0x5d>;
                clock-div = <0x2>;
                clock-mult = <0x1>;
        };

        clk50: clk50 {
                phandle = <0x105>;
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x2faf080>;
        };

        clk150: clk150 {
                phandle = <0x114>;
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x8f0d180>;
        };

        clk250: clk250 {
                phandle = <0x296>;
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0xee6b280>;
        };

        clk256: clk256 {
                phandle = <0x11c>;
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0xf424000>;
        };

        ufs_ref_clk: ufs-ref-clk {
                phandle = <0x118>;
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x18cba80>;
        };

        amba_pl: amba_pl {
                phandle = <0x297>;
                ranges;
                compatible = "simple-bus";
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                firmware-name = "vek385_revb_base_pld.pdi";

                encoder: ale2xx@e8040000 {
                        phandle = <0x299>;
                        compatible = "al,ale2xx";
                        clock-names = "mcu";
                        al,devicename = "al_e2xx";
                        reg = <0x0 0xe8040000 0x0 0x80000 0x0 0x8000000 0x0 0x8000000>;
                        xlnx,mcu-clk = <0x3b6>;
                        reg-names = "regs", "apb";
                };

                decoder: ald3xx@e8080000 {
                        phandle = <0x29a>;
                        compatible = "al,ald3xx";
                        clock-names = "mcu";
                        al,devicename = "al_d3xx";
                        reg = <0x0 0xe8080000 0x0 0x80000 0x0 0x0 0x0 0x8000000>;
                        xlnx,mcu-clk = <0x396>;
                        reg-names = "regs", "apb";
                };

                aie_core_ref_clk_0: aie_core_ref_clk_0 {
                        phandle = <0x123>;
                        compatible = "fixed-clock";
                        clock-frequency = <0x4a817c80>;
                        #clock-cells = <0x0>;
                };

                zyxclmm_drm {
                        interrupts = <0x0 0x89 0x4 0x0 0x90 0x4 0x0 0x91 0x4 0x0 0x92 0x4 0x0 0x93 0x4 0x0 0x94 0x4 0x0 0x95 0x4 0x0 0x96 0x4>;
                        interrupt-parent = <&imux>;
                        compatible = "xlnx,zocl-versal";
                };

                visp_mbox_rpu_6: visp_mbox_rpu_6 {
                        phandle = <0x29c>;
                        memory-region = <&isp_mbox>;
                };

                visp_mbox_rpu_7: visp_mbox_rpu_7 {
                        phandle = <0x29d>;
                        memory-region = <&isp_mbox>;
                };

                visp_mbox_rpu_8: visp_mbox_rpu_8 {
                        phandle = <0x29e>;
                        memory-region = <&isp_mbox>;
                };

                visp_mbox_rpu_9: visp_mbox_rpu_9 {
                        phandle = <0x29f>;
                        memory-region = <&isp_mbox>;
                };
        };

        mmi_tsu_ext_clk: mmi_tsu_ext_clk {
                phandle = <0x115>;
                compatible = "fixed-clock";
                clock-frequency = <0xee6b280>;
                #clock-cells = <0x0>;
        };

        tsu_ext_clk: tsu_ext_clk {
                phandle = <0x112>;
                compatible = "fixed-clock";
                clock-frequency = <0xee6b280>;
                #clock-cells = <0x0>;
        };

        chosen {
                zephyr,ram-console = "/reserved-memory/trace@985f000";
                stdout-path = "serial0:115200n8";
                bootargs = "console=ttyAMA0,115200";
        };

        pwm-fan {
                compatible = "pwm-fan";
                pwms = <&ttc0 0x2 0x9c40 0x1>;
        };

        usb_hub_delay: enable-delay {
                phandle = <0x119>;
                compatible = "gpio-delay";
                #gpio-cells = <0x3>;
                gpio-controller;
                gpios = <&gpio0 0xe 0x1>;
        };

        vdd_usb_hub: regulator-vdd-usb-hub {
                phandle = <0x11a>;
                compatible = "regulator-fixed";
                regulator-name = "vdd_usb_hub";
                regulator-min-microvolt = <0x325aa0>;
                regulator-max-microvolt = <0x325aa0>;
                regulator-always-on;
                regulator-boot-on;
        };

        vdd2_usb_hub: regulator-vdd2-usb-hub {
                phandle = <0x11b>;
                compatible = "regulator-fixed";
                regulator-name = "vdd2_usb_hub";
                regulator-min-microvolt = <0x124f80>;
                regulator-max-microvolt = <0x124f80>;
                regulator-always-on;
                regulator-boot-on;
        };

        usb3_dp_phy_ref_clk: usb3-phy-ref-clk {
                phandle = <0x11d>;
                bootph-all;
                compatible = "fixed-clock";
                #clock-cells = <0x0>;
                clock-frequency = <0x16e3600>;
        };

        can0_phy: can-phy0 {
                phandle = <0x10d>;
                compatible = "ti,tcan1043";
                #phy-cells = <0x0>;
                max-bitrate = <0x4c4b40>;
                standby-gpios = <&gpio0 0xd 0x1>;
        };

        can1_phy: can-phy1 {
                phandle = <0x10f>;
                compatible = "ti,tcan1043";
                #phy-cells = <0x0>;
                max-bitrate = <0x4c4b40>;
                standby-gpios = <&gpio0 0x16 0x1>;
        };


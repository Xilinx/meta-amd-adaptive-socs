                can0_phy = "/can-phy0";
                can1_phy = "/can-phy1";
                libmetal_uio_desc099c8000 = "/axi/libmetal_uio_desc0@99c8000";
                libmetal_uio_desc199cc000 = "/axi/libmetal_uio_desc1@99cc000";
                libmetal_uio_data99d0000 = "/axi/libmetal_uio_data@99d0000";
                plm_reserved_memory = "/reserved-memory/plm_reserved_memory@00000000";
                tfa_reserved_memory = "/reserved-memory/tfa_reserved_memory@1000000";
                cma_reserved_800000000 = "/reserved-memory/cma_reserved@800000000";
                cma_reserved_50000000000 = "/reserved-memory/cma_reserved@50000000000";
                cma_reserved_60000000000 = "/reserved-memory/cma_reserved@60000000000";
                ddrboot = "/reserved-memory/ddrboot@9800100";
                trace_buffer = "/reserved-memory/trace@985f000";
                vdev0vring0 = "/reserved-memory/vdev0vring0@9880000";
                vdev0vring1 = "/reserved-memory/vdev0vring1@9884000";
                vdev0buffer = "/reserved-memory/vdev0buffer@9888000";
                rsctbl = "/reserved-memory/rsctbl@9800000";
                libmetal_elf = "/reserved-memory/libmetal_elf@9968000";
                libmetal_desc0 = "/reserved-memory/libmetal_desc0@99c8000";
                libmetal_desc1 = "/reserved-memory/libmetal_desc1@99cc000";
                libmetal_data = "/reserved-memory/libmetal_data@99d0000";
                rpu6_fw = "/reserved-memory/rproc6@c000000";
                rpu6_calib = "/reserved-memory/rpu6-calib-load@f800000";
                rpu6_halpriv = "/reserved-memory/rpu6-hal-mem-priv@f828000";
                rpu7_fw = "/reserved-memory/rproc7@1082a000";
                rpu7_calib = "/reserved-memory/rpu7-calib-load@1402a000";
                rpu7_halpriv = "/reserved-memory/rpu7-hal-mem-priv@14052000";
                rpu8_fw = "/reserved-memory/rproc8@15054000";
                rpu8_calib = "/reserved-memory/rpu8-calib-load@18854000";
                rpu8_halpriv = "/reserved-memory/rpu8-hal-mem-priv@1887c000";
                rpu9_fw = "/reserved-memory/rproc9@1987e000";
                rpu9_calib = "/reserved-memory/rpu9-calib-load@1d07e000";
                rpu9_halpriv = "/reserved-memory/rpu9-hal-mem-priv@1d0a6000";
                isp_mbox = "/reserved-memory/isp_mbox_buffer@1e0a8000";
                rpu_shared = "/reserved-memory/rpu-shared-mem@1e4a8000";
                isp_sensor_bin = "/reserved-memory/isp_sensor_bin@1e4e8000";
                isp_vring = "/reserved-memory/vring@1fff7000";
                visp_mbox_rpu_6 = "/amba_pl/visp_mbox_rpu_6";
                visp_mbox_rpu_7 = "/amba_pl/visp_mbox_rpu_7";
                visp_mbox_rpu_8 = "/amba_pl/visp_mbox_rpu_8";
                visp_mbox_rpu_9 = "/amba_pl/visp_mbox_rpu_9";
        };

        domains {

                APU_Linux {
                        phandle = <0x2be>;
                        compatible = "openamp,domain-v1";
                        access = <&visp_mbox_rpu_6 0x0>,
                         <&visp_mbox_rpu_7 0x0>,
                         <&visp_mbox_rpu_8 0x0>,
                         <&visp_mbox_rpu_9 0x0>;
                        reserved-memory = <0x2a0 0x2a1 0x2a2 0x2a3 0x2a4 0x2a5 0x2a6 0x2a7 0x2a8 0x2a9 0x2aa 0x2ab 0x2ac 0x2ad 0x2ae 0x2af 0x2b0 0x2b1 0x2b2 0x2b3 0x2b4 0x2b5 0x29b 0x2b6 0x2b7 0x2b8>;
                        os,type = "linux";
                        access-json = "[{\"dev\": \"visp_mbox_rpu_6\", \"flags\": 0}, {\"dev\": \"visp_mbox_rpu_7\", \"flags\": 0}, {\"dev\": \"visp_mbox_rpu_8\", \"flags\": 0}, {\"dev\": \"visp_mbox_rpu_9\", \"flags\": 0}]";

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";

                                remoteproc-relation {
                                        compatible = "openamp,remoteproc-v2";

                                        relation0 {
                                                remote = <0x2b9>;
                                                elfload = <&ddrboot>,
                                                 <&trace_buffer>,
                                                 <&rsctbl>;
                                        };
                                };

                                rpmsg-relation {
                                        compatible = "openamp,rpmsg-v1";

                                        relation0 {
                                                remote = <0x2b9>;
                                                carveouts = <0x2a5 0x2a6 0x2a7>;
                                                mbox = <0x202>;
                                        };
                                };

                                libmetal-relation {
                                        compatible = "libmetal,ipc-v1";

                                        relation0 {
                                                remote = <0x2ba>;
                                                carveouts = <0x2bb 0x2bc 0x2bd>;
                                                mbox = <0x1c1>;
                                                timer = <0xb1>;
                                        };
                                };
                        };
                };

                RPU_Zephyr {
                        phandle = <0x2b9>;
                        compatible = "openamp,domain-v1";
                        os,type = "zephyr";
                        zephyr-version = "4.3";
                        xlnx,ddr-boot;
                        xlnx,zephyr,mems = "ddrboot@9800100";
                        sram = <0x0 0x9800100 0x0 0x5de00 0x0 0xeba00000 0x0 0x10000 0x0 0xeba10000 0x0 0x8000 0x0 0xeba20000 0x0 0x8000>;
                        reserved-memory = <0x2a8 0x2a9 0x2aa>;
                        cpu_config_str = "split";
                        core_num = "0";
                        linker_file_output_name = "openamp-zephyr.ld";
                        linker-entry = "_vector_table";
                        linker_memories = <0x2a 0x2b 0x2c 0x2a8 0x2aa>;
                        linker-section-vector-table = <0x2a>;
                        linker-section-vector-table-offset = <0x0>;
                        linker-section-text = <0x2a>;
                        linker-section-rodata = <0x2a>;
                        linker-section-data = <0x2b>;
                        linker-section-bss = <0x2b>;
                        linker-section-noinit = <0x2b>;
                        linker-section-heap = <0x2b>;
                        linker-section-stack = <0x2b>;
                        linker-section-resource-table = <0x2aa>;
                        linker-section-resource-table-offset = <0x0>;

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";
                                cluster_cpu = "cortexr52_0";

                                rpmsg-relation {
                                        compatible = "openamp,rpmsg-v1";

                                        relation0 {
                                                host = <0x2be>;
                                                mbox = <0x210>;
                                                carveouts = <0x2a5 0x2a6 0x2a7>;
                                        };
                                };
                        };
                };

                RPU_1_BM {
                        phandle = <0x2ba>;
                        compatible = "openamp,domain-v1";
                        sram = <0x0 0x9968000 0x0 0x60000 0x0 0xeba80000 0x0 0x10000 0x0 0xeba90000 0x0 0x8000 0x0 0xebaa0000 0x0 0x8000>;
                        os,type = "baremetal";
                        cpu_config_str = "split";
                        core_num = "1";

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";
                                cluster_cpu = "cortexr52_1";

                                libmetal-relation {
                                        compatible = "libmetal,ipc-v1";

                                        relation0 {
                                                host = <0x2be>;
                                                carveouts = <0x2bb 0x2bc 0x2bd>;
                                                mbox = <0x1b3>;
                                                timer = <0xb1>;
                                                elfload = <&libmetal_elf>;
                                        };
                                };
                        };
                };

                PMC_MB {
                        compatible = "openamp,domain-v1";
                        cpus = <&cpus_microblaze_0 0x1 0x0>;
                };
        };
};

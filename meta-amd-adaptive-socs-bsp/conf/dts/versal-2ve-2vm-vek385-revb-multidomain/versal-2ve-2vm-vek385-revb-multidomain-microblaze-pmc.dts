                         <0x0 0x94 0x0 0xd7 0x0 0x94 &imux>,
                         <0x0 0xa4 0x0 0xd7 0x0 0xa4 &imux>,
                         <0x0 0xa5 0x0 0xd7 0x0 0xa5 &imux>;
                };

                mmi_gpu_slcr@ed720000 {
                        reg = <0x0 0xed720000 0x0 0x20000>;

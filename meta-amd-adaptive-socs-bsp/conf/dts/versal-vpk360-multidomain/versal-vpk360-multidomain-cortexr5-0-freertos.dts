        domains {

                APU_Linux {
                        phandle = <0x180>;
                        compatible = "openamp,domain-v1";
                        reserved-memory = <0x16e 0x16f 0x170 0x171 0x172 0x173 0x174 0x175 0x176 0x177 0x178 0x179 0x17a>;
                        os,type = "linux";

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";

                                remoteproc-relation {
                                        compatible = "openamp,remoteproc-v2";

                                        relation0 {
                                                remote = <0x17b>;
                                                elfload = <&rproc0>;
                                        };
                                };

                                rpmsg-relation {
                                        compatible = "openamp,rpmsg-v1";

                                        relation0 {
                                                remote = <0x17b>;
                                                mbox = <0x11d>;
                                                carveouts = <0x179 0x178 0x177>;
                                                timer = <0x56 0xcd>;
                                        };
                                };

                                libmetal-relation {
                                        compatible = "libmetal,ipc-v1";

                                        relation0 {
                                                remote = <0x17c>;
                                                carveouts = <0x17d 0x17e 0x17f>;
                                                mbox = <0x132>;
                                                timer = <0xce>;
                                        };
                                };
                        };
                };

                R5_0_FREERTOS {
                        phandle = <0x17b>;
                        compatible = "openamp,domain-v1";
                        sram = <0x0 0x9800000 0x0 0x6000 0x0 0xffe00000 0x0 0x10000>;
                        reserved-memory = <0x177 0x178 0x179 0x17a>;
                        cpus = <&cpus_r5_0 0x1 0x80000000>;
                        os,type = "freertos";
                        rpu_pd_val = <0x70 0x18110005>;
                        cpu_config_str = "split";
                        core_num = "0";

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";
                                cluster_cpu = "psv_cortexr5_0";

                                rpmsg-relation {
                                        compatible = "openamp,rpmsg-v1";

                                        relation0 {
                                                host = <0x180>;
                                                mbox = <0x10b>;
                                                carveouts = <0x179 0x178 0x177>;
                                                timer = <0xcf>;
                                        };
                                };
                        };
                };

                R5_1_BAREMETAL {
                        phandle = <0x17c>;
                        compatible = "openamp,domain-v1";
                        sram = <0x0 0x9968000 0x0 0x60000 0x0 0xffe90000 0x0 0x10000>;
                        os,type = "baremetal";
                        rpu_pd_val = <0x70 0x18110006>;
                        cpu_config_str = "split";
                        core_num = "1";

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";
                                cluster_cpu = "psv_cortexr5_1";

                                libmetal-relation {
                                        compatible = "libmetal,ipc-v1";

                                        relation0 {
                                                host = <0x180>;
                                                carveouts = <0x17d 0x17e 0x17f>;
                                                mbox = <0x117>;
                                                timer = <0xce 0xcf>;
                                                elfload = <&libmetal_elf>;
                                        };
                                };
                        };
                };
        };

        reserved-memory {
                ranges;
                #size-cells = <0x2>;
                #address-cells = <0x2>;

                plm_reserved_memory: plm_reserved_memory@00000000 {
                        phandle = <0x16e>;
                        label = "plm_reserved_memory";
                        no-map;
                        reg = <0x0 0x0 0x0 0x1000000>;
                };

                tfa_transfer_reserved: tfa_transfer_reserved@1000000 {
                        phandle = <0x16f>;
                        label = "tfa_transfer_reserved";
                        no-map;
                        reg = <0x0 0x1000000 0x0 0x600000>;
                };

                scmi_shm_reserved: scmi_shm_reserved@a000000 {
                        phandle = <0x170>;
                        label = "scmi_shm_reserved";
                        no-map;
                        reg = <0x0 0xa000000 0x0 0x20000>;
                };

                scmi_server_reserved: scmi_server_reserved@a020000 {
                        phandle = <0x171>;
                        label = "scmi_server_reserved";
                        no-map;
                        reg = <0x0 0xa020000 0x0 0x60000>;
                };

                tfa_pkg_reserved: tfa_pkg_reserved@a080000 {
                        phandle = <0x172>;
                        label = "tfa_pkg_reserved";
                        no-map;
                        reg = <0x0 0xa080000 0x0 0x380000>;
                };

                cpm6_pcie_rp_reserved: cpm6_pcie_rp_reserved@a400000 {
                        phandle = <0x173>;
                        label = "cpm6_pcie_rp_reserved";
                        no-map;
                        reg = <0x0 0xa400000 0x0 0x400000>;
                };

                cma_reserved_840000000: cma_reserved@840000000 {
                        phandle = <0x174>;
                        label = "cma_reserved_840000000";
                        compatible = "shared-dma-pool";
                        reusable;
                        linux,cma-default;
                        reg = <0x8 0x40000000 0x0 0x40000000>;
                };

                cma_reserved_50000000000: cma_reserved@50000000000 {
                        phandle = <0x175>;
                        label = "cma_reserved_50000000000";
                        compatible = "shared-dma-pool";
                        reusable;
                        reg = <0x500 0x0 0x2 0x0>;
                };

                cma_reserved_60000000000: cma_reserved@60000000000 {
                        phandle = <0x176>;
                        label = "cma_reserved_60000000000";
                        compatible = "shared-dma-pool";
                        reusable;
                        reg = <0x600 0x0 0x1 0x0>;
                };

                rproc0: rproc0@9800000 {
                        phandle = <0x17a>;
                        label = "rproc0";
                        no-map;
                        reg = <0x0 0x9800000 0x0 0x60000>;
                };

                vdev0vring0: vdev0vring0@9860000 {
                        phandle = <0x179>;
                        label = "vdev0vring0";
                        no-map;
                        reg = <0x0 0x9860000 0x0 0x4000>;
                };

                vdev0vring1: vdev0vring1@9864000 {
                        phandle = <0x178>;
                        label = "vdev0vring1";
                        no-map;
                        reg = <0x0 0x9864000 0x0 0x4000>;
                };

                vdev0buffer: vdev0buffer@9868000 {
                        phandle = <0x177>;

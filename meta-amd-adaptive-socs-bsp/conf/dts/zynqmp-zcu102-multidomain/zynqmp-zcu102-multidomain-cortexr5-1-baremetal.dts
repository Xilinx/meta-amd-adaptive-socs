        domains {

                APU_Linux {
                        phandle = <0x1a1>;
                        compatible = "openamp,domain-v1";
                        reserved-memory = <0x196 0x197 0x198 0x199 0x19a 0x19b>;
                        os,type = "linux";
                        lopper,access-keep-all = <0x1>;

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";

                                remoteproc-relation {
                                        compatible = "openamp,remoteproc-v2";

                                        relation0 {
                                                remote = <0x19c>;
                                                elfload = <&rproc0>,
                                                 <&trace_buffer>,
                                                 <&rsctbl>;
                                        };
                                };

                                rpmsg-relation {
                                        compatible = "openamp,rpmsg-v1";

                                        relation0 {
                                                remote = <0x19c>;
                                                carveouts = <0x198 0x197 0x196>;
                                                mbox = <0x15f>;
                                        };
                                };

                                libmetal-relation {
                                        compatible = "libmetal,ipc-v1";

                                        relation0 {
                                                remote = <0x19d>;
                                                carveouts = <0x19e 0x19f 0x1a0>;
                                                mbox = <0x16b>;
                                                timer = <0x74>;
                                        };
                                };
                        };
                };

                R5_0_ZEPHYR {
                        phandle = <0x19c>;
                        compatible = "openamp,domain-v1";
                        zephyr-version = "4.3";
                        sram = <0x0 0x9800000 0x0 0x20000 0x0 0x0 0x0 0x10000 0x0 0x20000 0x0 0x10000>;
                        reserved-memory = <0x196 0x197 0x198 0x199 0x19a 0x19b>;
                        os,type = "zephyr";
                        rpu_pd_val = <0x89 0x7>;
                        cpu_config_str = "split";
                        core_num = <0x0>;
                        linker_file_output_name = "openamp-zephyr.ld";
                        linker-entry = "_vector_table";
                        linker_memories = <0x84 0x85 0x199 0x19b>;
                        linker-section-vector-table = <0x84>;
                        linker-section-vector-table-offset = <0x0>;
                        linker-section-text = <0x84>;
                        linker-section-rodata = <0x84>;
                        linker-section-data = <0x85>;
                        linker-section-bss = <0x85>;
                        linker-section-noinit = <0x85>;
                        linker-section-heap = <0x85>;
                        linker-section-stack = <0x85>;
                        linker-section-resource-table = <0x19b>;
                        linker-section-resource-table-offset = <0x0>;
                        access-json = "[{\"dev\": \"ipi1\"}]";

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";

                                rpmsg-relation {
                                        compatible = "openamp,rpmsg-v1";

                                        relation0 {
                                                host = <0x1a1>;
                                                mbox = <0x123>;
                                                carveouts = <0x198 0x197 0x196>;
                                        };
                                };
                        };
                };

                R5_1_BAREMETAL {
                        phandle = <0x19d>;
                        compatible = "openamp,domain-v1";
                        sram = <0x0 0x9968000 0x0 0x60000 0x0 0xffe90000 0x0 0x10000>;
                        cpus = <&cpus_r5_1 0x1 0x80000003>;
                        os,type = "baremetal";
                        rpu_pd_val = <0x89 0x8>;
                        cpu_config_str = "split";
                        core_num = <0x0>;

                        domain-to-domain {
                                compatible = "openamp,domain-to-domain-v1";

                                libmetal-relation {
                                        compatible = "libmetal,ipc-v1";

                                        relation0 {
                                                host = <0x1a1>;
                                                carveouts = <0x19e 0x19f 0x1a0>;
                                                mbox = <0x12f>;
                                                timer = <0x74>;
                                                elfload = <&libmetal_elf>;
                                        };
                                };
                        };
                };
        };

        reserved-memory {
                ranges;
                #size-cells = <0x2>;
                #address-cells = <0x2>;

                vdev0vring0: vdev0vring0@9880000 {
                        phandle = <0x198>;
                        label = "vdev0vring0";
                        no-map;
                        reg = <0x0 0x9880000 0x0 0x4000>;
                };

                vdev0vring1: vdev0vring1@9884000 {
                        phandle = <0x197>;
                        label = "vdev0vring1";
                        no-map;
                        reg = <0x0 0x9884000 0x0 0x4000>;
                };

                vdev0buffer: vdev0buffer@9888000 {
                        phandle = <0x196>;
                        label = "vdev0buffer";
                        no-map;
                        reg = <0x0 0x9888000 0x0 0x78000>;
                };

                trace_buffer: trace@985f000 {
                        phandle = <0x19a>;
                        label = "trace_buffer";
                        mpu-policy = "readable", "writable";
                        no-map;
                        reg = <0x0 0x985f000 0x0 0x1000>;
                };

                rproc0: rproc0@9800000 {
                        phandle = <0x199>;
                        label = "rproc0";
                        mpu-policy = "readable", "writable", "executable", "cacheable", "static";
                        no-map;
                        reg = <0x0 0x9800000 0x0 0x20000>;
                };

                rsctbl: rsctbl@9820000 {
                        phandle = <0x19b>;
                        label = "rsctbl";
                        mpu-policy = "readable", "writable";
                        no-map;
                        reg = <0x0 0x9820000 0x0 0x100>;
                };

                libmetal_elf: libmetal_elf@9968000 {
                        phandle = <0x1a2>;
                        label = "libmetal_elf";
                        no-map;
                        reg = <0x0 0x9968000 0x0 0x60000>;
                };

                libmetal_desc0: libmetal_desc0@99c8000 {
                        phandle = <0x1a3>;
                        label = "libmetal_desc0";
                        no-map;
                        reg = <0x0 0x99c8000 0x0 0x4000>;
                };

                libmetal_desc1: libmetal_desc1@99cc000 {
                        phandle = <0x1a4>;
                        label = "libmetal_desc1";
                        no-map;
                        reg = <0x0 0x99cc000 0x0 0x4000>;
                };

                libmetal_data: libmetal_data@99d0000 {
                        phandle = <0x1a5>;
                        label = "libmetal_data";
                        no-map;
                        reg = <0x0 0x99d0000 0x0 0x40000>;
                };
        };
};

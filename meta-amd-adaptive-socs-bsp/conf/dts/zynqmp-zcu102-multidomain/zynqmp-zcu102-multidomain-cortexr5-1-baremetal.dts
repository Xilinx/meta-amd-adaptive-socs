                i2c0: i2c@ff020000 {
                        phandle = <0x4d>;
                        compatible = "cdns,i2c-r1p14";
                        status = "okay";
                        interrupt-parent = <&gic_r5>;
                        interrupts = <0x0 0x11 0x4>;
                        clock-frequency = <0x61a80>;
                        reg = <0x0 0xff020000 0x0 0x1000>;
                        #address-cells = <0x1>;
                        #size-cells = <0x0>;
                        power-domains = <&zynqmp_firmware 0x25>;
                        clocks = <&zynqmp_clk 0x3d>;
                        xlnx,i2c-reset = <0x0>;
                        xlnx,has-interrupt = <0x2faf080>;
                        xlnx,clock-freq = <0x5f5b9f5>;
                        xlnx,i2c-clk-freq-hz = <0x5f5b9f5>;
                        xlnx,ip-name = "psu_i2c";
                        xlnx,iic-board-interface = "custom";
                        xlnx,name = "psu_i2c_0";
                        pinctrl-names = "default", "gpio";
                        pinctrl-0 = <0xaa>;
                        pinctrl-1 = <0xab>;
                        scl-gpios = <0x4b 0xe 0x6>;
                        sda-gpios = <0x4b 0xf 0x6>;

                        tca6416_u97: gpio@20 {
                                phandle = <0xa8>;
                                compatible = "ti,tca6416";
                                reg = <0x20>;
                                gpio-controller;
                                #gpio-cells = <0x2>;
                                gpio-line-names = "PS_GTR_LAN_SEL0", "PS_GTR_LAN_SEL1", "PS_GTR_LAN_SEL2", "PS_GTR_LAN_SEL3", "PCI_CLK_DIR_SEL", "IIC_MUX_RESET_B", "GEM3_EXP_RESET_B", "", "", "", "", "", "", "", "", "";

                                gtr-sel0-hog {
                                        gpio-hog;
                                        gpios = <0x0 0x0>;
                                        output-low;
                                        line-name = "sel0";
                                };

                                gtr-sel1-hog {
                                        gpio-hog;
                                        gpios = <0x1 0x0>;
                                        output-high;
                                        line-name = "sel1";
                                };

                                gtr-sel2-hog {
                                        gpio-hog;
                                        gpios = <0x2 0x0>;
                                        output-high;
                                        line-name = "sel2";
                                };

                                gtr-sel3-hog {
                                        gpio-hog;
                                        gpios = <0x3 0x0>;
                                        output-high;
                                        line-name = "sel3";
                                };
                        };

                        tca6416_u61: gpio@21 {
                                phandle = <0xf4>;
                                compatible = "ti,tca6416";
                                reg = <0x21>;
                                gpio-controller;
                                #gpio-cells = <0x2>;
                                gpio-line-names = "VCCPSPLL_EN", "MGTRAVCC_EN", "MGTRAVTT_EN", "VCCPSDDRPLL_EN", "MIO26_PMU_INPUT_LS", "PL_PMBUS_ALERT", "PS_PMBUS_ALERT", "MAXIM_PMBUS_ALERT", "PL_DDR4_VTERM_EN", "PL_DDR4_VPP_2V5_EN", "PS_DIMM_VDDQ_TO_PSVCCO_ON", "PS_DIMM_SUSPEND_EN", "PS_DDR4_VTERM_EN", "PS_DDR4_VPP_2V5_EN", "", "";
                        };

                        i2c-mux@75 {
                                compatible = "nxp,pca9544";
                                #address-cells = <0x1>;
                                #size-cells = <0x0>;
                                reg = <0x75>;

                                i2c@0 {

                        interrupts = <0x0 0x1a 0x4 0x0 0x1b 0x4>;
                        interrupt-names = "alarm", "sec";
                        clocks = <&rtc_clk>;
                        clock-names = "rtc";
                        xlnx,ip-name = "psu_rtc";
                        xlnx,name = "psu_rtc";
                };

                sata: ahci@fd0c0000 {
                        phandle = <0x6c>;

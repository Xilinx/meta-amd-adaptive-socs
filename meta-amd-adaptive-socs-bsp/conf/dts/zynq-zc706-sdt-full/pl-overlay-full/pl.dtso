/dts-v1/;
/plugin/;

&fpga_full {
        firmware-name = "zc706_base.bit.bin";

        clocking0: clocking0 {
                clocks = <&clkc 0xf>;
                clock-output-names = "fabric_clk";
                #clock-cells = <0x0>;
                assigned-clock-rates = <0x2faf080>;
                assigned-clocks = <&clkc 0xf>;
                compatible = "xlnx,fclk";
        };
};

&amba {

        axi_gpio_0: gpio@41200000 {
                xlnx,all-inputs = <0x0>;
                xlnx,name = "axi_gpio_0";
                xlnx,tri-default = <0xffffffff>;
                xlnx,use-board-flow;
                clock-names = "s_axi_aclk";
                xlnx,gpio2-width = <0x20>;
                xlnx,dout-default-2 = <0x0>;
                xlnx,edk-iptype = "PERIPHERAL";
                xlnx,gpio2-board-interface = "Custom";
                xlnx,interrupt-present = <0x0>;
                device_type = "gpio";
                gpio-controller;
                xlnx,all-outputs-2 = <0x0>;
                clocks = <&clkc 0xf>;
                xlnx,all-inputs-2 = <0x0>;
                reg = <0x41200000 0x10000>;
                xlnx,tri-default-2 = <0xffffffff>;
                xlnx,ip-name = "axi_gpio";
                xlnx,is-dual = <0x0>;
                xlnx,dout-default = <0x0>;
                xlnx,gpio-width = <0x4>;
                #gpio-cells = <0x2>;
                xlnx,all-outputs = <0x1>;
                compatible = "xlnx,axi-gpio-2.0", "xlnx,xps-gpio-1.00.a";
                xlnx,gpio-board-interface = "led_4bits";
        };

        axi_bram_ctrl_0: axi_bram_ctrl_0@40000000 {
                xlnx,name = "axi_bram_ctrl_0";
                xlnx,s-axi-id-width = <0x1>;
                xlnx,mem-depth = <0x800>;
                xlnx,s-axi-ctrl-data-width = <0x20>;
                xlnx,bram-inst-mode = "EXTERNAL";
                xlnx,bram-addr-width = <0xb>;
                xlnx,data-width = <0x20>;
                clock-names = "s_axi_aclk";
                xlnx,edk-iptype = "PERIPHERAL";
                xlnx,ecc = <0x0>;
                xlnx,single-port-bram = <0x0>;
                xlnx,supports-narrow-burst = <0x0>;
                xlnx,s-axi-supports-narrow-burst = <0x0>;
                xlnx,id-width = <0x0>;
                xlnx,read-latency = <0x1>;
                xlnx,s-axi-ctrl-addr-width = <0x20>;
                clocks = <&clkc 0xf>;
                xlnx,bmg-instance = "EXTERNAL";
                reg = <0x40000000 0x2000>;
                xlnx,ip-name = "axi_bram_ctrl";
                xlnx,fault-inject = <0x0>;
                xlnx,use-ecc = <0x0>;
                xlnx,memory-depth = <0x800>;
                xlnx,rd-cmd-optimization = <0x0>;
                xlnx,ecc-type = <0x0>;
                xlnx,ecc-onoff-reset-value = <0x0>;
                compatible = "xlnx,axi-bram-ctrl-4.1", "xlnx,axi-bram-ctrl";
                xlnx,edk-special = "BRAM_CTRL";
                xlnx,protocol = "AXI4";
        };
};

&cpus_a9 {
        address-map = <0xf0000000 0x1 0xf0000000 0x10000000 0x40000000 0x2 0x40000000 0x2000 0x40000000 0x3 0x40000000 0x2000 0x100000 0x4 0x100000 0x3ff00000 0x0 0x5 0x0 0x30000 0xffff0000 0x6 0xffff0000 0xfe00 0x41200000 0x7 0x41200000 0x10000 0xf8008000 0x8 0xf8008000 0x1000 0xf8009000 0x9 0xf8009000 0x1000 0xf800a000 0xa 0xf800a000 0x1000 0xf800b000 0xb 0xf800b000 0x1000 0xf8800000 0xc 0xf8800000 0x100000 0xf8006000 0xd 0xf8006000 0x1000 0xf8007000 0xe 0xf8007000 0x100 0xf8004000 0xf 0xf8004000 0x1000 0xf8003000 0x10 0xf8003000 0x1000 0xe000b000 0x11 0xe000b000 0x1000 0xf8f00200 0x12 0xf8f00200 0x100 0xe000a000 0x13 0xe000a000 0x1000 0xf8900000 0x14 0xf8900000 0x100000 0xe0004000 0x15 0xe0004000 0x1000 0xf8f01000 0x16 0xf8f01000 0x1000 0xe0200000 0x17 0xe0200000 0x1000 0xf8f02000 0x18 0xf8f02000 0x1000 0xf800c000 0x19 0xf800c000 0x1000 0xf8891000 0x1a 0xf8891000 0x1000 0xe000d000 0x1b 0xe000d000 0x1000 0xfc000000 0x1c 0xfc000000 0x2000000 0xf8f00000 0x1d 0xf8f00000 0xfd 0xf8f00600 0x1e 0xf8f00600 0x20 0xf8f00620 0x1f 0xf8f00620 0xe0 0xe0100000 0x20 0xe0100000 0x1000 0xf8000000 0x21 0xf8000000 0x1000 0xf8001000 0x22 0xf8001000 0x1000 0xe0001000 0x23 0xe0001000 0x1000 0xe0002000 0x24 0xe0002000 0x1000 0xf8007100 0x25 0xf8007100 0x21>;
};

